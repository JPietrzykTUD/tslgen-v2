/// A CPU-selected table of whole-algorithm entry points.
#[derive(Clone, Copy, Debug)]
pub struct Dispatcher {
    table: SelectionTable,
}

impl Dispatcher {
    /// Detects the current CPU once and selects every emitted dispatch slot.
    #[must_use]
    pub fn new() -> Self {
        let mut detector = StdDetector;
        Self::from_detector(&mut detector)
    }

    fn from_detector(detector: &mut impl Detector) -> Self {
        let facts = detector.detect();
        Self {
            table: select_table(&facts),
        }
    }

    /// Applies a binary vector operation to two equally sized slices.
    ///
    /// The selected whole-loop entry is invoked once. A stateful operation can
    /// be passed as `&mut operation`.
    ///
    /// # Panics
    ///
    /// Panics when the input and output slice lengths differ.
    #[track_caller]
    #[allow(private_bounds)]
    pub fn transform_binary<Element, Operation>(
        &self,
        operation: Operation,
        left: &[Element],
        right: &[Element],
        output: &mut [Element],
    )
    where
        Element: private::DispatchBinary<Operation>,
    {
        assert_eq!(
            left.len(),
            right.len(),
            "runtime transform_binary requires equally sized inputs",
        );
        assert_eq!(
            left.len(),
            output.len(),
            "runtime transform_binary requires equally sized input and output",
        );
        <Element as private::DispatchBinary<Operation>>::dispatch(
            &self.table,
            operation,
            left,
            right,
            output,
        );
    }
}

impl Default for Dispatcher {
    fn default() -> Self {
        Self::new()
    }
}

/// Convenience algorithms backed by one process-global dispatcher.
pub mod algorithms {
    use super::{private, Dispatcher};

    static DISPATCHER: std::sync::OnceLock<Dispatcher> = std::sync::OnceLock::new();

    fn dispatcher() -> &'static Dispatcher {
        DISPATCHER.get_or_init(Dispatcher::new)
    }

    /// Applies a binary vector operation using the process-global dispatcher.
    #[track_caller]
    #[allow(private_bounds)]
    pub fn transform_binary<Element, Operation>(
        operation: Operation,
        left: &[Element],
        right: &[Element],
        output: &mut [Element],
    )
    where
        Element: private::DispatchBinary<Operation>,
    {
        dispatcher().transform_binary(operation, left, right, output);
    }
}

type BinaryEntry<Operation, Element> =
    unsafe fn(Operation, &[Element], &[Element], &mut [Element]);

mod private {
    use super::SelectionTable;

    pub(crate) trait DispatchBinary<Operation>: Sized {
        fn dispatch(
            table: &SelectionTable,
            operation: Operation,
            left: &[Self],
            right: &[Self],
            output: &mut [Self],
        );
    }
}

