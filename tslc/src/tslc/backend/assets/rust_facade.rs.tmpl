//! Opaque logical SIMD values selected from the compilation target.

mod private {
    pub trait SealedElement {}

    pub trait Representation<const N: usize>: SealedElement + Sized {
        type Vector: Copy + Send + Sync + Unpin + 'static;
        type Mask: Copy + Send + Sync + Unpin + 'static;
    }

    pub trait FacadeOps<const N: usize>: Representation<N> {
        fn vector_splat(value: Self) -> Self::Vector;
        fn vector_from_array(values: [Self; N]) -> Self::Vector;
        fn vector_to_array(value: Self::Vector) -> [Self; N];
        fn vector_zero() -> Self::Vector;
        unsafe fn extract_lane(value: Self::Vector, index: usize) -> Self;
        unsafe fn insert_lane(value: Self::Vector, index: usize, lane: Self) -> Self::Vector;
        unsafe fn load(source: *const Self) -> Self::Vector;
        unsafe fn store(destination: *mut Self, value: Self::Vector);

        fn mask_false() -> Self::Mask;
        fn mask_true() -> Self::Mask;
        fn mask_from_bitmask(bits: u64) -> Self::Mask;
        fn mask_to_bitmask(value: Self::Mask) -> u64;
        fn mask_test(value: Self::Mask, index: usize) -> bool;
        unsafe fn mask_set(value: Self::Mask, index: usize, active: bool) -> Self::Mask;
        fn mask_count(value: Self::Mask) -> usize;
        fn mask_and(left: Self::Mask, right: Self::Mask) -> Self::Mask;
        fn mask_or(left: Self::Mask, right: Self::Mask) -> Self::Mask;
        fn mask_xor(left: Self::Mask, right: Self::Mask) -> Self::Mask;
        fn mask_not(value: Self::Mask) -> Self::Mask;
    }

    pub trait ConvertTo<U, const N: usize>: Representation<N>
    where
        U: Representation<N>,
    {
        fn convert(
            value: Self::Vector,
        ) -> <U as Representation<N>>::Vector;
    }

@{comprehensive_private_traits}
}

/// An element type admitted by the generated fixed-width SIMD surface.
///
/// This trait is sealed. Its associated types select the generated native lane
/// count for the compilation target without exposing the private register type.
@{facade_declaration_simd_element}
{
    /// Generated native-width SIMD value for this element type.
    @{facade_declaration_native_simd_associated}
    /// Generated native-width mask value for this element type.
    @{facade_declaration_native_mask_associated}
}

/// Proof that element type `Self` supports exactly `N` logical lanes.
///
/// The generated crate implements this sealed trait only for scalar shapes and
/// source-authored fixed 128-, 256-, or 512-bit shapes.
@{facade_declaration_supported_simd}

impl<T, const N: usize> SupportedSimd<N> for T
where
    T: SimdElement + private::Representation<N> + private::FacadeOps<N>,
{
}

/// An opaque owned SIMD value containing `N` lanes of `T`.
///
/// Its size, alignment, and byte layout are deliberately unspecified. Do not
/// transmute, serialize, or pass this value through FFI by layout.
@{facade_declaration_simd}
{
    value: <T as private::Representation<N>>::Vector,
}

