    #[inline]
    fn default() -> Self {
        Self::splat(false)
    }
}

impl<T, const N: usize> core::fmt::Debug for Mask<T, N>
where
    T: SupportedSimd<N>,
{
    fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Debug::fmt(&self.to_array(), formatter)
    }
}

impl<T, const N: usize> PartialEq for Mask<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn eq(&self, other: &Self) -> bool {
        <T as private::FacadeOps<N>>::mask_count(
            <T as private::FacadeOps<N>>::mask_xor(self.value, other.value),
        ) == 0
    }
}

impl<T, const N: usize> Eq for Mask<T, N>
where
    T: SupportedSimd<N>,
{
}

@{array_from_impls}

macro_rules! impl_mask_binary_operator {
    ($trait:ident, $method:ident, $assign_trait:ident, $assign_method:ident, $delegate:ident) => {
        impl<T, const N: usize> core::ops::$trait for Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            type Output = Self;

            #[inline]
            fn $method(self, rhs: Self) -> Self::Output {
                Self {
                    value: <T as private::FacadeOps<N>>::$delegate(self.value, rhs.value),
                }
            }
        }

        impl<T, const N: usize> core::ops::$trait<Mask<T, N>> for &Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            type Output = Mask<T, N>;

            #[inline]
            fn $method(self, rhs: Mask<T, N>) -> Self::Output {
                <Mask<T, N> as core::ops::$trait<Mask<T, N>>>::$method(*self, rhs)
            }
        }

        impl<T, const N: usize> core::ops::$trait<&Mask<T, N>> for Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            type Output = Self;

            #[inline]
            fn $method(self, rhs: &Mask<T, N>) -> Self::Output {
                <Mask<T, N> as core::ops::$trait<Mask<T, N>>>::$method(self, *rhs)
            }
        }

        impl<T, const N: usize> core::ops::$trait<&Mask<T, N>> for &Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            type Output = Mask<T, N>;

            #[inline]
            fn $method(self, rhs: &Mask<T, N>) -> Self::Output {
                <Mask<T, N> as core::ops::$trait<Mask<T, N>>>::$method(*self, *rhs)
            }
        }

        impl<T, const N: usize> core::ops::$assign_trait for Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            #[inline]
            fn $assign_method(&mut self, rhs: Self) {
                *self = <Mask<T, N> as core::ops::$trait<Mask<T, N>>>::$method(*self, rhs);
            }
        }

        impl<T, const N: usize> core::ops::$assign_trait<&Mask<T, N>> for Mask<T, N>
        where
            T: SupportedSimd<N>,
        {
            #[inline]
            fn $assign_method(&mut self, rhs: &Mask<T, N>) {
                *self = <Mask<T, N> as core::ops::$trait<Mask<T, N>>>::$method(*self, *rhs);
            }
        }
    };
}

impl_mask_binary_operator!(BitAnd, bitand, BitAndAssign, bitand_assign, mask_and);
impl_mask_binary_operator!(BitOr, bitor, BitOrAssign, bitor_assign, mask_or);
impl_mask_binary_operator!(BitXor, bitxor, BitXorAssign, bitxor_assign, mask_xor);

impl<T, const N: usize> core::ops::Not for Mask<T, N>
where
    T: SupportedSimd<N>,
{
    type Output = Self;

    #[inline]
    fn not(self) -> Self::Output {
        Self {
            value: <T as private::FacadeOps<N>>::mask_not(self.value),
        }
    }
}

impl<T, const N: usize> core::ops::Not for &Mask<T, N>
where
    T: SupportedSimd<N>,
{
    type Output = Mask<T, N>;

    #[inline]
    fn not(self) -> Self::Output {
        !*self
    }
}
