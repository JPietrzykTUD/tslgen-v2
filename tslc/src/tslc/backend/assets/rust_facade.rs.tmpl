impl<T, const N: usize> Simd<T, N>
where
    T: SupportedSimd<N>,
{
    /// Number of logical lanes in this value.
    pub const LANES: usize = N;

    /// Broadcasts `value` to every lane.
    #[inline]
    #[must_use]
    pub fn splat(value: T) -> Self {
        Self {
            value: <T as private::FacadeOps<N>>::vector_splat(value),
        }
    }

    /// Constructs a vector from values in increasing logical lane order.
    #[inline]
    #[must_use]
    pub fn from_array(values: [T; N]) -> Self {
        Self {
            value: <T as private::FacadeOps<N>>::vector_from_array(values),
        }
    }

    /// Returns the logical lane values in increasing lane order.
    #[inline]
    #[must_use]
    pub fn to_array(self) -> [T; N] {
        <T as private::FacadeOps<N>>::vector_to_array(self.value)
    }

    /// Returns one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
    #[inline]
    #[must_use]
    #[track_caller]
    pub fn lane(&self, index: usize) -> T {
        assert!(index < N, "lane index {index} is out of bounds for {N} lanes");
        <T as private::FacadeOps<N>>::extract_lane(self.value, index)
    }

    /// Replaces one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
    #[inline]
    #[track_caller]
    pub fn set_lane(&mut self, index: usize, value: T) {
        assert!(index < N, "lane index {index} is out of bounds for {N} lanes");
        self.value = <T as private::FacadeOps<N>>::insert_lane(self.value, index, value);
    }

    /// Loads the first `N` elements of `source`.
    ///
    /// # Panics
    ///
    /// Panics when `source.len() < N`.
    #[inline]
    #[must_use]
    #[track_caller]
    pub fn from_slice(source: &[T]) -> Self {
        assert!(
            source.len() >= N,
            "source slice has {} elements but {N} are required",
            source.len()
        );
        // SAFETY: the length check proves that `source` contains `N`
        // initialized, properly aligned `T` values.
        unsafe { Self::from_ptr(source.as_ptr()) }
    }

    /// Loads exactly `N` elements from `source`.
    ///
    /// # Safety
    ///
    /// `source` must be aligned for `T`, valid to read `N` initialized
    /// consecutive `T` values, and remain valid for the duration of the call.
    #[inline]
    #[must_use]
    pub unsafe fn from_ptr(source: *const T) -> Self {
        Self {
            // SAFETY: upheld by this function's caller contract.
            value: unsafe { <T as private::FacadeOps<N>>::load(source) },
        }
    }

    /// Stores into the first `N` elements of `destination`.
    ///
    /// # Panics
    ///
    /// Panics when `destination.len() < N`.
    #[inline]
    #[track_caller]
    pub fn copy_to_slice(self, destination: &mut [T]) {
        assert!(
            destination.len() >= N,
            "destination slice has {} elements but {N} are required",
            destination.len()
        );
        // SAFETY: the length check proves that `destination` contains `N`
        // writable, properly aligned `T` values.
        unsafe { self.copy_to_ptr(destination.as_mut_ptr()) }
    }

    /// Stores exactly `N` elements into `destination`.
    ///
    /// # Safety
    ///
    /// `destination` must be aligned for `T`, valid to write `N` consecutive
    /// `T` values, and remain valid for the duration of the call.
    #[inline]
    pub unsafe fn copy_to_ptr(self, destination: *mut T) {
        // SAFETY: upheld by this function's caller contract.
        unsafe { <T as private::FacadeOps<N>>::store(destination, self.value) }
    }
}

impl<T, const N: usize> From<[T; N]> for Simd<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn from(values: [T; N]) -> Self {
        Self::from_array(values)
    }
}

impl<T, const N: usize> Default for Simd<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn default() -> Self {
        Self {
            value: <T as private::FacadeOps<N>>::vector_zero(),
        }
    }
}

impl<T, const N: usize> core::fmt::Debug for Simd<T, N>
where
    T: SupportedSimd<N>,
{
    fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Debug::fmt(&self.to_array(), formatter)
    }
}

impl<T, const N: usize> Mask<T, N>
where
    T: SupportedSimd<N>,
{
    /// Number of logical lanes in this mask.
    pub const LANES: usize = N;

    /// Constructs a mask whose lanes all have the same active state.
    #[inline]
    #[must_use]
    pub fn splat(value: bool) -> Self {
        Self {
            value: if value {
                <T as private::FacadeOps<N>>::mask_true()
            } else {
                <T as private::FacadeOps<N>>::mask_false()
            },
        }
    }

    /// Constructs a mask from logical lane states.
    #[inline]
    #[must_use]
    pub fn from_array(values: [bool; N]) -> Self {
        let mut result = Self::splat(false);
        let mut index = 0;
        while index < N {
            result.value =
                <T as private::FacadeOps<N>>::mask_set(result.value, index, values[index]);
            index += 1;
        }
        result
    }

    /// Returns the mask's logical lane states.
    #[inline]
    #[must_use]
    pub fn to_array(self) -> [bool; N] {
        let mut result = [false; N];
        let mut index = 0;
        while index < N {
            result[index] = <T as private::FacadeOps<N>>::mask_test(self.value, index);
            index += 1;
        }
        result
    }

    /// Tests one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
    #[inline]
    #[must_use]
    #[track_caller]
    pub fn test(&self, index: usize) -> bool {
        assert!(index < N, "mask index {index} is out of bounds for {N} lanes");
        <T as private::FacadeOps<N>>::mask_test(self.value, index)
    }

    /// Replaces one logical lane state.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
    #[inline]
    #[track_caller]
    pub fn set(&mut self, index: usize, value: bool) {
        assert!(index < N, "mask index {index} is out of bounds for {N} lanes");
        self.value = <T as private::FacadeOps<N>>::mask_set(self.value, index, value);
    }

    /// Returns whether at least one lane is active.
    #[inline]
    #[must_use]
    pub fn any(self) -> bool {
        self.count_ones() != 0
    }

    /// Returns whether every lane is active.
    #[inline]
    #[must_use]
    pub fn all(self) -> bool {
        self.count_ones() == N
    }

    /// Counts active lanes.
    #[inline]
    #[must_use]
    pub fn count_ones(self) -> usize {
        <T as private::FacadeOps<N>>::mask_count(self.value)
    }

    /// Constructs a mask from a bitset where bit `i` corresponds to lane `i`.
    ///
    /// Bits at positions greater than or equal to `N` are ignored.
    #[inline]
    #[must_use]
    pub fn from_bitmask(bits: u64) -> Self {
        Self {
            value: <T as private::FacadeOps<N>>::mask_from_bitmask(bits),
        }
    }

    /// Returns a bitset where bit `i` corresponds to lane `i`.
    ///
    /// Bits at positions greater than or equal to `N` are zero.
    #[inline]
    #[must_use]
    pub fn to_bitmask(self) -> u64 {
        <T as private::FacadeOps<N>>::mask_to_bitmask(self.value)
    }

    /// Converts this mask to another admitted element type with the same lanes.
    #[inline]
    #[must_use]
    pub fn cast<U>(self) -> Mask<U, N>
    where
        U: SupportedSimd<N>,
    {
        Mask::<U, N>::from_array(self.to_array())
    }
}

impl<T, const N: usize> From<[bool; N]> for Mask<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn from(values: [bool; N]) -> Self {
        Self::from_array(values)
    }
}

