impl<T, const N: usize> Simd<T, N>
where
    T: SupportedSimd<N>,
{
    /// Number of logical lanes in this value.
@{core_simd_lanes}

    /// Broadcasts `value` to every lane.
@{core_simd_splat}
        Self {
            value: <T as private::FacadeOps<N>>::vector_splat(value),
        }
    }

    /// Constructs a vector from values in increasing logical lane order.
@{core_simd_from_array}
        Self {
            value: <T as private::FacadeOps<N>>::vector_from_array(values),
        }
    }

    /// Returns the logical lane values in increasing lane order.
@{core_simd_to_array}
        <T as private::FacadeOps<N>>::vector_to_array(self.value)
    }

    /// Returns one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
@{core_simd_lane}
        assert!(index < N, "lane index {index} is out of bounds for {N} lanes");
        // SAFETY: checked immediately above.
        unsafe { <T as private::FacadeOps<N>>::extract_lane(self.value, index) }
    }

    /// Replaces one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
@{core_simd_set_lane}
        assert!(index < N, "lane index {index} is out of bounds for {N} lanes");
        // SAFETY: checked immediately above.
        self.value = unsafe {
            <T as private::FacadeOps<N>>::insert_lane(self.value, index, value)
        };
    }

    /// Loads the first `N` elements of `source`.
    ///
    /// # Panics
    ///
    /// Panics when `source.len() < N`.
@{core_simd_from_slice}
        assert!(
            source.len() >= N,
            "source slice has {} elements but {N} are required",
            source.len()
        );
        // SAFETY: the length check proves that `source` contains `N`
        // initialized, properly aligned `T` values.
        unsafe { Self::from_ptr(source.as_ptr()) }
    }

    /// Loads exactly `N` elements from `source`.
    ///
    /// # Safety
    ///
    /// `source` must be aligned for `T`, valid to read `N` initialized
    /// consecutive `T` values, and remain valid for the duration of the call.
@{core_simd_from_ptr}
        Self {
            // SAFETY: upheld by this function's caller contract.
            value: unsafe { <T as private::FacadeOps<N>>::load(source) },
        }
    }

    /// Stores into the first `N` elements of `destination`.
    ///
    /// # Panics
    ///
    /// Panics when `destination.len() < N`.
@{core_simd_copy_to_slice}
        assert!(
            destination.len() >= N,
            "destination slice has {} elements but {N} are required",
            destination.len()
        );
        // SAFETY: the length check proves that `destination` contains `N`
        // writable, properly aligned `T` values.
        unsafe { self.copy_to_ptr(destination.as_mut_ptr()) }
    }

    /// Stores exactly `N` elements into `destination`.
    ///
    /// # Safety
    ///
    /// `destination` must be aligned for `T`, valid to write `N` consecutive
    /// `T` values, and remain valid for the duration of the call.
@{core_simd_copy_to_ptr}
        // SAFETY: upheld by this function's caller contract.
        unsafe { <T as private::FacadeOps<N>>::store(destination, self.value) }
    }

@{conversion_methods}
}

impl<T, const N: usize> From<[T; N]> for Simd<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn from(values: [T; N]) -> Self {
        Self::from_array(values)
    }
}

impl<T, const N: usize> Default for Simd<T, N>
where
    T: SupportedSimd<N>,
{
    #[inline]
    fn default() -> Self {
        Self {
            value: <T as private::FacadeOps<N>>::vector_zero(),
        }
    }
}

