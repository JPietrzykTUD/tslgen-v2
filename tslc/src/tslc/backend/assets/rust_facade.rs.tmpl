impl<T, const N: usize> Mask<T, N>
where
    T: SupportedSimd<N>,
{
    /// Number of logical lanes in this mask.
@{core_mask_lanes}

    /// Constructs a mask whose lanes all have the same active state.
@{core_mask_splat}
        Self {
            value: if value {
                <T as private::FacadeOps<N>>::mask_true()
            } else {
                <T as private::FacadeOps<N>>::mask_false()
            },
        }
    }

    /// Constructs a mask from logical lane states.
@{core_mask_from_array}
        let mut result = Self::splat(false);
        let mut index = 0;
        while index < N {
            // SAFETY: the loop condition proves `index < N`.
            result.value = unsafe {
                <T as private::FacadeOps<N>>::mask_set(result.value, index, values[index])
            };
            index += 1;
        }
        result
    }

    /// Returns the mask's logical lane states.
@{core_mask_to_array}
        let mut result = [false; N];
        let mut index = 0;
        while index < N {
            result[index] = <T as private::FacadeOps<N>>::mask_test(self.value, index);
            index += 1;
        }
        result
    }

    /// Tests one logical lane.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
@{core_mask_test}
        assert!(index < N, "mask index {index} is out of bounds for {N} lanes");
        <T as private::FacadeOps<N>>::mask_test(self.value, index)
    }

    /// Replaces one logical lane state.
    ///
    /// # Panics
    ///
    /// Panics when `index >= N`.
@{core_mask_set}
        assert!(index < N, "mask index {index} is out of bounds for {N} lanes");
        // SAFETY: checked immediately above.
        self.value = unsafe {
            <T as private::FacadeOps<N>>::mask_set(self.value, index, value)
        };
    }

    /// Returns whether at least one lane is active.
@{core_mask_any}
        self.count_ones() != 0
    }

    /// Returns whether every lane is active.
@{core_mask_all}
        self.count_ones() == N
    }

    /// Counts active lanes.
@{core_mask_count_ones}
        <T as private::FacadeOps<N>>::mask_count(self.value)
    }

    /// Constructs a mask from a bitset where bit `i` corresponds to lane `i`.
    ///
    /// Bits at positions greater than or equal to `N` are ignored.
@{core_mask_from_bitmask}
        Self {
            value: <T as private::FacadeOps<N>>::mask_from_bitmask(bits),
        }
    }

    /// Returns a bitset where bit `i` corresponds to lane `i`.
    ///
    /// Bits at positions greater than or equal to `N` are zero.
@{core_mask_to_bitmask}
        <T as private::FacadeOps<N>>::mask_to_bitmask(self.value)
    }

    /// Converts this mask to another admitted element type with the same lanes.
@{core_mask_cast}
        Mask::<U, N>::from_array(self.to_array())
    }
}

