where
    T: SupportedSimd<N>,
{
    #[inline]
    fn eq(&self, other: &Self) -> bool {
        <T as private::FacadeOps<N>>::mask_count(
            <T as private::FacadeOps<N>>::mask_xor(self.value, other.value),
        ) == 0
    }
}

