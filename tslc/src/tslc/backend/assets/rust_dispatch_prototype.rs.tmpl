//! Private proof of the generated whole-algorithm runtime-dispatch boundary.

use crate::tsl_algorithm::BinaryKernel;
use crate::tsl_core::{Generic, Scalar, Simd, StaticSimdVector};

type Element = @{base_spelling};
type BaselineVector = Simd<Element, Generic<@{baseline_lanes}>>;
type ScalarVector = Simd<Element, Scalar>;
@{hardware_vector_alias}

#[derive(Clone, Copy, Debug, Default)]
struct @{operation_name};

impl BinaryKernel<BaselineVector> for @{operation_name} {
    #[inline]
    fn apply(
        &mut self,
        left: <BaselineVector as crate::tsl_core::SimdVector>::RegisterType,
        right: <BaselineVector as crate::tsl_core::SimdVector>::RegisterType,
    ) -> <BaselineVector as crate::tsl_core::SimdVector>::RegisterType {
        crate::tsl_target_fallback::@{baseline_delegate}::<BaselineVector>(left, right)
    }
}

impl BinaryKernel<ScalarVector> for @{operation_name} {
    #[inline]
    fn apply(
        &mut self,
        left: <ScalarVector as crate::tsl_core::SimdVector>::RegisterType,
        right: <ScalarVector as crate::tsl_core::SimdVector>::RegisterType,
    ) -> <ScalarVector as crate::tsl_core::SimdVector>::RegisterType {
        crate::tsl_target_fallback::@{baseline_delegate}::<ScalarVector>(left, right)
    }
}
@{hardware_kernel_impl}

#[derive(Debug, Default)]
struct StatefulOperation {
    applications: usize,
}

impl<Vector> BinaryKernel<Vector> for StatefulOperation
where
    Vector: StaticSimdVector,
    @{operation_name}: BinaryKernel<Vector>,
{
    #[inline]
    fn apply(
        &mut self,
        left: <Vector as crate::tsl_core::SimdVector>::RegisterType,
        right: <Vector as crate::tsl_core::SimdVector>::RegisterType,
    ) -> <Vector as crate::tsl_core::SimdVector>::RegisterType {
        self.applications += 1;
        <@{operation_name} as BinaryKernel<Vector>>::apply(
            &mut @{operation_name},
            left,
            right,
        )
    }
}

@{runtime_operation_trait}

type BinaryEntry<Operation> = unsafe fn(
    Operation,
    &[Element],
    &[Element],
    &mut [Element],
);

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
struct SelectionTable {
    transform_binary: usize,
}

trait DetectedCpu {
    fn hardware_candidate_supported(&self) -> bool;
}

trait Detector {
    type Facts: DetectedCpu;

    fn detect(&mut self) -> Self::Facts;
}

#[derive(Clone, Copy, Debug)]
struct StdCpu {
    hardware_candidate_supported: bool,
}

impl DetectedCpu for StdCpu {
    fn hardware_candidate_supported(&self) -> bool {
        self.hardware_candidate_supported
    }
}

#[derive(Debug, Default)]
struct StdDetector;

impl Detector for StdDetector {
    type Facts = StdCpu;

    fn detect(&mut self) -> Self::Facts {
        @{production_detection}
        StdCpu {
            hardware_candidate_supported,
        }
    }
}

fn select_table(cpu: &impl DetectedCpu) -> SelectionTable {
    #[cfg(test)]
    SELECTION_CALLS.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
    SelectionTable {
        transform_binary: if cpu.hardware_candidate_supported() {
            @{hardware_entry_index}
        } else {
            0
        },
    }
}

#[derive(Debug)]
struct PrototypeDispatcher {
    table: SelectionTable,
}

impl PrototypeDispatcher {
    fn new() -> Self {
        let mut detector = StdDetector;
        Self::from_detector(&mut detector)
    }

    fn from_detector(detector: &mut impl Detector) -> Self {
        let facts = detector.detect();
        Self {
            table: select_table(&facts),
        }
    }

    fn transform_binary<Operation>(
        &self,
        operation: Operation,
        left: &[Element],
        right: &[Element],
        output: &mut [Element],
    )
    where
        Operation: RuntimeOperation,
    {
        assert_eq!(
            left.len(),
            right.len(),
            "runtime transform_binary requires equally sized inputs",
        );
        assert_eq!(
            left.len(),
            output.len(),
            "runtime transform_binary requires equally sized input and output",
        );
        @{entry_array}
        // Exactly one indirect whole-loop entry is executed per algorithm call.
        unsafe {
            (entries[self.table.transform_binary])(operation, left, right, output);
        }
    }
}

unsafe fn baseline_entry<Operation>(
    mut operation: Operation,
    left: &[Element],
    right: &[Element],
    output: &mut [Element],
)
where
    Operation: RuntimeOperation,
{
    #[cfg(test)]
    ENTRY_CALLS.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
    crate::tsl_algorithm::transform_binary::<
        crate::tsl_target_fallback::algo::Profile,
        crate::dataparallel::Generic<@{baseline_lanes}>,
        Operation,
        Element,
    >(
        crate::dataparallel::Generic,
        &mut operation,
        left,
        right,
        output,
    );
}
@{hardware_entry}

#[cfg(test)]
static ENTRY_CALLS: std::sync::atomic::AtomicUsize =
    std::sync::atomic::AtomicUsize::new(0);
#[cfg(test)]
static HARDWARE_ENTRY_CALLS: std::sync::atomic::AtomicUsize =
    std::sync::atomic::AtomicUsize::new(0);
#[cfg(test)]
static SELECTION_CALLS: std::sync::atomic::AtomicUsize =
    std::sync::atomic::AtomicUsize::new(0);

#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::atomic::Ordering;

    static TEST_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());

    #[derive(Clone, Copy, Debug)]
    struct FakeCpu {
        hardware_supported: bool,
    }

    impl DetectedCpu for FakeCpu {
        fn hardware_candidate_supported(&self) -> bool {
            self.hardware_supported
        }
    }

    #[derive(Debug)]
    struct FakeDetector {
        detect_calls: usize,
        hardware_supported: bool,
    }

    impl Detector for FakeDetector {
        type Facts = FakeCpu;

        fn detect(&mut self) -> Self::Facts {
            self.detect_calls += 1;
            FakeCpu {
                hardware_supported: self.hardware_supported,
            }
        }
    }

    fn reset_counts() {
        ENTRY_CALLS.store(0, Ordering::SeqCst);
        HARDWARE_ENTRY_CALLS.store(0, Ordering::SeqCst);
        SELECTION_CALLS.store(0, Ordering::SeqCst);
    }

    fn inputs() -> ([Element; 8], [Element; 8]) {
        (
            [1 as Element, 2 as Element, 3 as Element, 4 as Element,
             5 as Element, 6 as Element, 7 as Element, 8 as Element],
            [8 as Element, 7 as Element, 6 as Element, 5 as Element,
             4 as Element, 3 as Element, 2 as Element, 1 as Element],
        )
    }

    #[test]
    fn detection_and_table_selection_happen_once() {
        let _guard = TEST_LOCK.lock().expect("dispatch prototype test lock");
        reset_counts();
        let mut detector = FakeDetector {
            detect_calls: 0,
            hardware_supported: false,
        };
        let dispatcher = PrototypeDispatcher::from_detector(&mut detector);
        assert_eq!(detector.detect_calls, 1);
        assert_eq!(SELECTION_CALLS.load(Ordering::SeqCst), 1);

        let (left, right) = inputs();
        let mut output = [0 as Element; 8];
        dispatcher.transform_binary(@{operation_name}, &left, &right, &mut output);
        dispatcher.transform_binary(@{operation_name}, &left, &right, &mut output);

        assert_eq!(detector.detect_calls, 1);
        assert_eq!(SELECTION_CALLS.load(Ordering::SeqCst), 1);
        assert_eq!(ENTRY_CALLS.load(Ordering::SeqCst), 2);
        assert_eq!(output, [9 as Element; 8]);
    }

    #[test]
    fn generic_fallback_propagates_mutable_operation_state() {
        let _guard = TEST_LOCK.lock().expect("dispatch prototype test lock");
        reset_counts();
        let mut detector = FakeDetector {
            detect_calls: 0,
            hardware_supported: false,
        };
        let dispatcher = PrototypeDispatcher::from_detector(&mut detector);
        let (left, right) = inputs();
        let mut output = [0 as Element; 8];
        let mut operation = StatefulOperation::default();

        dispatcher.transform_binary(&mut operation, &left, &right, &mut output);
        let first_applications = operation.applications;
        dispatcher.transform_binary(&mut operation, &left, &right, &mut output);

        assert!(first_applications > 0);
        assert!(operation.applications > first_applications);
        assert_eq!(output, [9 as Element; 8]);
        assert_eq!(HARDWARE_ENTRY_CALLS.load(Ordering::SeqCst), 0);
    }

    #[test]
    fn unsupported_hardware_entry_is_never_entered() {
        let _guard = TEST_LOCK.lock().expect("dispatch prototype test lock");
        reset_counts();
        let mut detector = FakeDetector {
            detect_calls: 0,
            hardware_supported: false,
        };
        let dispatcher = PrototypeDispatcher::from_detector(&mut detector);
        let (left, right) = inputs();
        let mut output = [0 as Element; 8];

        dispatcher.transform_binary(@{operation_name}, &left, &right, &mut output);

        assert_eq!(output, [9 as Element; 8]);
        assert_eq!(HARDWARE_ENTRY_CALLS.load(Ordering::SeqCst), 0);
    }

    @{hardware_execution_test}

    #[test]
    fn production_constructor_has_an_unconditional_fallback() {
        let _guard = TEST_LOCK.lock().expect("dispatch prototype test lock");
        let dispatcher = PrototypeDispatcher::new();
        assert!(dispatcher.table.transform_binary <= @{hardware_entry_index});
    }
}
