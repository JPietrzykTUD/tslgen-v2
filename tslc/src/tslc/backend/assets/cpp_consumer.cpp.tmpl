#include <cstddef>
#include <cstdlib>

#include <tsl.hpp>

int main() {
  using Vec =
      tsl::dataparallel::simd_for_t<tsl::dataparallel::native, float>;
  const std::size_t lanes = Vec::lane_count();
  const std::size_t bytes = lanes * sizeof(float);
  auto* left = static_cast<float*>(std::malloc(bytes));
  auto* right = static_cast<float*>(std::malloc(bytes));
  auto* output = static_cast<float*>(std::malloc(bytes));
  if (left == nullptr || right == nullptr || output == nullptr) {
    std::free(left);
    std::free(right);
    std::free(output);
    return 4;
  }
  for (std::size_t index = 0; index < lanes; ++index) {
    left[index] = 2;
    right[index] = 3;
    output[index] = 0;
  }

  const int status = [&]() {
    const auto ordinary_left = tsl::load<Vec, false>(left);
    const auto ordinary_right = tsl::load<Vec, false>(right);
    const auto ordinary = tsl::add<Vec>(ordinary_left, ordinary_right);
    tsl::store<Vec, false>(output, ordinary);

    return tsl::store_checked<Vec, false>(
               tsl::span<float>(output, lanes),
               tsl::add<Vec>(ordinary_left, ordinary_right)) ==
                   tsl::precondition_error::none
               ? 0
               : 1;
  }();
  std::free(left);
  std::free(right);
  std::free(output);
  return status;
}
