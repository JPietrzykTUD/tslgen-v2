[package]
name = @{package_name}
version = @{package_version}
edition = @{package_edition}
rust-version = @{rust_version}
license = @{package_license}
repository = @{repository_url}
documentation = @{documentation_url}
readme = @{readme_path}
autoexamples = false

[lib]
path = "src/lib.rs"

[features]
@{features}@{bench_targets}

# The benchmark policy records this generated profile contract, rejects exposed
# overrides, and requires an external identity for invocation details that a
# Cargo build script cannot observe.
@{benchmark_profile}
