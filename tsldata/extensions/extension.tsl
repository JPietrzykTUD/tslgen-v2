extension wasm128:
  extension_name "wasm128"
  family "wasm"
  vector_bits 128
  native_sort_order 800
  default_test_target true
  cpp:
    supported true
    headers ["wasm_simd128.h"]
  rust:
    supported true
    type_name "Wasm128"
    arch_module "wasm32"
  vector_register_types:
    si8:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    ui8:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    si16:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    ui16:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    si32:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    ui32:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    si64:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    ui64:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    f32:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
    f64:
      cpp "v128_t"
      rust "core::arch::wasm32::v128"
  intrinsic_compose:
    order "suffix_base"
    require_explicit_suffix true
    prefix:
      cpp "wasm_"
      rust "core::arch::wasm32::"
    suffix:
      by_type:
        f32 "f32x4"
        f64 "f64x2"
        si8 "i8x16"
        ui8 "i8x16"
        si16 "i16x8"
        ui16 "i16x8"
        si32 "i32x4"
        ui32 "i32x4"
        si64 "i64x2"
        ui64 "i64x2"
  mask_type_policy:
    kind "lane_bitmask"
  integral_mask_type_policy:
    kind "lane_bitmask"

