extension neon:
  vendor "arm"
  extension_name "neon"
  family "arm"
  intrinsic_style "arm"
  vector_bits 128
  native_sort_order 600
  autodetect true
  mask_repr "lane_bitmask"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["arm_neon.h"]
    header_guard "__ARM_NEON"
    test_suite_name "TslTests"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Neon"
    arch_module "aarch64"
    generation_support []
  vector_register_types:
    si8:
      cpp "int8x16_t"
      rust "core::arch::aarch64::int8x16_t"
    ui8:
      cpp "uint8x16_t"
      rust "core::arch::aarch64::uint8x16_t"
    si16:
      cpp "int16x8_t"
      rust "core::arch::aarch64::int16x8_t"
    ui16:
      cpp "uint16x8_t"
      rust "core::arch::aarch64::uint16x8_t"
    si32:
      cpp "int32x4_t"
      rust "core::arch::aarch64::int32x4_t"
    ui32:
      cpp "uint32x4_t"
      rust "core::arch::aarch64::uint32x4_t"
    si64:
      cpp "int64x2_t"
      rust "core::arch::aarch64::int64x2_t"
    ui64:
      cpp "uint64x2_t"
      rust "core::arch::aarch64::uint64x2_t"
    f32:
      cpp "float32x4_t"
      rust "core::arch::aarch64::float32x4_t"
    f64:
      cpp "float64x2_t"
      rust "core::arch::aarch64::float64x2_t"
  intrinsic_compose:
    prefix:
      cpp ""
      rust "core::arch::aarch64::"
    suffix:
      by_type:
        f32 "f32"
        f64 "f64"
        si8 "s8"
        si16 "s16"
        si32 "s32"
        si64 "s64"
        ui8 "u8"
        ui16 "u16"
        ui32 "u32"
        ui64 "u64"
  mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  integral_mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension sve:
  vendor "arm"
  extension_name "sve"
  family "arm"
  intrinsic_style "arm"
  vector_bits "scalable"
  native_sort_order 700
  autodetect true
  mask_repr "vector"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes true
  runtime_lane_count:
    cpp "svcntb() / sizeof({base_type})"
  default_test_target true
  test_runtime_lanes:
    cpp "svcntb() / sizeof({base_type})"
  test_mask_from_bits:
    cpp "::tsl::test::mask_from_bits<{vec}>({mask_bits}, {authored_lanes}, {lanes})"
  test_mask_check:
    cpp "::tsl::test::check_mask_bits<{vec}>({case_name}, {mask}, {expected_bits}, {authored_lanes}, {lanes})"
  test_support_headers:
    cpp ["tsl_test_sve.hpp"]
  cpp:
    supported true
    headers ["arm_sve.h"]
    header_guard "__ARM_FEATURE_SVE"
    test_suite_name "TslSve"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported false
  vector_register_types:
    si8:
      cpp "svint8_t"
    ui8:
      cpp "svuint8_t"
    si16:
      cpp "svint16_t"
    ui16:
      cpp "svuint16_t"
    si32:
      cpp "svint32_t"
    ui32:
      cpp "svuint32_t"
    si64:
      cpp "svint64_t"
    ui64:
      cpp "svuint64_t"
    f32:
      cpp "svfloat32_t"
    f64:
      cpp "svfloat64_t"
  intrinsic_compose:
    prefix:
      cpp ""
    suffix:
      by_type:
        f32 "f32"
        f64 "f64"
        si8 "s8"
        si16 "s16"
        si32 "s32"
        si64 "s64"
        ui8 "u8"
        ui16 "u16"
        ui32 "u32"
        ui64 "u64"
  mask_type_policy:
    kind "native_predicate"
    backend_spelling:
      cpp "svbool_t"
  integral_mask_type_policy:
    kind "same_as_mask_type"

extension sve128:
  vendor "arm"
  extension_name "sve128"
  inherits "sve"
  vector_bits 128
  native_sort_order 710
  autodetect false
  active_when:
    target_features ["sve"]
    compile_modes ["sve_vector_bits_128"]
  supersedes ["sve"]
  mask_repr "vector"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    compile_guards:
      sve_vector_bits:
        macro "__ARM_FEATURE_SVE_BITS"
        equals 128
        hint_flag "-msve-vector-bits=128"
        diagnostic "TSL sve128 profile requires -msve-vector-bits=128"
  vector_register_types:
    si8:
      cpp "svint8_t __attribute__((arm_sve_vector_bits(128)))"
    ui8:
      cpp "svuint8_t __attribute__((arm_sve_vector_bits(128)))"
    si16:
      cpp "svint16_t __attribute__((arm_sve_vector_bits(128)))"
    ui16:
      cpp "svuint16_t __attribute__((arm_sve_vector_bits(128)))"
    si32:
      cpp "svint32_t __attribute__((arm_sve_vector_bits(128)))"
    ui32:
      cpp "svuint32_t __attribute__((arm_sve_vector_bits(128)))"
    si64:
      cpp "svint64_t __attribute__((arm_sve_vector_bits(128)))"
    ui64:
      cpp "svuint64_t __attribute__((arm_sve_vector_bits(128)))"
    f32:
      cpp "svfloat32_t __attribute__((arm_sve_vector_bits(128)))"
    f64:
      cpp "svfloat64_t __attribute__((arm_sve_vector_bits(128)))"
  mask_type_policy:
    kind "native_predicate"
    backend_spelling:
      cpp "svbool_t __attribute__((arm_sve_vector_bits(128)))"
  integral_mask_type_policy:
    kind "same_as_mask_type"

