extension avx512:
  vendor "intel"
  extension_name "avx512"
  family "x86"
  intrinsic_style "x86"
  vector_bits 512
  native_sort_order 500
  autodetect true
  mask_repr "bitset"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["immintrin.h"]
    test_suite_name "TslAvx512"
    test_support_header "tests/avx512_support.hpp"
  rust:
    supported true
    type_name "Avx512"
    arch_module "x86_64"
    generation_support ["avx2"]
  vector_register_types:
    ?i?:
      cpp "__m512i"
      rust "core::arch::x86_64::__m512i"
    f32:
      cpp "__m512"
      rust "core::arch::x86_64::__m512"
    f64:
      cpp "__m512d"
      rust "core::arch::x86_64::__m512d"
  intrinsic_compose:
    prefix:
      cpp "_mm512_"
      rust "core::arch::x86_64::_mm512_"
    suffix:
      by_type:
        f32 "ps"
        f64 "pd"
        si8 "epi8"
        si16 "epi16"
        si32 "epi32"
        si64 "epi64"
        ui8 "epu8"
        ui16 "epu16"
        ui32 "epu32"
        ui64 "epu64"
  mask_type_policy:
    kind "native_predicate_by_lanes"
    backend_spelling_by_lanes:
      cpp:
        8 "__mmask8"
        16 "__mmask16"
        32 "__mmask32"
        64 "__mmask64"
      rust:
        8 "core::arch::x86_64::__mmask8"
        16 "core::arch::x86_64::__mmask16"
        32 "core::arch::x86_64::__mmask32"
        64 "core::arch::x86_64::__mmask64"
  integral_mask_type_policy:
    kind "same_as_mask_type"

extension avx2:
  vendor "intel"
  extension_name "avx2"
  family "x86"
  intrinsic_style "x86"
  vector_bits 256
  native_sort_order 300
  autodetect true
  mask_repr "lane_bitmask"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["immintrin.h"]
    test_suite_name "TslAvx2"
    test_support_header "tests/avx2_support.hpp"
  rust:
    supported true
    type_name "Avx2"
    arch_module "x86_64"
    generation_support ["sse"]
  vector_register_types:
    ?i?:
      cpp "__m256i"
      rust "core::arch::x86_64::__m256i"
    f32:
      cpp "__m256"
      rust "core::arch::x86_64::__m256"
    f64:
      cpp "__m256d"
      rust "core::arch::x86_64::__m256d"
  intrinsic_compose:
    prefix:
      cpp "_mm256_"
      rust "core::arch::x86_64::_mm256_"
    suffix:
      by_type:
        f32 "ps"
        f64 "pd"
        si8 "epi8"
        si16 "epi16"
        si32 "epi32"
        si64 "epi64"
        ui8 "epu8"
        ui16 "epu16"
        ui32 "epu32"
        ui64 "epu64"
  mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  integral_mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension avx2_vl:
  vendor "intel"
  extension_name "avx2"
  inherits "avx2"
  vector_bits 256
  native_sort_order 400
  autodetect true
  active_when:
    target_features ["avx2", "avx512f", "avx512vl"]
