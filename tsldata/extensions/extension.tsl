extension sve:
  extension_name "sve"
  family "arm"
  documentation_width "SVE"
  vector_bits "scalable"
  native_sort_order 700
  runtime_lane_count:
    cpp "svcntb() / sizeof({base_type})"
  default_test_target true
  test_runtime_lanes:
    cpp "svcntb() / sizeof({base_type})"
  test_mask_from_bits:
    cpp "::tsl::test::mask_from_bits<{vec}>({mask_bits}, {authored_lanes}, {lanes})"
  test_mask_check:
    cpp "::tsl::test::check_mask_bits<{vec}>({case_name}, {mask}, {expected_bits}, {authored_lanes}, {lanes})"
  test_support_headers:
    cpp ["tsl_test_sve.hpp"]
  cpp:
    supported true
    headers ["arm_sve.h"]
  rust:
    supported false
  vector_register_types:
    si8:
      cpp "svint8_t"
    ui8:
      cpp "svuint8_t"
    si16:
      cpp "svint16_t"
    ui16:
      cpp "svuint16_t"
    si32:
      cpp "svint32_t"
    ui32:
      cpp "svuint32_t"
    si64:
      cpp "svint64_t"
    ui64:
      cpp "svuint64_t"
    f32:
      cpp "svfloat32_t"
    f64:
      cpp "svfloat64_t"
  intrinsic_compose:
    prefix:
      cpp ""
    suffix:
      by_type:
        f32 "f32"
        f64 "f64"
        si8 "s8"
        si16 "s16"
        si32 "s32"
        si64 "s64"
        ui8 "u8"
        ui16 "u16"
        ui32 "u32"
        ui64 "u64"
  mask_type_policy:
    kind "native_predicate"
    backend_spelling:
      cpp "svbool_t"
  integral_mask_type_policy:
    kind "same_as_mask_type"

extension rvv:
  extension_name "rvv"
  family "rvv"
  documentation_width "RVV"
  vector_bits "scalable"
  native_sort_order 750
  runtime_lane_count:
    cpp "__riscv_vlenb() / sizeof({base_type})"
  default_test_target true
  test_runtime_lanes:
    cpp "__riscv_vlenb() / sizeof({base_type})"
  test_mask_from_bits:
    cpp "::tsl::test::mask_from_bits<{vec}>({mask_bits}, {authored_lanes}, {lanes})"
  test_mask_check:
    cpp "::tsl::test::check_mask_bits<{vec}>({case_name}, {mask}, {expected_bits}, {authored_lanes}, {lanes})"
  test_support_headers:
    cpp ["tsl_test_rvv.hpp"]
  cpp:
    supported true
    headers ["riscv_vector.h"]
    compiler_capabilities [riscv_vector]
  rust:
    supported false
  vector_register_types:
    si8:
      cpp "vint8m1_t"
    ui8:
      cpp "vuint8m1_t"
    si16:
      cpp "vint16m1_t"
    ui16:
      cpp "vuint16m1_t"
    si32:
      cpp "vint32m1_t"
    ui32:
      cpp "vuint32m1_t"
    si64:
      cpp "vint64m1_t"
    ui64:
      cpp "vuint64m1_t"
    f32:
      cpp "vfloat32m1_t"
    f64:
      cpp "vfloat64m1_t"
  intrinsic_compose:
    prefix:
      cpp "__riscv_"
    suffix:
      by_type:
        f32 "f32m1"
        f64 "f64m1"
        si8 "i8m1"
        si16 "i16m1"
        si32 "i32m1"
        si64 "i64m1"
        ui8 "u8m1"
        ui16 "u16m1"
        ui32 "u32m1"
        ui64 "u64m1"
  mask_type_policy:
    kind "native_predicate_by_type"
    backend_spelling_by_type:
      cpp:
        si8 "vbool8_t"
        ui8 "vbool8_t"
        si16 "vbool16_t"
        ui16 "vbool16_t"
        si32 "vbool32_t"
        ui32 "vbool32_t"
        f32 "vbool32_t"
        si64 "vbool64_t"
        ui64 "vbool64_t"
        f64 "vbool64_t"
  integral_mask_type_policy:
    kind "same_as_mask_type"

# Fixed-width SVE variants reuse scalable SVE primitive bodies through `inherits`,
# but `supersedes ["sve"]` makes each fixed profile emit one SVE model instead
# of both scalable and fixed SVE. The fixed width is a compiler mode, not a
# hardware target feature: machine profiles pair target_features ["sve"] with a
# compile_modes entry such as "sve_vector_bits_512" and the matching
# -msve-vector-bits flag. C++ accepts scalable SVE plus the selected fixed width
# in one translation unit, but not several fixed SVE widths at once.
extension sve128:
  extension_name "sve128"
  inherits "sve"
  vector_bits 128
  native_sort_order 710
  active_when:
    target_features ["sve"]
    compile_modes ["sve_vector_bits_128"]
  supersedes ["sve"]
  default_test_target true
  cpp:
    compiler_capabilities [sve_vector_bits_128]
  vector_register_types:
    si8:
      cpp "svint8_t __attribute__((arm_sve_vector_bits(128)))"
    ui8:
      cpp "svuint8_t __attribute__((arm_sve_vector_bits(128)))"
    si16:
      cpp "svint16_t __attribute__((arm_sve_vector_bits(128)))"
    ui16:
      cpp "svuint16_t __attribute__((arm_sve_vector_bits(128)))"
    si32:
      cpp "svint32_t __attribute__((arm_sve_vector_bits(128)))"
    ui32:
      cpp "svuint32_t __attribute__((arm_sve_vector_bits(128)))"
    si64:
      cpp "svint64_t __attribute__((arm_sve_vector_bits(128)))"
    ui64:
      cpp "svuint64_t __attribute__((arm_sve_vector_bits(128)))"
    f32:
      cpp "svfloat32_t __attribute__((arm_sve_vector_bits(128)))"
    f64:
      cpp "svfloat64_t __attribute__((arm_sve_vector_bits(128)))"
  mask_type_policy:
    kind "native_predicate"
    backend_spelling:
      cpp "svbool_t __attribute__((arm_sve_vector_bits(128)))"
  integral_mask_type_policy:
    kind "same_as_mask_type"

extension sve256:
