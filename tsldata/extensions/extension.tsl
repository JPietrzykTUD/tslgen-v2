extension scalar:
  extension_name "scalar"
  family "scalar"
  vector_bits 0
  native_sort_order 0
  default_test_target false
  cpp:
    supported true
  rust:
    supported true
    type_name "Scalar"
  vector_register_type_policy:
    kind "base_type"
  mask_type_policy:
    kind "bool"
  integral_mask_type_policy:
    kind "unsigned_scalar"
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

# Clang extended-vector overlays are C++-only and emitted into a dedicated,
# opt-in profile header. They deliberately do not participate in
# dataparallel::native/fixed<N> inference: those policies remain the bridge to
# the hardware-backed extension selected by the enclosing machine profile.
# The default mask type is Clang's exact vector-comparison result. Additive
# boolean-vector variants below expose the dense one-bit-per-lane alternative.
extension clang_v128:
  extension_name "clang_v128"
  inherits "generic"
  family "compiler_builtin"
  vector_bits 128
  native_sort_order 0
  default_test_target true
  cpp:
    supported true
    compiler_capabilities [clang_vector_types]
    dataparallel_inference false
  rust:
    supported false
  vector_register_types:
    si8:
      cpp "std::int8_t __attribute__((ext_vector_type(16)))"
    ui8:
      cpp "std::uint8_t __attribute__((ext_vector_type(16)))"
    si16:
      cpp "std::int16_t __attribute__((ext_vector_type(8)))"
    ui16:
      cpp "std::uint16_t __attribute__((ext_vector_type(8)))"
    si32:
      cpp "std::int32_t __attribute__((ext_vector_type(4)))"
    ui32:
      cpp "std::uint32_t __attribute__((ext_vector_type(4)))"
    si64:
      cpp "std::int64_t __attribute__((ext_vector_type(2)))"
    ui64:
      cpp "std::uint64_t __attribute__((ext_vector_type(2)))"
    f32:
      cpp "float __attribute__((ext_vector_type(4)))"
    f64:
      cpp "double __attribute__((ext_vector_type(2)))"
  mask_type_policy:
    kind "comparison_lane_vector"
  integral_mask_type_policy:
    kind "lane_bitmask"

extension clang_v256:
  extension_name "clang_v256"
  inherits "clang_v128"
  vector_bits 256
  default_test_target true
  vector_register_types:
    si8:
      cpp "std::int8_t __attribute__((ext_vector_type(32)))"
    ui8:
      cpp "std::uint8_t __attribute__((ext_vector_type(32)))"
    si16:
      cpp "std::int16_t __attribute__((ext_vector_type(16)))"
    ui16:
      cpp "std::uint16_t __attribute__((ext_vector_type(16)))"
    si32:
      cpp "std::int32_t __attribute__((ext_vector_type(8)))"
    ui32:
      cpp "std::uint32_t __attribute__((ext_vector_type(8)))"
    si64:
      cpp "std::int64_t __attribute__((ext_vector_type(4)))"
    ui64:
      cpp "std::uint64_t __attribute__((ext_vector_type(4)))"
    f32:
      cpp "float __attribute__((ext_vector_type(8)))"
    f64:
      cpp "double __attribute__((ext_vector_type(4)))"

extension clang_v512:
  extension_name "clang_v512"
  inherits "clang_v256"
  vector_bits 512
  default_test_target true
  vector_register_types:
    si8:
      cpp "std::int8_t __attribute__((ext_vector_type(64)))"
    ui8:
      cpp "std::uint8_t __attribute__((ext_vector_type(64)))"
    si16:
      cpp "std::int16_t __attribute__((ext_vector_type(32)))"
    ui16:
      cpp "std::uint16_t __attribute__((ext_vector_type(32)))"
    si32:
      cpp "std::int32_t __attribute__((ext_vector_type(16)))"
    ui32:
      cpp "std::uint32_t __attribute__((ext_vector_type(16)))"
    si64:
      cpp "std::int64_t __attribute__((ext_vector_type(8)))"
    ui64:
      cpp "std::uint64_t __attribute__((ext_vector_type(8)))"
    f32:
      cpp "float __attribute__((ext_vector_type(16)))"
    f64:
      cpp "double __attribute__((ext_vector_type(8)))"

# Additive Clang boolean-mask overlays. Their data registers and most primitive
# bodies are inherited from the corresponding comparison-vector extension;
# representation-specific conversions may override that shared path. Keeping
# both identities lets one generated project compile and benchmark both mask
# contracts without changing the established clang_v* ABI.
extension clang_v128_bool:
  extension_name "clang_v128_bool"
  inherits "clang_v128"
  native_sort_order 10
  default_test_target true
  cpp:
    compiler_capabilities [ext_vector_type_boolean]
  mask_type_policy:
    kind "boolean_lane_vector"

extension clang_v256_bool:
  extension_name "clang_v256_bool"
  inherits "clang_v256"
  native_sort_order 10
  default_test_target true
  cpp:
    compiler_capabilities [ext_vector_type_boolean]
  mask_type_policy:
    kind "boolean_lane_vector"

extension clang_v512_bool:
  extension_name "clang_v512_bool"
  inherits "clang_v512"
  native_sort_order 10
  default_test_target true
  cpp:
    compiler_capabilities [ext_vector_type_boolean]
  mask_type_policy:
    kind "boolean_lane_vector"

extension generic:
  extension_name "generic"
  family "generic_like"
  vector_bits "sized"
  native_sort_order 0
  default_test_target true
  cpp:
    supported true
  rust:
    supported true
    type_name "Generic"
  size_parameter:
    name "LANES"
  # The total-bit widths the generic vector is instantiated/unrolled at (multiples of 128).
  # Bounds the monomorphized variant matrix for size-changing primitives that opt into
  # `unroll_variants`; lane-local primitives stay parametric over LANES regardless.
  size_bits [128, 256, 512]
  unroll_variants false
  vector_register_type_policy:
    kind "fixed_array"
  mask_type_policy:
    kind "lane_bitmask"
  integral_mask_type_policy:
    kind "lane_bitmask"
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]
