extension scalar:
  vendor ""
  extension_name "scalar"
  family "scalar"
  intrinsic_style "scalar"
  vector_bits 0
  native_sort_order 0
  autodetect false
  mask_repr "scalar"
  mask_width 64
  mask_vector_loadable false
  runtime_lanes false
  default_test_target false
  cpp:
    supported true
    test_suite_name "TslScalar"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Scalar"
    generation_support []
  vector_register_type_policy:
    kind "base_type"
  mask_type_policy:
    kind "bool"
  integral_mask_type_policy:
    kind "unsigned_scalar"
    cpp "std::uint64_t"
    rust "u64"
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension generic:
  vendor ""
  extension_name "generic"
  family "generic_like"
  intrinsic_style "generic"
  vector_bits "sized"
  native_sort_order 0
  autodetect false
  mask_repr "lane_bitmask"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    test_suite_name "TslGeneric"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Generic"
    generation_support []
  size_parameter:
    kind "lanes"
    name "LANES"
  # The total-bit widths the generic vector is instantiated/unrolled at (multiples of 128).
  # Bounds the monomorphized variant matrix for size-changing primitives that opt into
  # `unroll_variants`; lane-local primitives stay parametric over LANES regardless.
  size_bits [128, 256, 512]
  unroll_variants false
  vector_register_type_policy:
    kind "fixed_array"
    element "base_type"
    length "LANES"
  mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  integral_mask_type_policy:
    kind "lane_bitmask"
    width "lanes"
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_sizes_bits [128]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]
