extension avx512:
  vendor "intel"
  extension_name "avx512"
  family "x86"
  intrinsic_style "x86"
  vector_bits 512
  native_sort_order 500
  autodetect true
  lscpu_flags ["avx512f"]
  mask_repr "bitset"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["immintrin.h"]
    test_suite_name "TslAvx512"
    test_support_header "tests/avx512_support.hpp"
  rust:
    supported true
    type_name "Avx512"
    generation_support ["avx2"]

extension avx2:
  vendor "intel"
  extension_name "avx2"
  family "x86"
  intrinsic_style "x86"
  vector_bits 256
  native_sort_order 300
  autodetect true
  lscpu_flags ["avx2"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable true
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["immintrin.h"]
    test_suite_name "TslAvx2"
    test_support_header "tests/avx2_support.hpp"
  rust:
    supported true
    type_name "Avx2"
    generation_support ["sse"]
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension avx2_vl:
  vendor "intel"
  extension_name "avx2"
  inherits "avx2"
  vector_bits 256
  native_sort_order 400
  autodetect true
  lscpu_flags ["avx2", "avx512f", "avx512vl"]
  mask_repr "bitset"
  mask_width "lanes"
  mask_vector_loadable false
  default_test_target true
  cpp:
    test_suite_name "TslAvx2"
  rust:
    supported true
    type_name "Avx2Vl"
    generation_support ["avx2", "sse_vl"]
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension sse:
  vendor "intel"
  extension_name "sse"
  family "x86"
  intrinsic_style "x86"
  vector_bits 128
  native_sort_order 100
  autodetect true
  lscpu_flags ["sse2"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable true
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["immintrin.h"]
    test_suite_name "TslSse"
    test_support_header "tests/avx2_support.hpp"
  rust:
    supported true
    type_name "Sse"
    generation_support []
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension sse_vl:
  vendor "intel"
  extension_name "sse"
  inherits "sse"
  vector_bits 128
  native_sort_order 200
  autodetect true
  lscpu_flags ["sse2", "avx512f", "avx512vl"]
  mask_repr "bitset"
  mask_width "lanes"
  mask_vector_loadable false
  default_test_target true
  cpp:
    test_suite_name "TslSse"
  rust:
    supported true
    type_name "SseVl"
    generation_support ["sse"]
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension cuda:
  vendor "nvidia"
  extension_name "cuda"
  family "cuda"
  intrinsic_style "cuda"
  autodetect true
  lscpu_flags ["cuda"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable false
  runtime_lanes false
  default_test_target false
  cpp:
    supported true
  rust:
    supported false

extension oneAPIfpga:
  vendor "intel"
  extension_name "oneAPIfpga"
  inherits "generic"
  family "generic_like"
  intrinsic_style "generic"
  vector_bits "sized"
  native_sort_order 0
  autodetect false
  lscpu_flags ["oneAPIfpgaDev"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable false
  runtime_lanes false
  default_test_target false
  cpp:
    supported true
    test_suite_name "TslOneAPIfpga"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "OneAPIfpga"
    generation_support []
  test_sizes_bits [128]

extension oneAPIfpgaRTL:
  vendor "intel"
  extension_name "oneAPIfpgaRTL"
  lscpu_flags ["oneAPIfpgaDev"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable false
  default_test_target false

extension neon:
  vendor "arm"
  extension_name "neon"
  family "arm"
  intrinsic_style "arm"
  vector_bits 128
  native_sort_order 600
  autodetect true
  lscpu_flags ["neon"]
  mask_repr "vector"
  mask_width 32
  mask_vector_loadable true
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    headers ["arm_neon.h"]
    header_guard "__ARM_NEON"
    test_suite_name "TslTests"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Neon"
    generation_support []
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension sve:
  vendor "arm"
  extension_name "sve"
  family "arm"
  intrinsic_style "arm"
  vector_bits "scalable"
  native_sort_order 700
  autodetect true
  lscpu_flags ["sve"]
  mask_repr "vector"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes true
  default_test_target true
  cpp:
    supported true
    headers ["arm_sve.h"]
    header_guard "__ARM_FEATURE_SVE"
    test_suite_name "TslSve"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported false

extension scalar:
  vendor ""
  extension_name "scalar"
  family "scalar"
  intrinsic_style "scalar"
  vector_bits 0
  native_sort_order 0
  autodetect false
  lscpu_flags []
  mask_repr "scalar"
  mask_width 64
  mask_vector_loadable false
  runtime_lanes false
  default_test_target false
  cpp:
    supported true
    test_suite_name "TslScalar"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Scalar"
    generation_support []
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]

extension generic:
  vendor ""
  extension_name "generic"
  family "generic_like"
  intrinsic_style "generic"
  vector_bits "sized"
  native_sort_order 0
  autodetect false
  lscpu_flags []
  mask_repr "bitset_array"
  mask_width "lanes"
  mask_vector_loadable false
  runtime_lanes false
  default_test_target true
  cpp:
    supported true
    test_suite_name "TslGeneric"
    test_support_header "tests/scalar_support.hpp"
  rust:
    supported true
    type_name "Generic"
    generation_support []
  signature_support:
    exclude ["void:=(ptr,vidx,v,sImm)", "void:=(m,ptr,vidx,v,sImm)"]
  test_sizes_bits [128]
  test_filter:
    exclude_templates ["scatter", "masked_scatter"]
