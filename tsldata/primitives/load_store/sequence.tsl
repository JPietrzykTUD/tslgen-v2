              )
            );
          """
    [sse, sse_vl]:
      ?i8:
        requires:
          sse [sse, sse2]
          sse_vl [sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IntrinBase, type(base::signed_of(type(base::in))));
            complete(
              intrin<set, build[suffix=base::signed_of(base::in)]>(
                cast<static>(IntrinBase, 15), cast<static>(IntrinBase, 14), cast<static>(IntrinBase, 13), cast<static>(IntrinBase, 12),
                cast<static>(IntrinBase, 11), cast<static>(IntrinBase, 10), cast<static>(IntrinBase, 9), cast<static>(IntrinBase, 8),
                cast<static>(IntrinBase, 7), cast<static>(IntrinBase, 6), cast<static>(IntrinBase, 5), cast<static>(IntrinBase, 4),
                cast<static>(IntrinBase, 3), cast<static>(IntrinBase, 2), cast<static>(IntrinBase, 1), cast<static>(IntrinBase, 0)
              )
            );
          """
