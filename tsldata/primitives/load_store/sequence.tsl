          """
      f32:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<set, build>(
                cast<static>(type(base::in), 15), cast<static>(type(base::in), 14), cast<static>(type(base::in), 13), cast<static>(type(base::in), 12),
                cast<static>(type(base::in), 11), cast<static>(type(base::in), 10), cast<static>(type(base::in), 9), cast<static>(type(base::in), 8),
                cast<static>(type(base::in), 7), cast<static>(type(base::in), 6), cast<static>(type(base::in), 5), cast<static>(type(base::in), 4),
                cast<static>(type(base::in), 3), cast<static>(type(base::in), 2), cast<static>(type(base::in), 1), cast<static>(type(base::in), 0)
              )
            );
          """
      f64:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<set, build>(
                cast<static>(type(base::in), 7), cast<static>(type(base::in), 6), cast<static>(type(base::in), 5), cast<static>(type(base::in), 4),
                cast<static>(type(base::in), 3), cast<static>(type(base::in), 2), cast<static>(type(base::in), 1), cast<static>(type(base::in), 0)
              )
            );
          """
    [avx2, avx2_vl]:
      ?i8:
        requires:
          avx2 [avx]
          avx2_vl [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IntrinBase, type(base::signed_of(type(base::in))));
            complete(
              intrin<set, build[suffix=base::signed_of(base::in)]>(
                cast<static>(IntrinBase, 31), cast<static>(IntrinBase, 30), cast<static>(IntrinBase, 29), cast<static>(IntrinBase, 28),
                cast<static>(IntrinBase, 27), cast<static>(IntrinBase, 26), cast<static>(IntrinBase, 25), cast<static>(IntrinBase, 24),
                cast<static>(IntrinBase, 23), cast<static>(IntrinBase, 22), cast<static>(IntrinBase, 21), cast<static>(IntrinBase, 20),
                cast<static>(IntrinBase, 19), cast<static>(IntrinBase, 18), cast<static>(IntrinBase, 17), cast<static>(IntrinBase, 16),
                cast<static>(IntrinBase, 15), cast<static>(IntrinBase, 14), cast<static>(IntrinBase, 13), cast<static>(IntrinBase, 12),
                cast<static>(IntrinBase, 11), cast<static>(IntrinBase, 10), cast<static>(IntrinBase, 9), cast<static>(IntrinBase, 8),
                cast<static>(IntrinBase, 7), cast<static>(IntrinBase, 6), cast<static>(IntrinBase, 5), cast<static>(IntrinBase, 4),
                cast<static>(IntrinBase, 3), cast<static>(IntrinBase, 2), cast<static>(IntrinBase, 1), cast<static>(IntrinBase, 0)
              )
            );
          """
      ?i16:
        requires:
          avx2 [avx]
          avx2_vl [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IntrinBase, type(base::signed_of(type(base::in))));
            complete(
              intrin<set, build[suffix=base::signed_of(base::in)]>(
                cast<static>(IntrinBase, 15), cast<static>(IntrinBase, 14), cast<static>(IntrinBase, 13), cast<static>(IntrinBase, 12),
                cast<static>(IntrinBase, 11), cast<static>(IntrinBase, 10), cast<static>(IntrinBase, 9), cast<static>(IntrinBase, 8),
                cast<static>(IntrinBase, 7), cast<static>(IntrinBase, 6), cast<static>(IntrinBase, 5), cast<static>(IntrinBase, 4),
                cast<static>(IntrinBase, 3), cast<static>(IntrinBase, 2), cast<static>(IntrinBase, 1), cast<static>(IntrinBase, 0)
              )
            );
          """
      ?i32:
        requires:
          avx2 [avx]
          avx2_vl [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IntrinBase, type(base::signed_of(type(base::in))));
            complete(
              intrin<set, build[suffix=base::signed_of(base::in)]>(
                cast<static>(IntrinBase, 7), cast<static>(IntrinBase, 6), cast<static>(IntrinBase, 5), cast<static>(IntrinBase, 4),
                cast<static>(IntrinBase, 3), cast<static>(IntrinBase, 2), cast<static>(IntrinBase, 1), cast<static>(IntrinBase, 0)
