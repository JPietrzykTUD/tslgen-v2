          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IntrinBase, type(base::signed_of(type(base::in))));
            complete(
              intrin<set, build[suffix="epi64x"]>(
                cast<static>(IntrinBase, 3), cast<static>(IntrinBase, 2), cast<static>(IntrinBase, 1), cast<static>(IntrinBase, 0)
              )
            );
          """
      f32:
        requires:
          avx2 [avx]
          avx2_vl [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<set, build>(
                cast<static>(type(base::in), 7), cast<static>(type(base::in), 6), cast<static>(type(base::in), 5), cast<static>(type(base::in), 4),
                cast<static>(type(base::in), 3), cast<static>(type(base::in), 2), cast<static>(type(base::in), 1), cast<static>(type(base::in), 0)
              )
            );
          """
      f64:
        requires:
