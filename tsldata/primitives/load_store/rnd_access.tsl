                  cast<reinterpret, type=const_ptr>(SignedBase, base_ptr),
                  index,
                  4
                ));
              }
              8 => {
                complete(intrin<i64gather, build[suffix=base::signed_of(base::in), immediate(2)=8]>(
                  cast<reinterpret, type=const_ptr>(SignedBase, base_ptr),
                  index,
                  8
                ));
              }
              _ => {
                var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
                var<infer>(result, call<primitive=to_array[Vec]>(call<primitive=set_zero[Vec]>()));
                loop<backend>(i, 0, value(vector::length), 1) {
                  result[i] = *(cast<reinterpret, type=const_ptr>(type(base::in), ptr_add(cast<reinterpret, type=const_ptr>(type(scalar::ui8), base_ptr), idx_offset(idx_array[i], scale))));
                }
                complete(call<primitive=from_array[Vec]>(result));
