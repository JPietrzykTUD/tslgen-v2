                  2
                ));
              }
              4 => {
                complete(intrin<i64gather, build[immediate(2)=4]>(
                  index,
                  base_ptr,
                  4
                ));
              }
              8 => {
                complete(intrin<i64gather, build[immediate(2)=8]>(
