                loop<backend>(i, 0, value(vector::length), 1) {
                  *(cast<reinterpret, type=ptr>(type(base::in), ptr_add_mut(cast<reinterpret, type=ptr>(type(scalar::ui8), base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
                }
