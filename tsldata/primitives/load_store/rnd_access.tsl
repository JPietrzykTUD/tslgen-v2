    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [intrinsic, raw_pointer]
        implementation:
          tsil """
            let<type>(Base, base::in);
            let<type>(DataVec, vector::as_base(Base));
            let<type>(IndexBase, base::generic(IndicesType));
            if constexpr (
              std::is_same_v<typename IndicesType::extension_type, typename Vec::extension_type> &&
              sizeof(type(IndexBase)) == sizeof(type(Base))
            ) {
              switch<compile>(scale) {
                4 => {
                  if<generation>(
                    type::is_same(base::in, si32) ||
                    type::is_same(base::in, ui32) ||
                    type::is_same(base::in, f32)
                  ) {
                    var<const_infer>(loaded, intrin<svld1_gather_index>(mask, base_ptr, index));
                    complete(call<primitive=select[Vec]>(mask, loaded, source));
                  }
                }
                8 => {
                  if<generation>(
                    type::is_same(base::in, si64) ||
                    type::is_same(base::in, ui64) ||
                    type::is_same(base::in, f64)
                  ) {
                    var<const_infer>(loaded, intrin<svld1_gather_index>(mask, base_ptr, index));
                    complete(call<primitive=select[Vec]>(mask, loaded, source));
                  }
                }
                _ => {}
              }
            }
            var<const_infer>(lanes, value(generic::runtime_length(DataVec)));
            var<const_infer>(index_lanes, value(generic::runtime_length(IndicesType)));
            var<runtime_array>(IndexBase, idx_array, index_lanes);
            var<runtime_array>(Base, result, lanes);
            var<runtime_array>(Base, active_array, lanes);
            call<primitive=store[IndicesType], attrs[aligned=false]>(idx_array, index);
            call<primitive=store[Vec], attrs[aligned=false]>(result, source);
            var<const_infer>(active, call<primitive=select[Vec]>(
              mask,
              call<primitive=set1[Vec]>(cast<static>(Base, 1)),
              call<primitive=set_zero[Vec]>()
            ));
            call<primitive=store[Vec], attrs[aligned=false]>(active_array, active);
            loop<backend>(i, 0, lanes, 1) {
              if (active_array[i] != cast<static>(Base, 0)) {
                result[i] = *(cast<reinterpret, type=const_ptr>(Base, ptr_add(cast<reinterpret, type=const_ptr>(scalar::ui8, base_ptr), idx_offset(idx_array[i], scale))));
              }
            }
            complete(call<primitive=load[Vec], attrs[aligned=false]>(result));
          """
    [avx512, avx2, avx2_vl, sse, sse_vl]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          avx2_vl [avx2]
          sse [sse2]
          sse_vl [sse2]
        safety:
