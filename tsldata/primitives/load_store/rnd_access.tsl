            let<type>(Base, type(base::in));
            let<type>(IndexBase, type(base::generic(IndicesType)));
            var<const_infer>(lanes, (intrin<svcntb>() / sizeof(Base)));
            var<runtime_array>(Base, val_array, lanes);
            var<runtime_array>(IndexBase, idx_array, lanes);
            intrin<svst1, build>(call<primitive=mask_true[Vec]>(), val_array, a);
            intrin<svst1>(
              call<primitive=mask_true[IndicesType]>(),
              idx_array,
              index
            );
            loop<backend>(i, 0, lanes, 1) {
              *(cast<reinterpret, type=ptr>(Base, ptr_add_mut(cast<reinterpret, type=ptr>(type(scalar::ui8), base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
            }
          """
