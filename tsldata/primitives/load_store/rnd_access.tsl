                var<infer>(result, call<primitive=to_array[Vec]>(call<primitive=set_zero[Vec]>()));
                loop<generation, scoped>(i, 0, value(vector::length), 1) {
                  result[value(i)] = *(cast<reinterpret, type=const_ptr>(base::in, ptr_add(cast<reinterpret, type=const_ptr>(scalar::ui8, base_ptr), idx_offset(idx_array[value(i)], scale))));
