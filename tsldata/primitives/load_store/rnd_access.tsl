              }
              _ => {
                var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
                var<infer>(result, call<primitive=to_array[Vec]>(call<primitive=set_zero[Vec]>()));
                loop<backend>(i, 0, value<generation>(vector::length), 1) {
                  result[i] = *(cast<reinterpret>(type<generation>(base::in) const *, ptr_add(cast<reinterpret>(type<backend>(scalar::ui8) *, base_ptr), idx_offset(idx_array[i], scale))));
                }
                complete(call<primitive=from_array[Vec]>(result));
              }
            }
          """
    [avx2, avx2_vl]:
      ?i32:
        requires:
          avx2 [avx, avx2]
          avx2_vl [avx, avx2]
        safety:
