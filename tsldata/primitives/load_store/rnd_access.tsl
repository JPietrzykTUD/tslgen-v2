    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [intrinsic, raw_pointer]
        implementation:
          tsil """
            let<type>(Base, base::in);
            let<type>(DataVec, vector::as_base(Base));
            let<type>(IndexBase, base::generic(IndicesType));
            if constexpr (
              std::is_same_v<typename IndicesType::extension_type, typename Vec::extension_type> &&
              sizeof(type(IndexBase)) == sizeof(type(Base))
            ) {
              switch<compile>(scale) {
                4 => {
                  if<generation>(
                    type::is_same(base::in, si32) ||
                    type::is_same(base::in, ui32) ||
                    type::is_same(base::in, f32)
                  ) {
                    complete(intrin<svld1_gather_index>(
                      call<primitive=mask_true[Vec]>(),
                      base_ptr,
                      index
                    ));
                  }
                }
                8 => {
                  if<generation>(
                    type::is_same(base::in, si64) ||
                    type::is_same(base::in, ui64) ||
                    type::is_same(base::in, f64)
                  ) {
                    complete(intrin<svld1_gather_index>(
                      call<primitive=mask_true[Vec]>(),
                      base_ptr,
                      index
                    ));
                  }
                }
                _ => {}
              }
            }
            var<const_infer>(lanes, value(generic::runtime_length(DataVec)));
            var<const_infer>(index_lanes, value(generic::runtime_length(IndicesType)));
            var<runtime_array>(IndexBase, idx_array, index_lanes);
            var<runtime_array>(Base, result, lanes);
            call<primitive=store[IndicesType], attrs[aligned=false]>(idx_array, index);
            loop<backend>(i, 0, lanes, 1) {
              result[i] = *(cast<reinterpret, type=const_ptr>(Base, ptr_add(cast<reinterpret, type=const_ptr>(scalar::ui8, base_ptr), idx_offset(idx_array[i], scale))));
            }
            var<const_infer>(loaded, call<primitive=load[Vec], attrs[aligned=false]>(result));
            complete(loaded);
          """
    clang_v128:
      arith:
        requires []
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [raw_pointer]
        implementation:
          tsil """
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_index, call<primitive=extract_value[IndicesType, i]>(index));
              result[value(i)] = *(cast<reinterpret, type=const_ptr>(
                base::in,
                ptr_add(
                  cast<reinterpret, type=const_ptr>(scalar::ui8, base_ptr),
                  idx_offset(lane_index, scale)
                )
              ));
            }
            complete(result);
          """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [raw_pointer]
        implementation:
          tsil """
            var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane, *(cast<reinterpret, type=const_ptr>(
                base::in,
                ptr_add(
                  cast<reinterpret, type=const_ptr>(scalar::ui8, base_ptr),
                  idx_offset(idx_array[value(i)], scale)
                )
              )));
              result = call<primitive=insert_value[Vec, i]>(
                result,
                lane
              );
            }
            complete(result);
          """
    wasm128:
      arith:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [raw_pointer]
        implementation:
          tsil """
            var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
