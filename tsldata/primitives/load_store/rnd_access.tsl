                );
                return;
              }
              4 => {
                intrin<mask_i64scatter, build[suffix=base::signed_of(base::in), immediate(4)=4]>(
                  cast<reinterpret>(SignedBase *, base_ptr),
                  mask,
                  index,
                  a,
                  4
                );
                return;
              }
              8 => {
                intrin<mask_i64scatter, build[suffix=base::signed_of(base::in), immediate(4)=8]>(
                  cast<reinterpret>(SignedBase *, base_ptr),
                  mask,
                  index,
                  a,
                  8
                );
                return;
              }
              _ => {
                var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
                var<const_infer>(val_array, call<primitive=to_array[Vec]>(a));
                loop<backend>(i, 0, value<generation>(vector::length), 1) {
                  if (mask<test>(mask, i)) {
                    *(cast<reinterpret>(type<generation>(base::in) *, ptr_add_mut(cast<reinterpret>(type<backend>(scalar::ui8) *, base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
                  }
                }
              }
            }
          """
      f32:
        requires:
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe true
