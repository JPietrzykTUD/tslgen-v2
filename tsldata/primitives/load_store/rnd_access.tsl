                    *(cast<reinterpret>(type<generation>(base::in) *, ptr_add_mut(cast<reinterpret>(type<backend>(scalar::ui8) *, base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
                  }
                }
              }
            }
          """
    [avx512, avx2, avx2_vl, sse, sse_vl, neon, sve, generic, oneAPIfpga]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          avx2_vl [avx2]
          sse [sse2]
          sse_vl [sse2]
          neon [neon]
          sve [sve]
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [raw_pointer]
        implementation:
          tsil """
            var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
            var<const_infer>(val_array, call<primitive=to_array[Vec]>(a));
            loop<backend>(i, 0, value<generation>(vector::length), 1) {
              if (mask<test>(mask, i)) {
                *(cast<reinterpret>(type<generation>(base::in) *, ptr_add_mut(cast<reinterpret>(type<backend>(scalar::ui8) *, base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
              }
            }
          """
    scalar:
      ?i?:
        requires []
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [raw_pointer]
        implementation:
          tsil """
            var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
            if (mask) {
              var<infer>(
                ptr,
                cast<reinterpret>(
                  type<generation>(base::in) *,
                  ptr_add_mut(cast<reinterpret>(type<backend>(scalar::ui8) *, base_ptr), idx_offset(idx_array[0], scale))
                )
              );
              *ptr = a;
            }
          """
