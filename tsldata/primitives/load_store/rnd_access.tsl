          tsil """
            let<type>(SignedBase, base::signed_of(base::in));
            switch<compile>(scale) {
              1 => {
                intrin<mask_i32scatter, build[suffix=base::signed_of(base::in), immediate(4)=1]>(
                  cast<reinterpret, type=ptr>(SignedBase, base_ptr),
                  mask,
                  index,
                  a,
                  1
                );
                return;
              }
              2 => {
                intrin<mask_i32scatter, build[suffix=base::signed_of(base::in), immediate(4)=2]>(
                  cast<reinterpret, type=ptr>(SignedBase, base_ptr),
                  mask,
