                  cast<reinterpret>(SignedBase const *, base_ptr),
                  index,
                  1
                ));
              }
              2 => {
                complete(intrin<i32gather, build[suffix=base::signed_of(base::in), immediate(2)=2]>(
                  cast<reinterpret>(SignedBase const *, base_ptr),
