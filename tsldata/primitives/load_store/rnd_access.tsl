                var<infer>(result, call<primitive=to_array[Vec]>(source));
                loop<backend>(i, 0, value(vector::length), 1) {
                  if (mask<test>(mask, i)) {
                    result[i] = *(cast<reinterpret, type=const_ptr>(type(base::in), ptr_add(cast<reinterpret, type=const_ptr>(type(scalar::ui8), base_ptr), idx_offset(idx_array[i], scale))));
                  }
                }
                complete(call<primitive=from_array[Vec]>(result));
              }
            }
          """
      f64:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [intrinsic, raw_pointer]
        implementation:
          tsil """
            switch<compile>(scale) {
