          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [intrinsic, raw_pointer]
        implementation:
          tsil """
            switch<compile>(scale) {
              1 => {
                intrin<mask_i32scatter, build[immediate(4)=1]>(
                  base_ptr,
                  mask,
                  index,
                  a,
                  1
                );
                return;
