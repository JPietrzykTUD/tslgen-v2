                );
                return;
              }
              8 => {
                intrin<i64scatter, build[suffix=base::signed_of(base::in), immediate(3)=8]>(
                  cast<reinterpret, type=ptr>(SignedBase, base_ptr),
                  index,
                  a,
                  8
                );
                return;
              }
              _ => {
                var<const_infer>(val_array, call<primitive=to_array[Vec]>(a));
                var<const_infer>(idx_array, call<primitive=to_array[IndicesType]>(index));
                loop<backend>(i, 0, value(vector::length), 1) {
                  *(cast<reinterpret, type=ptr>(type(base::in), ptr_add_mut(cast<reinterpret, type=ptr>(type(scalar::ui8), base_ptr), idx_offset(idx_array[i], scale)))) = val_array[i];
                }
              }
            }
          """
      f32:
        requires:
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
