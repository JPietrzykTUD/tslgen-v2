          """
      f32:
        requires:
          avx2 [avx, avx2]
          avx2_vl [avx, avx2]
        safety:
          internal_unsafe true
          caller_unsafe true
          reasons [intrinsic, raw_pointer]
        implementation:
          tsil """
            switch<compile>(scale) {
              1 => {
                complete(intrin<i32gather, build[immediate(2)=1]>(
                  base_ptr,
                  index,
                  1
                ));
              }
              2 => {
                complete(intrin<i32gather, build[immediate(2)=2]>(
                  base_ptr,
                  index,
                  2
                ));
              }
              4 => {
                complete(intrin<i32gather, build[immediate(2)=4]>(
                  base_ptr,
                  index,
                  4
                ));
              }
              8 => {
                complete(intrin<i32gather, build[immediate(2)=8]>(
                  base_ptr,
