                )
              )));
              result = call<primitive=insert_value[Vec, i]>(
                result,
                lane
              );
            }
            complete(result);
          """
    [avx512, avx2, avx2_vl, sse, sse_vl]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          avx2_vl [avx2]
          sse [sse2]
          sse_vl [sse2]
        safety:
