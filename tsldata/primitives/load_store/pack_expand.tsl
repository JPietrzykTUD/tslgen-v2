      si8:
        requires [avx512f]
        ToBase:
          si16:
            requires [avx512bw]
            safety:
              internal_unsafe true
              caller_unsafe true
              reasons [intrinsic, raw_pointer]
            implementation:
              tsil """
                   let<type>(InVec, vector::as(avx2, base::in));
                   let<type>(OutVec, vector::as_base(ToBase));
                   var<const_infer>(loaded, call<primitive=load[InVec], attrs[aligned=false]>(ptr));
                   complete(cast<reinterpret>(register::generic(OutVec), intrin<_mm512_cvtepi8_epi16>(loaded)));
