                   mem<copy>(
                     cast<reinterpret, type=ptr>(void, address<borrow_mut>(loaded)),
                     cast<reinterpret, type=const_ptr>(void, ptr),
                     value(generic::length(OutVec)) * value(type::size_bytes(base::in))
