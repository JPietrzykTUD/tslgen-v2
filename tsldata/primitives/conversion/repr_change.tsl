                      complete(cast<reinterpret>(type(register::generic(OutVec)), intrin<_mm_packs_epi32>(data, call<primitive=set_zero[Vec]>())));
                    }
                    _ => {
                      complete(cast<reinterpret>(type(register::generic(OutVec)), intrin<_mm_packs_epi32>(call<primitive=set_zero[Vec]>(), data)));
                    }
                  }
                """
      ui32:
        requires:
          sse [sse4_1]
          sse_vl [sse4_1]
        ToBase:
          ui16:
            safety:
