          sse_vl [sse2]
        ToBase:
          si8:
            implementation:
              tsil """
                  let<type>(OutVec, type<generation>(vector::transform_extension(ToBase)));
                  switch<compile>(index) {
                    0 => {
                      emit_return(cast<reinterpret>(type<generation>(register::generic(OutVec)), intrin<_mm_packs_epi16>(data, call<primitive=set_zero[Vec]>())));
                    }
                    _ => {
                      emit_return(cast<reinterpret>(type<generation>(register::generic(OutVec)), intrin<_mm_packs_epi16>(call<primitive=set_zero[Vec]>(), data)));
                    }
