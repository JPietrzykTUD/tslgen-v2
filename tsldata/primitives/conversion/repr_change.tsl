          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic, raw_pointer]
        implementation:
          tsl """
              let<type>(OutVec, type(vector::window_base(ToBase)));
              let<type>(InBase, type(base::in));
              let<type>(OutBase, type(base::generic(OutVec)));
              var<const_infer>(in_lanes, (intrin<svcntb>() / sizeof(InBase)));
              var<const_infer>(out_lanes, (intrin<svcntb>() / sizeof(OutBase)));
              var<const_infer>(in_values, static_cast<InBase *>(std::malloc(in_lanes * sizeof(InBase))));
              var<const_infer>(out_values, static_cast<OutBase *>(std::malloc(out_lanes * sizeof(OutBase))));

              intrin<svst1, build>(call<primitive=mask_true[Vec]>(), in_values, data);

              loop<backend>(i, 0, out_lanes, 1) {
                out_values[i] = cast<static>(OutBase, 0);
              }

              var<const_infer>(start, cast<static>(type(scalar::size), index) * in_lanes);
              loop<backend>(i, 0, in_lanes, 1) {
                out_values[start + i] = cast<saturating>(OutBase, in_values[i]);
              }

              var<const_infer>(result, intrin<svld1, build[suffix=ToBase]>(call<primitive=mask_true[OutVec]>(), out_values));
              std::free(in_values);
              std::free(out_values);
              complete(result);
            """
    [avx512, avx2, sse, neon, generic, oneapi_fpga, scalar]:
      arith:
        # Monomorphize the sized (generic) software body over `size_bits` (see convert_up) so the
        # width-changed output is a concrete `generic<N>`; fixed-width extensions ignore it.
        unroll_variants true
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
          generic []
          oneapi_fpga [oneapi_fpga_device]
          scalar []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsl """
              let<type>(OutVec, type(vector::window_base(ToBase)));
              let<type>(OutBase, type(base::generic(OutVec)));
              var<infer>(result, call<primitive=to_array[OutVec]>(call<primitive=set_zero[OutVec]>()));
              var<const_infer>(chunk, call<primitive=to_array[Vec]>(data));
              var<const_infer>(start, cast<static>(type(scalar::size), index) * value(vector::length));
              loop<backend>(i, 0, value(vector::length), 1) {
                result[start + i] = cast<saturating>(OutBase, chunk[i]);
              }
              complete(call<primitive=from_array[OutVec]>(result));
            """
