          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(WordVec, vector::as_base(ui32));
              let<type>(QwordVec, vector::as_base(ui64));
              var<const_infer>(permute_vec, intrin<_mm256_set_epi64x>(0x303030303030303, 0x202020202020202, 0x101010101010101, 0x0));
              var<const_infer>(data_vec, call<primitive=set1[WordVec]>(cast<static>(ui32, mask)));
              var<const_infer>(shuffled_vec, intrin<_mm256_shuffle_epi8>(data_vec, permute_vec));
              var<const_infer>(and_vec, call<primitive=set1[QwordVec]>(cast<static>(ui64, 0x8040201008040201)));
              var<const_infer>(and_shuffled_vec, call<primitive=binary_and[Vec]>(shuffled_vec, and_vec));
              complete(call<primitive=equal[Vec]>(and_shuffled_vec, and_vec));
