    wasm128:
      ?i8:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(WordVec, vector::as_base(scalar::si16));
              var<infer>(and_vec, call<primitive=set_zero[WordVec]>());
              loop<generation>(i, 0, 8, 1) {
                and_vec = intrin<replace_lane, build[suffix=si16, immediate(1)=i]>(
                  and_vec,
                  value(i),
                  cast<static>(scalar::si16, (cast<static>(scalar::ui64, 1)) << value(i))
                );
              }
              var<const_infer>(low_data, call<primitive=set1[WordVec]>(
                cast<static>(scalar::si16, mask)
              ));
              var<const_infer>(high_data, call<primitive=set1[WordVec]>(
                cast<static>(scalar::si16, (cast<static>(scalar::ui64, mask) >> 8))
              ));
              var<const_infer>(low_mask, call<primitive=equal[WordVec]>(
                call<primitive=binary_and[WordVec]>(low_data, and_vec),
                and_vec
              ));
              var<const_infer>(high_mask, call<primitive=equal[WordVec]>(
                call<primitive=binary_and[WordVec]>(high_data, and_vec),
                and_vec
              ));
              let<type>(ByteVec, vector::as_base(scalar::si8));
              var<const_infer>(low_chunk, call<primitive=convert_down[WordVec, si8, 0]>(low_mask));
              var<const_infer>(high_chunk, call<primitive=convert_down[WordVec, si8, 1]>(high_mask));
              complete(call<primitive=reinterpret[ByteVec, Vec]>(
                call<primitive=binary_or[ByteVec]>(low_chunk, high_chunk)
              ));
            """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_mask, call<primitive=to_mask[GenericVec]>(cast<static>(scalar::ui64, mask)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=to_array[GenericVec]>(
                    call<primitive=to_vector[GenericVec]>(generic_mask)
                  )
                )
              );
            """
      [ ?i16, ?i32, ?i64 ]:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(CarrierBase, base::signed_of(base::in));
              var<infer>(and_vec, call<primitive=set_zero[Vec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<replace_lane, build[suffix=base::in, immediate(1)=i]>(
                  and_vec,
                  value(i),
                  cast<static>(CarrierBase, (cast<static>(scalar::ui64, 1)) << value(i))
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[Vec]>(cast<static>(base::in, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[Vec]>(data_vec, and_vec));
              complete(call<primitive=equal[Vec]>(anded_vec, and_vec));
            """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
