                cast<static>(scalar::si16, 2048), cast<static>(scalar::si16, 1024),
                cast<static>(scalar::si16, 512), cast<static>(scalar::si16, 256),
                cast<static>(scalar::si16, 128), cast<static>(scalar::si16, 64),
                cast<static>(scalar::si16, 32), cast<static>(scalar::si16, 16),
                cast<static>(scalar::si16, 8), cast<static>(scalar::si16, 4),
