              complete(call<primitive=reinterpret[BitVec, Vec]>(call<primitive=equal[BitVec]>(anded_vec, and_vec)));
            """
      f64:
        requires [sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(BitVec, vector::as_base(si64));
              complete(call<primitive=reinterpret[BitVec, Vec]>(
                intrin<_mm_set_epi64x>(
                  select_expr(mask<test, imask>(mask, 1), cast<static>(scalar::si64, -1), cast<static>(scalar::si64, 0)),
                  select_expr(mask<test, imask>(mask, 0), cast<static>(scalar::si64, -1), cast<static>(scalar::si64, 0))
                )
              ));
            """
    # `insert_value` is implemented through `to_mask`; keep these lane-building
    # implementations as intrinsic leaves to avoid a dependency cycle.
    neon:
      ?i8:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(WordVec, vector::as_base(scalar::ui16));
              let<type>(ByteVec, vector::as_base(scalar::ui8));
              var<infer>(and_vec, call<primitive=set_zero[WordVec]>());
              loop<generation>(i, 0, 8, 1) {
                and_vec = intrin<vsetq_lane_u16, build[suffix="", immediate(2)=i]>(
                  cast<static>(scalar::ui16, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(low_data, call<primitive=set1[WordVec]>(cast<static>(scalar::ui16, mask)));
              var<const_infer>(high_data, call<primitive=set1[WordVec]>(
                cast<static>(scalar::ui16, cast<static>(scalar::ui64, mask) >> 8)
              ));
              var<const_infer>(low_mask, call<primitive=equal[WordVec]>(
                call<primitive=binary_and[WordVec]>(low_data, and_vec),
                and_vec
              ));
              var<const_infer>(high_mask, call<primitive=equal[WordVec]>(
                call<primitive=binary_and[WordVec]>(high_data, and_vec),
                and_vec
              ));
              var<const_infer>(bytes, intrin<vcombine_u8>(
                intrin<vmovn_u16>(low_mask),
                intrin<vmovn_u16>(high_mask)
              ));
              complete(call<primitive=reinterpret[ByteVec, Vec]>(bytes));
            """
      ?i16:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              var<infer>(and_vec, call<primitive=set_zero[Vec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<vsetq_lane, build[suffix=base::in, immediate(2)=i]>(
                  cast<static>(base::in, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[Vec]>(cast<static>(base::in, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[Vec]>(data_vec, and_vec));
              complete(call<primitive=equal[Vec]>(anded_vec, and_vec));
            """
      ?i32:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              var<infer>(and_vec, call<primitive=set_zero[Vec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<vsetq_lane, build[suffix=base::in, immediate(2)=i]>(
                  cast<static>(base::in, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[Vec]>(cast<static>(base::in, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[Vec]>(data_vec, and_vec));
              complete(call<primitive=equal[Vec]>(anded_vec, and_vec));
            """
      ?i64:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              var<infer>(and_vec, call<primitive=set_zero[Vec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<vsetq_lane, build[suffix=base::in, immediate(2)=i]>(
                  cast<static>(base::in, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[Vec]>(cast<static>(base::in, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[Vec]>(data_vec, and_vec));
              complete(call<primitive=equal[Vec]>(anded_vec, and_vec));
            """
      f32:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(MaskVec, vector::as_base(scalar::si32));
              var<infer>(and_vec, call<primitive=set_zero[MaskVec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<vsetq_lane_s32, build[suffix="", immediate(2)=i]>(
                  cast<static>(scalar::si32, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[MaskVec]>(cast<static>(scalar::si32, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[MaskVec]>(data_vec, and_vec));
              var<const_infer>(tmp, call<primitive=equal[MaskVec]>(anded_vec, and_vec));
              complete(call<primitive=reinterpret[MaskVec, Vec]>(tmp));
            """
      f64:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(MaskVec, vector::as_base(scalar::si64));
              var<infer>(and_vec, call<primitive=set_zero[MaskVec]>());
              loop<generation>(i, 0, value(vector::length), 1) {
                and_vec = intrin<vsetq_lane_s64, build[suffix="", immediate(2)=i]>(
                  cast<static>(scalar::si64, (cast<static>(scalar::ui64, 1)) << value(i)),
                  and_vec,
                  value(i)
                );
              }
              var<const_infer>(data_vec, call<primitive=set1[MaskVec]>(cast<static>(scalar::si64, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[MaskVec]>(data_vec, and_vec));
              var<const_infer>(tmp, call<primitive=equal[MaskVec]>(anded_vec, and_vec));
              complete(call<primitive=reinterpret[MaskVec, Vec]>(tmp));
            """
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask<test, imask>(mask, 0));"
    generic:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(MaskT, vector::mask);
              var<typed>(MaskT, result, mask<none>());
              var<const_typed>(scalar::size, mask_bits, value(type::size_bytes(vector::imask)) * 8);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                if (i < mask_bits && mask<test, imask>(mask, i)) {
                  mask<set>(result, i);
                }
              }
              complete(result);
            """
