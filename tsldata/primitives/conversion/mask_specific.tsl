              let<type>(BitVec, vector::as_base(ui64));
              var<const_infer>(and_vec, intrin<_mm256_set_epi64x>(cast<static>(si64, cast<static>(ui64, 0x8)), cast<static>(si64, cast<static>(ui64, 0x4)), cast<static>(si64, cast<static>(ui64, 0x2)), cast<static>(si64, cast<static>(ui64, 0x1))));
              var<const_infer>(data_vec, call<primitive=set1[BitVec]>(cast<static>(ui64, mask)));
              var<const_infer>(anded_vec, call<primitive=binary_and[BitVec]>(data_vec, and_vec));
              complete(call<primitive=reinterpret[BitVec, Vec]>(call<primitive=equal[BitVec]>(anded_vec, and_vec)));
