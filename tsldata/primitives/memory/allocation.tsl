prim<ptr:=(s)> allocate(count_bytes):
  brief_description "Allocates (unaligned) contiguous memory."
  operation ""
  tests:
    - {test_name "allocate_u8_basic", type "ptr", lanes 4, case {inputs [64], expected true}}
    - {test_name "allocate_u8_small", type "ptr", lanes 4, case {inputs [1], expected true}}
    - {test_name "allocate_u8_large", type "ptr", lanes 4, case {inputs [256], expected true}}
    - {test_name "allocate_u8_unaligned_33", type "ptr", lanes 4, case {inputs [33], expected true}}
    - {test_name "allocate_u8_unaligned_65", type "ptr", lanes 4, case {inputs [65], expected true}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, sve, scalar, generic, oneAPIfpga]:
      ptr:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx, avx2]
          sse [sse2]
          neon [neon]
          sve [sve]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        implementation:
          tsil """
              emit_return(cast<reinterpret>(type<vector::base>, mem<alloc>(count_bytes)));
            """
prim<ptr:=(s,s)> allocate_aligned(count_bytes, alignment):
  brief_description "Allocates aligned contiguous memory."
  operation ""
  tests:
    - {test_name "allocate_aligned_u8_basic", type "ptr", lanes 4, case {inputs [64, 32], expected true}}
    - {test_name "allocate_aligned_u8_small", type "ptr", lanes 4, case {inputs [1, 16], expected true}}
    - {test_name "allocate_aligned_u8_large", type "ptr", lanes 4, case {inputs [256, 64], expected true}}
    - {test_name "allocate_aligned_u8_zero", type "ptr", lanes 4, case {inputs [0, 32], expected true}}
    - {test_name "allocate_aligned_u8_stress", type "ptr", lanes 4, case {inputs [512, 64], expected true}}
    - {test_name "allocate_aligned_u8_16", type "ptr", lanes 4, case {inputs [128, 16], expected true}}
    - {test_name "allocate_aligned_u8_64", type "ptr", lanes 4, case {inputs [128, 64], expected true}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, sve, scalar, generic, oneAPIfpga]:
      ptr:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx, avx2]
          sse [sse2]
          neon [neon]
          sve [sve]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        implementation:
          tsil """
              emit_return(cast<reinterpret>(type<vector::base>, mem<alloc_aligned>(count_bytes, alignment)));
            """
prim<void:=(ptr)> deallocate(ptr):
  brief_description "Deallocates (possibly aligned) contiguous memory."
  operation ""
  tests:
    - {test_name "deallocate_u8_basic", type "ptr", lanes 4, case {inputs [64], expected true}}
    - {test_name "deallocate_u8_small", type "ptr", lanes 4, case {inputs [1], expected true}}
    - {test_name "deallocate_u8_large", type "ptr", lanes 4, case {inputs [256], expected true}}
    - {test_name "deallocate_u8_unaligned_33", type "ptr", lanes 4, case {inputs [33], expected true}}
    - {test_name "deallocate_u8_unaligned_65", type "ptr", lanes 4, case {inputs [65], expected true}}
    - {test_name "deallocate_aligned_u8_16", type "ptr", lanes 4, alignment 16, case {inputs [128], expected true}}
    - {test_name "deallocate_aligned_u8_64", type "ptr", lanes 4, alignment 64, case {inputs [128], expected true}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, sve, scalar, generic, oneAPIfpga]:
      ptr:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx, avx2]
          sse [sse2]
          neon [neon]
          sve [sve]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        implementation:
          tsil """
              mem<free>(ptr);
            """
