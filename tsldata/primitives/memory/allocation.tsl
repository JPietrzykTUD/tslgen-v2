prim<ptr:=(usize)> allocate(count_bytes):
  brief_description "Allocates (unaligned) contiguous memory."
  operation ""
  tests:
    - {tags [u8, basic], type "ptr", lane_count 4, case {inputs [64], expected true}}
    - {tags [u8, small], type "ptr", lane_count 4, case {inputs [1], expected true}}
    - {tags [u8, large], type "ptr", lane_count 4, case {inputs [256], expected true}}
    - {tags [u8, unaligned, value33], type "ptr", lane_count 4, case {inputs [33], expected true}}
    - {tags [u8, unaligned, value65], type "ptr", lane_count 4, case {inputs [65], expected true}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, sve, scalar, generic, oneAPIfpga]:
      ptr:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx, avx2]
          sse [sse2]
          neon [neon]
          sve [sve]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        implementation:
          tsil """
              emit_return(cast<reinterpret>(type<generation>(base::in), mem<alloc>(count_bytes)));
            """
