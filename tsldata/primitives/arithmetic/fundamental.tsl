    - {tags [basic], type "si16", case {inputs [[0, 1, -1, -32768, 32767, 2, -2, 12345]], expected [0, -1, 1, -32768, -32767, -2, 2, -12345]}}
    - {tags [signed_min, wrapping], type "si32", case {inputs [[0, 1, -1, -2147483648, 2147483647, 2, -2, 123456789]], expected [0, -1, 1, -2147483648, -2147483647, -2, 2, -123456789]}}
    - {tags [signed_min, wrapping], type "si64", case {inputs [[0, -9223372036854775808, 9223372036854775807, -7]], expected [0, -9223372036854775808, -9223372036854775807, 7]}}
    - {tags [float, sign_bits], type "f32", comparison bitwise, case {inputs [[0.0, -0.0, 1.5, -2.25, INFINITY, "-INFINITY", NAN, "-NAN"]], expected [-0.0, 0.0, -1.5, 2.25, "-INFINITY", INFINITY, "-NAN", NAN]}}
    - {tags [float, sign_bits], type "f64", comparison bitwise, case {inputs [[0.0, -0.0, NAN, "-NAN"]], expected [-0.0, 0.0, "-NAN", NAN]}}
  impls:
    scalar:
      si?:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(UBase, base::unsigned_of(base::in));
            var<const_infer>(bits, cast<bitcast>(UBase, data));
            var<const_typed>(UBase, zero, 0);
            complete(cast<bitcast>(
              base::in,
              cast<static>(UBase, op<sub>(zero, bits))
