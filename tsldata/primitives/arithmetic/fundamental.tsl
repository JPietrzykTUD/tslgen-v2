          sve [sve]
          wasm128 [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(UBase, base::unsigned_of(base::in));
            let<type>(UVec, vector::as_base(UBase));
