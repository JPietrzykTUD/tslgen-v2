            let<type>(UBase, base::unsigned_of(base::in));
            let<type>(SBase, base::signed_of(base::in));
            var<const_infer>(bits, cast<bitcast>(UBase, data));
            var<const_infer>(all_bits, cast<bitcast>(UBase, cast<static>(SBase, -1)));
            var<const_infer>(sign_bit, all_bits ^ (all_bits >> 1));
            complete(cast<bitcast>(base::in, bits ^ sign_bit));
          """
