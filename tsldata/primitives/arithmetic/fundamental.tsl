    - {tags [mask, basic], type "si32", case {inputs [85, [10, 20, 30, 40, 50, 60, 70, 80], [1, 2, 3, 4, 5, 6, 7, 8]], expected [9, 20, 27, 40, 45, 60, 63, 80]}}
