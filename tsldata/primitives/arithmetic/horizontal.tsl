        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type(base::in), intrin<mask_reduce_add, build[suffix=base::signed_of(base::in)]>(mask, vec)));"
    [avx2, sse]:
      [si32, ui32, f32, f64]:
        requires:
          avx2 [avx2]
          sse [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=hadd>(call<primitive=blend>(mask, call<primitive=set_zero[Vec]>(), vec)));"
    [scalar, generic, oneapi_fpga, avx512, avx2, sse, neon]:
