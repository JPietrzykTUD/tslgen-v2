            complete(call<primitive=min[ScalarVec]>(pair02, pair13));
          """
      f64:
        requires [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(ScalarVec, vector::as_extension(scalar));
            complete(call<primitive=min[ScalarVec]>(
              call<primitive=extract_value[Vec, 0]>(vec),
              call<primitive=extract_value[Vec, 1]>(vec)
            ));
          """
    [avx512, avx2, sse, neon]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(values, call<primitive=to_array[Vec]>(vec));
            var<infer>(result, values[0]);
            loop<generation, scoped>(i, 1, value(vector::length), 1) {
              if (values[value(i)] < result) {
                result = values[value(i)];
              }
            }
            complete(result);
          """
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(vec);"
    [generic, clang_v128, oneapi_fpga]:
      arith:
        requires:
          generic []
          clang_v128 []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
