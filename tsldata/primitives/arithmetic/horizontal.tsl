prim<s:=(m,v)> hmax(mask, vec):
  brief_description "Reduces active mask lanes of a vector register to their maximum value."
  detailed_description """
    Compares only the mask-selected vector lanes and returns the greatest active
    lane value as a scalar. If the mask selects no lanes, the result is zero.
    Floating-point unordered cases and signed-zero behavior follow the selected
    backend implementation.
    """
  semantics """
    input: mask mask, register vec
    found = false
    result = 0
    for each lane i:
      if mask[i] is active:
        if found is false:
          result = vec[i]
          found = true
        else if vec[i] > result:
          result = vec[i]
    return result
    """
  tests:
    - {tags [mask, basic], type "si32", lane_count 8, case {inputs [255, [1, 2, 3, 4, 5, 6, 7, 8]], expected 8}}
