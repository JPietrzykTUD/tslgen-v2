    [avx2, sse]:
      ?i?:
        requires:
          avx2 [avx2]
          sse [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(mask_scalar, call<primitive=to_integral[Vec]>(mask));
            if (mask_scalar == 0) {
              complete(cast<static>(base::in, 0));
            }
            let<type>(UBase, base::unsigned_of(base::in));
            if<generation>(type::is_signed(base::in)) {
              var<const_infer>(sentinel, cast<static>(
                base::in,
                ((cast<static>(UBase, 1)) << (value(type::size_bits(base::in)) - 1)) - cast<static>(UBase, 1)
              ));
              complete(call<primitive=hmin[Vec]>(call<primitive=select[Vec]>(
                mask,
                vec,
                call<primitive=set1[Vec]>(sentinel)
              )));
            } else<generation> {
              complete(call<primitive=hmin[Vec]>(call<primitive=select[Vec]>(
                mask,
                vec,
                call<primitive=set1[Vec]>(mask<lane_true>())
              )));
            }
          """
    [avx512, avx2, sse, neon]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(mask_scalar, call<primitive=to_integral[Vec]>(mask));
            var<const_infer>(values, call<primitive=to_array[Vec]>(vec));
            var<typed>(base::in, result, cast<static>(base::in, 0));
            var<typed>(scalar::size, found, 0);
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              if (mask<test, imask>(mask_scalar, value(i))) {
                if (found == 0) {
                  result = values[value(i)];
                  found = 1;
                } else if (values[value(i)] < result) {
                  result = values[value(i)];
                }
              }
            }
            complete(result);
          """
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
