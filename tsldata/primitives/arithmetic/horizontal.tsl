            complete(intrin<_mm_cvtss_f32>(temp));
          """
      f64:
        requires [sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            var<const_infer>(temp, intrin<_mm_min_sd>(vec, intrin<_mm_unpackhi_pd>(vec, vec)));
            complete(intrin<_mm_cvtsd_f64>(temp));
          """
    [scalar, generic, oneapi_fpga, avx512, avx2, sse, neon]:
      arith:
        requires:
          scalar []
          generic []
          oneapi_fpga []
          avx512 [avx512f]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(values, call<primitive=to_array[Vec]>(vec));
            var<infer>(result, values[0]);
            loop<backend>(i, 1, value(vector::length), 1) {
              if (values[i] < result) {
                result = values[i];
              }
            }
            complete(result);
          """

prim<s:=(m,v)> hadd(mask, vec):
  brief_description "Reduces active mask lanes of a vector register to their sum."
  detailed_description """
    Adds only the mask-selected vector lanes and returns the scalar reduction
    result. Inactive lanes contribute zero. If the mask selects no lanes, the
    result is zero. Overflow, floating-point rounding, and reduction association
    follow the selected backend implementation and lane type.
    """
  semantics """
    input: mask mask, register vec
    result = 0
    for each lane i:
      if mask[i] is active:
        result = arithmetic_add(result, vec[i])
    return result
    """
  tests:
    - {tags [mask, basic], type "si32", lane_count 8, case {inputs [255, [1, 2, 3, 4, 5, 6, 7, 8]], expected 36}}
    - {tags [mask, sparse], type "si32", lane_count 8, case {inputs [165, [1, 2, 3, 4, 5, 6, 7, 8]], expected 18}}
    - {tags [mask, basic], type "ui16", lane_count 8, case {inputs [173, [1, 2, 3, 4, 5, 6, 7, 8]], expected 21}}
    - {tags [mask, basic], type "f32", lane_count 4, case {inputs [13, [1.0, -2.0, 3.5, -4.5]], expected 0.0}}
  impls:
    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type(base::in), intrin<svaddv, build>(mask, vec)));"
      f?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svaddv, build>(mask, vec));"
    avx512:
      [si32, ui32, si64, ui64]:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type(base::in), intrin<mask_reduce_add, build[suffix=base::signed_of(base::in)]>(mask, vec)));"
      f?:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
