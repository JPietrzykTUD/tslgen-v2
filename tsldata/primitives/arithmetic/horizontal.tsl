            var<const_infer>(hi, intrin<_mm256_extractf128_pd>(vec, 1));
            var<infer>(temp, intrin<_mm_min_pd>(lo, hi));
            temp = intrin<_mm_min_sd>(temp, intrin<_mm_unpackhi_pd>(temp, temp));
            complete(intrin<_mm_cvtsd_f64>(temp));
          """
    sse:
      f32:
        requires [sse2]
        safety:
          internal_unsafe true
