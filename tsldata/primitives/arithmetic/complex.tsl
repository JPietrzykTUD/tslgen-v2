    sve:
      idqword:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            var<const_infer>(zero_divisors, call<primitive=equal>(
              divisor,
              call<primitive=set_zero[Vec]>()
            ));
            if (call<primitive=mask_population_count[Vec]>(zero_divisors) != 0) {
              helper<arith_zero_divisor_fail>();
            }
            complete(intrin<svdiv, build[post=x]>(
              call<primitive=mask_true[Vec]>(),
              dividend,
              divisor
            ));
          """
    rvv:
      f?:
        requires [v]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<vfdiv, build[infix="vv", infix_sep="_"]>(
                dividend,
                divisor,
                value(vector::runtime_length)
              )
            );
          """
prim<v:=(m,v,v)>[mask=zero] div(mask, dividend, divisor):
  brief_description "Divides active dividend lanes by divisor lanes and writes zero to inactive mask lanes."
  detailed_description """
    Computes lane-wise division for lanes enabled by the mask. Disabled lanes are
    set to zero and do not participate. Active integer lanes use quotient rounding
    toward zero, fail on a zero divisor, and return MIN for signed MIN divided by
    -1. Active floating lanes preserve IEEE 754 returned-value behavior.
    """
  arithmetic:
    operations [division]
    operand_roles:
      primary dividend
      divisor divisor
    guarantees [
      integer_quotient_toward_zero,
      integer_zero_divisor_fails,
      signed_min_div_neg_one_returns_min,
      floating_division_ieee754_values,
      inactive_lanes_do_not_participate
    ]
  semantics """
    input: mask mask, register dividend, register divisor
    for each lane i:
      if mask[i] is active:
        if lane type is integer and divisor[i] == 0:
          fail without returning a value
        else if lane type is signed integer and dividend[i] == MIN and divisor[i] == -1:
          result[i] = MIN
        else:
          result[i] = dividend[i] / divisor[i]
      else:
        result[i] = 0
    return result
    """
  tests:
    - {role "runtime_failure", tags [maskz, failure, active_zero], type "si32", case {inputs [10, [8, -9, 10, -12], [2, 0, -2, 4]], failure "integer_zero_divisor"}}
    - {tags [maskz, basic], type "f32", case {inputs [10, [8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [0.0, -3.0, 0.0, -3.0]}}
    - {tags [maskz, zero], type "f32", case {inputs [0, [8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [0.0, 0.0, 0.0, 0.0]}}
    - {tags [maskz, inactive_zero, rvv], extension "rvv", type "f32", case {inputs [10, [1.0, 8.0, -1.0, -12.0], [0.0, 2.0, 0.0, 4.0]], expected [0.0, 4.0, 0.0, -3.0]}}
    - {tags [maskz, basic], extension "generic", type "si32", case {inputs [10, [8, -9, 10, -12], [2, 3, -2, 4]], expected [0, -3, 0, -3]}}
    - {tags [maskz, inactive_zero], type "si32", case {inputs [10, [-2147483648, -2147483648, 7, -7], [0, -1, 0, 3]], expected [0, -2147483648, 0, -2]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            if (mask) {
              complete(call<primitive=div>(dividend, divisor));
            }
            complete(call<primitive=set_zero[Vec]>());
          """
    [generic, clang_v128, oneapi_fpga, wasm128]:
      arith:
        requires:
          generic []
          clang_v128 []
          oneapi_fpga []
          wasm128 [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(safe_dividend, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set_zero[Vec]>(),
              dividend
            ));
            var<const_infer>(safe_divisor, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set1[Vec]>(cast<static>(base::in, 1)),
              divisor
            ));
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=div>(safe_dividend, safe_divisor)
              )
            );
          """
    [avx512, avx2_vl, sse_vl]:
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<maskz_div, build>(mask, dividend, divisor));"
    [avx2, sse]:
      f?:
        requires:
          avx2:
            f? [avx]
          sse:
            f32 [sse]
            f64 [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(safe_dividend, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set_zero[Vec]>(),
              dividend
            ));
            var<const_infer>(safe_divisor, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set1[Vec]>(cast<static>(base::in, 1)),
              divisor
            ));
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=div>(safe_dividend, safe_divisor)
              )
            );
          """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(safe_dividend, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set_zero[Vec]>(),
              dividend
            ));
            var<const_infer>(safe_divisor, call<primitive=mov, attrs[mask=pass_through]>(
              mask,
              call<primitive=set1[Vec]>(cast<static>(base::in, 1)),
              divisor
