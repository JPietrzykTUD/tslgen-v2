          avx2_vl [avx2, avx512bw, avx512f, avx512vl]
          sse_vl  [sse2, avx512bw, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<maskz_mullo, build[suffix=base::signed_of(base::in)]>(mask, factor1, factor2)
            );
          """
      ?i32:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse4_1, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<maskz_mullo, build[suffix=base::signed_of(base::in)]>(mask, factor1, factor2)
            );
          """
      ?i64:
        requires:
          avx512  [avx512dq, avx512f]
          avx2_vl [avx, avx512dq, avx512vl]
          sse_vl  [sse, avx512dq, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<maskz_mullo, build[suffix=base::signed_of(base::in)]>(mask, factor1, factor2)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<maskz_mul, build>(mask, factor1, factor2));"
      arith:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=mul>(factor1, factor2)
              )
            );
          """
    [avx2, sse, neon]:
      arith:
        requires:
          avx2 [avx]
          sse [sse]
          neon [neon]
        safety:
          internal_unsafe false
