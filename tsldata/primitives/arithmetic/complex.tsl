    - {tags [neg], type "si32", case {inputs [[1, -2, 3, -4, 5, -6, 7, -8], -2], expected [-2, 4, -6, 8, -10, 12, -14, 16]}}
    - {tags [basic], type "ui16", case {inputs [[1, 2, 3, 4, 5, 6, 7, 8], 5], expected [5, 10, 15, 20, 25, 30, 35, 40]}}
    - {tags [zero], type "ui16", case {inputs [[0, 1, 2, 3, 4, 5, 6, 7], 0], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(helper<arith_mul>(data, cast<static>(type(base::in), factor)));"
    clang_v128:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(op<mul>(data, cast<static>(type(base::in), factor)));"
    [generic, oneapi_fpga]:
      arith:
        requires:
          generic []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = helper<arith_mul>(data[i], cast<static>(type(base::in), factor));
            }
            complete(result);
          """
    avx512:
      f?:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
