            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_dividend, call<primitive=extract_value[Vec, i]>(dividend));
              var<const_infer>(lane_divisor, call<primitive=extract_value[Vec, i]>(divisor));
              var<const_infer>(quotient, call<primitive=@self[ScalarVec]>(lane_dividend, lane_divisor));
              result = call<primitive=insert_value[Vec, i]>(result, quotient);
            }
            complete(result);
          """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_dividend, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(dividend)
              ));
              var<const_infer>(generic_divisor, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(divisor)
              ));
              var<const_infer>(generic_result, call<primitive=@self[GenericVec]>(
                generic_dividend,
                generic_divisor
