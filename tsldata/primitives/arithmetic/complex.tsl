prim<v:=(v,sImm)> mul_imm(data, factor):
  brief_description "Multiplies each vector lane by the compile-time scalar factor."
  detailed_description """
    Multiplies every lane of a vector register by the compile-time scalar
    immediate `factor`. The result is represented in the destination lane type;
    truncation, overflow, and floating-point behavior follow the selected
    backend and lane type.
    """
  semantics """
    input: register data, scalar factor
    for each lane i:
      result[i] = data[i] * factor
    return result
    """
  tests:
    - {tags [basic], type "si32", case {inputs [[1, 2, 3, 4, 5, 6, 7, 8], 3], expected [3, 6, 9, 12, 15, 18, 21, 24]}}
    - {tags [zero], type "si32", case {inputs [[-1, 0, 1, -2, 2, -3, 3, -4], 0], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
    - {tags [neg], type "si32", case {inputs [[1, -2, 3, -4, 5, -6, 7, -8], -2], expected [-2, 4, -6, 8, -10, 12, -14, 16]}}
    - {tags [basic], type "ui16", case {inputs [[1, 2, 3, 4, 5, 6, 7, 8], 5], expected [5, 10, 15, 20, 25, 30, 35, 40]}}
    - {tags [zero], type "ui16", case {inputs [[0, 1, 2, 3, 4, 5, 6, 7], 0], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
  impls:
    [scalar, generic, clang_v128, oneapi_fpga, avx512, avx2, sse, neon, wasm128, sve]:
      arith:
        requires:
          scalar []
          generic []
          clang_v128 []
          oneapi_fpga []
          avx512 [avx512f]
          avx2 [avx]
          sse [sse]
          neon [neon]
          wasm128 [simd128]
          sve [sve]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mul>(
                data,
                call<primitive=set1>(cast<static>(base::in, factor))
              )
            );
          """
