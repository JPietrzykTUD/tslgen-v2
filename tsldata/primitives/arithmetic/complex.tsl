            );
          """
      ?i64:
        requires:
          avx512  [avx512dq, avx512f]
          avx2_vl [avx, avx512dq, avx512vl]
          sse_vl  [sse, avx512dq, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mask_mullo, build[suffix=base::signed_of(base::in)]>(factor1, mask, factor1, factor2)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<mask_mul, build>(factor1, mask, factor1, factor2));"
      arith:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
