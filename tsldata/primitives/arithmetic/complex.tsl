      arith:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(GenericVec, type(vector::as_extension(generic)));
            var<const_infer>(generic_divident, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(divident)));
            var<const_infer>(generic_divisor, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(divisor)));
            complete(
              call<primitive=from_array[Vec]>(
                call<primitive=@self[GenericVec]>(generic_divident, generic_divisor)
              )
            );
          """
    sve:
      idqword:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svdiv, build[post=x]>(call<primitive=mask_true[Vec]>(), divident, divisor));"
prim<v:=(m,v,v)>[mask=zero] div(mask, divident, divisor):
  brief_description "[Example: avx512 + f32]: Divide packed elements in \"a\" by packed elements in \"b\", and store the results in \"dst\" using zeromask \"k\" (elements are zeroed when the corresponding mask bit is not set)."
  detailed_description """
    Computes lane-wise division for lanes enabled by the mask. Disabled lanes are
    set to zero. Rounding, exceptional floating-point values, integer quotient
    behavior, and division-by-zero behavior follow the selected backend and lane
    type.
    """
  semantics """
    input: mask mask, register divident, register divisor
    for each lane i:
      if mask[i] is active:
        result[i] = divident[i] / divisor[i]
      else:
        result[i] = 0
    return result
    """
  operation "[Example: avx512 + f32]: FOR j := 0 to 15\n\ti := 32*j\n\tIF k[j]\n\t\tdst[i+31:i] := a[i+31:i] / b[i+31:i]\n\tELSE\n\t\tdst[i+31:i] := 0\n\tFI\nENDFOR\ndst[MAX:512] := 0"
  tests:
    - {tags [maskz, basic], type "f32", case {inputs [10, [8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [0.0, -3.0, 0.0, -3.0]}}
    - {tags [maskz, zero], type "f32", case {inputs [0, [8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [0.0, 0.0, 0.0, 0.0]}}
    - {tags [maskz, basic], extension "generic", type "si32", case {inputs [10, [8, -9, 10, -12], [2, 3, -2, 4]], expected [0, -3, 0, -3]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            if (mask) {
              complete(call<primitive=div>(divident, divisor));
            }
            complete(call<primitive=set_zero[Vec]>());
          """
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=div>(divident, divisor)
              )
            );
          """
    [avx512, avx2_vl, sse_vl]:
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<maskz_div, build>(mask, divident, divisor));"
    [avx2, sse]:
      f?:
        requires:
          avx2:
            f? [avx]
          sse:
            f32 [sse]
            f64 [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=div>(divident, divisor)
              )
            );
          """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=div>(divident, divisor)
              )
            );
          """
    sve:
      idqword:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svdiv, build[post=z]>(mask, divident, divisor));"
