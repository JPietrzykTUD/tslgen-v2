prim<v:=(v,v)> div(dividend, divisor):
  brief_description "Divides each dividend lane by the corresponding divisor lane."
  detailed_description """
    Computes lane-wise division of two vector registers. Each output lane depends
    only on the corresponding lanes of the input registers. Integer quotients
    round toward zero, an integer zero divisor fails before division, and signed
    MIN divided by -1 returns MIN. Floating lanes preserve IEEE 754 returned-value
    behavior.
    """
  arithmetic:
    operations [division]
    operand_roles:
      primary dividend
      divisor divisor
    guarantees [
      integer_quotient_toward_zero,
      integer_zero_divisor_fails,
      signed_min_div_neg_one_returns_min,
      floating_division_ieee754_values
    ]
  semantics """
    input: register dividend, register divisor
    for each lane i:
      if lane type is integer and divisor[i] == 0:
        fail without returning a value
      else if lane type is signed integer and dividend[i] == MIN and divisor[i] == -1:
        result[i] = MIN
      else:
        result[i] = dividend[i] / divisor[i]
    return result
    """
  benchmarks:
    latency_chain dividend
    operand_domains:
      divisor nonzero
  tests:
    - {role "runtime_failure", tags [failure, zero_divisor], type "si32", case {inputs [[8, -9, 10, -12], [2, 0, -2, 4]], failure "integer_zero_divisor"}}
    - {tags [basic], type "f32", case {inputs [[8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [4.0, -3.0, -5.0, -3.0]}}
    - {tags [edge, signed_zero, zero_divisor], type "f32", case {inputs [[0.0, -0.0, 1.0, -1.0], [1.0, 1.0, 0.0, 0.0]], expected [0.0, -0.0, INFINITY, "-INFINITY"]}}
    - {tags [edge, nan, infinity], type "f32", case {inputs [[0.0, INFINITY, NAN, 1.0], [0.0, INFINITY, 1.0, NAN]], expected [NAN, NAN, NAN, NAN]}}
    - {tags [one], type "f32", case {inputs [[1.0, -2.0, 3.0, -4.0], [1.0, -2.0, 3.0, -4.0]], expected [1.0, 1.0, 1.0, 1.0]}}
    - {tags [basic], type "f64", case {inputs [[8.0, -9.0], [2.0, 3.0]], expected [4.0, -3.0]}}
    - {tags [basic], type "si8", case {inputs [[8, -9, 10, -12, 15, -16, 21, -24, 25, -27, 30, -32, 35, -36, 40, -42], [2, 3, -2, 4, 5, -4, 7, -6, 5, 9, -5, 8, 7, -9, 10, -7]], expected [4, -3, -5, -3, 3, 4, 3, 4, 5, -3, -6, -4, 5, 4, 4, 6]}}
    - {tags [basic], type "ui8", case {inputs [[8, 9, 10, 12, 15, 16, 21, 24, 25, 27, 30, 32, 35, 36, 40, 42], [2, 3, 2, 4, 5, 4, 7, 6, 5, 9, 5, 8, 7, 9, 10, 7]], expected [4, 3, 5, 3, 3, 4, 3, 4, 5, 3, 6, 4, 5, 4, 4, 6]}}
    - {tags [basic], type "si16", case {inputs [[8, -9, 10, -12, 15, -16, 21, -24], [2, 3, -2, 4, 5, -4, 7, -6]], expected [4, -3, -5, -3, 3, 4, 3, 4]}}
    - {tags [basic], type "ui16", case {inputs [[8, 9, 10, 12, 15, 16, 21, 24], [2, 3, 2, 4, 5, 4, 7, 6]], expected [4, 3, 5, 3, 3, 4, 3, 4]}}
    - {tags [basic], type "si32", case {inputs [[8, -9, 10, -12], [2, 3, -2, 4]], expected [4, -3, -5, -3]}}
    - {tags [edge, overflow, signs], type "si32", case {inputs [[-2147483648, -2147483648, -7, 7], [-1, 1, 3, -3]], expected [-2147483648, -2147483648, -2, -2]}}
    - {tags [basic], type "ui32", case {inputs [[8, 9, 10, 12], [2, 3, 2, 4]], expected [4, 3, 5, 3]}}
    - {tags [basic], type "si64", case {inputs [[8, -9], [2, 3]], expected [4, -3]}}
    - {tags [basic], type "ui64", case {inputs [[8, 9], [2, 3]], expected [4, 3]}}
    - {tags [basic], extension "generic", type "si32", case {inputs [[8, -9, 10, -12], [2, 3, -2, 4]], expected [4, -3, -5, -3]}}
    - {tags [basic, neon], extension "neon", type "si32", case {inputs [[8, -9, 10, -12], [2, 3, -2, 4]], expected [4, -3, -5, -3]}}
    - {tags [basic, wasm], extension "wasm128", type "ui32", case {inputs [[8, 9, 10, 12], [2, 3, 2, 4]], expected [4, 3, 5, 3]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(helper<arith_div>(dividend, divisor));"
    clang_v128:
      f?:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(dividend / divisor);"
      ?i?:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = helper<arith_div>(dividend[i], divisor[i]);
            }
            complete(result);
          """
    [generic, oneapi_fpga]:
      arith:
        requires:
          generic []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = helper<arith_div>(dividend[i], divisor[i]);
            }
            complete(result);
          """
    [avx512, avx2_vl, sse_vl, avx2, sse]:
      ?i?:
        requires:
          avx512:
            idqword [avx512f]
            bword   [avx512f, avx512bw]
          avx2_vl:
            idqword [avx2, avx512f, avx512vl]
            bword   [avx2, avx512f, avx512vl, avx512bw]
          sse_vl:
            idqword [sse2, avx512f, avx512vl]
            bword   [sse2, avx512f, avx512vl, avx512bw]
          avx2 [avx, avx2]
          sse  [sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(ScalarVec, vector::as_extension(scalar));
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_dividend, call<primitive=extract_value[Vec, i]>(dividend));
              var<const_infer>(lane_divisor, call<primitive=extract_value[Vec, i]>(divisor));
              var<const_infer>(quotient, call<primitive=@self[ScalarVec]>(
                lane_dividend,
                lane_divisor
              ));
              result = call<primitive=insert_value[Vec, i]>(result, quotient);
            }
            complete(result);
          """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_dividend, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(dividend)
              ));
              var<const_infer>(generic_divisor, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(divisor)
              ));
              complete(call<primitive=from_array[Vec]>(
                call<primitive=@self[GenericVec]>(generic_dividend, generic_divisor)
              ));
            """
    avx512:
      f?:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(dividend, divisor));"
    avx2:
      f?:
        requires [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(dividend, divisor));"
    sse:
      f32:
        requires [sse]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(dividend, divisor));"
      f64:
        requires [sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(dividend, divisor));"
    neon:
      f?:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<vdivq, build>(dividend, divisor));"
      ?i?:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(ScalarVec, vector::as_extension(scalar));
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_dividend, call<primitive=extract_value[Vec, i]>(dividend));
              var<const_infer>(lane_divisor, call<primitive=extract_value[Vec, i]>(divisor));
              var<const_infer>(quotient, call<primitive=@self[ScalarVec]>(lane_dividend, lane_divisor));
              result = call<primitive=insert_value[Vec, i]>(result, quotient);
            }
            complete(result);
          """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_dividend, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(dividend)
              ));
              var<const_infer>(generic_divisor, call<primitive=from_array[GenericVec]>(
                call<primitive=to_array[Vec]>(divisor)
              ));
              var<const_infer>(generic_result, call<primitive=@self[GenericVec]>(
                generic_dividend,
                generic_divisor
              ));
              complete(call<primitive=from_array[Vec]>(
                call<primitive=to_array[GenericVec]>(generic_result)
              ));
            """
    wasm128:
      f?:
        requires [simd128]
        safety:
