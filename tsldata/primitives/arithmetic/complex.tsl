prim<v:=(v,v)> div(divident, divisor):
  brief_description "Divides each dividend lane by the corresponding divisor lane."
  detailed_description """
    Computes lane-wise division of two vector registers. Each output lane depends
    only on the corresponding lanes of the input registers. Rounding, exceptional
    floating-point values, integer quotient behavior, and division-by-zero
    behavior follow the selected backend and lane type.
    """
  semantics """
    input: register divident, register divisor
    for each lane i:
      result[i] = divident[i] / divisor[i]
    return result
    """
  tests:
    - {tags [basic], type "f32", case {inputs [[8.0, -9.0, 10.0, -12.0], [2.0, 3.0, -2.0, 4.0]], expected [4.0, -3.0, -5.0, -3.0]}}
    - {tags [one], type "f32", case {inputs [[1.0, -2.0, 3.0, -4.0], [1.0, -2.0, 3.0, -4.0]], expected [1.0, 1.0, 1.0, 1.0]}}
    - {tags [basic], type "f64", case {inputs [[8.0, -9.0], [2.0, 3.0]], expected [4.0, -3.0]}}
    - {tags [basic], extension "generic", type "si32", case {inputs [[8, -9, 10, -12], [2, 3, -2, 4]], expected [4, -3, -5, -3]}}
    - {tags [basic, neon], extension "neon", type "si32", case {inputs [[8, -9, 10, -12], [2, 3, -2, 4]], expected [4, -3, -5, -3]}}
    - {tags [basic, wasm], extension "wasm128", type "ui32", case {inputs [[8, 9, 10, 12], [2, 3, 2, 4]], expected [4, 3, 5, 3]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(divident / divisor);"
    clang_v128:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(divident / divisor);"
    [generic, oneapi_fpga]:
      arith:
        requires:
          generic []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = call<primitive=@self[type(vector::as_extension(scalar))]>(divident[i], divisor[i]);
            }
            complete(result);
          """
    avx512:
      f?:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(divident, divisor));"
    avx2:
      f?:
        requires [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(divident, divisor));"
    sse:
      f32:
        requires [sse]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(divident, divisor));"
      f64:
        requires [sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(divident, divisor));"
    neon:
      f?:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<vdivq, build>(divident, divisor));"
      ?i?:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(ScalarVec, type(vector::as_extension(scalar)));
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_dividend, intrin<vgetq_lane, build[suffix=base::in, immediate(1)=i]>(divident, value(i)));
              var<const_infer>(lane_divisor, intrin<vgetq_lane, build[suffix=base::in, immediate(1)=i]>(divisor, value(i)));
              var<const_infer>(quotient, call<primitive=@self[ScalarVec]>(lane_dividend, lane_divisor));
              result = intrin<vsetq_lane, build[suffix=base::in, immediate(2)=i]>(
                quotient, result, value(i)
              );
            }
            complete(result);
          """
    wasm128:
      f?:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<div, build>(divident, divisor));"
      ?i?:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(ScalarVec, type(vector::as_extension(scalar)));
            let<type>(LaneBase, type(base::in));
            let<type>(SignedBase, type(base::signed_of(type(base::in))));
            var<infer>(result, call<primitive=set_zero[Vec]>());
            loop<generation, scoped>(i, 0, value(vector::length), 1) {
              var<const_infer>(lane_dividend, cast<static>(LaneBase, intrin<extract_lane, build[suffix=base::in, immediate(1)=i]>(divident, value(i))));
              var<const_infer>(lane_divisor, cast<static>(LaneBase, intrin<extract_lane, build[suffix=base::in, immediate(1)=i]>(divisor, value(i))));
              var<const_infer>(quotient, call<primitive=@self[ScalarVec]>(lane_dividend, lane_divisor));
              result = intrin<replace_lane, build[suffix=base::in, immediate(1)=i]>(
                result, value(i), cast<static>(SignedBase, quotient)
              );
            }
            complete(result);
          """
    sve:
      idqword:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svdiv, build[post=x]>(call<primitive=mask_true[Vec]>(), divident, divisor));"
prim<v:=(m,v,v)>[mask=zero] div(mask, divident, divisor):
  brief_description "Divides active dividend lanes by divisor lanes and writes zero to inactive mask lanes."
