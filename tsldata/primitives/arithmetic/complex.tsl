          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = detail::arith_mul(data[i], cast<static>(type(base::in), factor));
            }
            complete(result);
          """
    avx512:
      f?:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mul, build>(
                data,
                call<primitive=set1>(cast<static>(type(base::in), factor))
              )
            );
          """
