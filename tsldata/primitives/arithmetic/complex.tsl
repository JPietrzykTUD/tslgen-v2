prim<v:=(m,v,v)>[mask=zero] mul(mask, factor1, factor2):
  arithmetic:
    operations [multiplication]
    operand_roles:
      primary factor1
      secondary factor2
    guarantees [integer_wrapping]
  brief_description "Multiplies active lanes of two vector registers and writes zero to inactive mask lanes."
  detailed_description """
    Computes lane-wise multiplication for lanes enabled by the mask. Disabled
    lanes are set to zero. The result is represented in the destination lane
    type; truncation, overflow, and floating-point behavior follow the selected
    backend and lane type.
    """
  semantics """
    input: mask mask, register factor1, register factor2
    for each lane i:
      if mask[i] is active:
        result[i] = factor1[i] * factor2[i]
      else:
        result[i] = 0
    return result
    """
  tests:
    - {tags [maskz, basic], type "f32", case {inputs [10, [1.0, -2.0, 3.5, -4.5], [1.0, -2.0, 3.5, -4.5]], expected [0.0, 4.0, 0.0, 20.25]}}
    - {tags [maskz, basic], extension "generic", type "si32", case {inputs [10, [1, 2, 3, 4], [2, 0, -1, -2]], expected [0, 0, 0, -8]}}
    - {tags [maskz, basic, rvv], extension "rvv", type "si32", case {inputs [10, [1, 2, 3, 4], [2, 0, -1, -2]], expected [0, 0, 0, -8]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            if (mask) {
              complete(call<primitive=mul>(factor1, factor2));
            }
            complete(call<primitive=set_zero[Vec]>());
          """
    [generic, clang_v128, oneapi_fpga, wasm128]:
      arith:
        requires:
          generic []
          clang_v128 []
          oneapi_fpga []
          wasm128 [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=mul>(factor1, factor2)
              )
