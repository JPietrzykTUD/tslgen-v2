prim<v:=(m,v,v)>[mask=pass_through] mul(mask, factor1, factor2):
  brief_description "Multiplies active lanes of two vector registers and keeps the left lane where the mask is inactive."
  detailed_description """
    Computes lane-wise multiplication for lanes enabled by the mask. Disabled
    lanes keep the corresponding lane from `factor1`. The result is represented
    in the destination lane type; truncation, overflow, and floating-point
    behavior follow the selected backend and lane type.
    """
  semantics """
    input: mask mask, register factor1, register factor2
    for each lane i:
      if mask[i] is active:
        result[i] = factor1[i] * factor2[i]
      else:
        result[i] = factor1[i]
    return result
    """
  tests:
    - {tags [mask, basic], type "f32", case {inputs [10, [1.0, -2.0, 3.5, -4.5], [1.0, -2.0, 3.5, -4.5]], expected [1.0, 4.0, 3.5, 20.25]}}
    - {tags [mask, basic], extension "generic", type "si32", case {inputs [10, [1, 2, 3, 4], [2, 0, -1, -2]], expected [1, 0, 3, -8]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            if (mask) {
              complete(call<primitive=mul>(factor1, factor2));
            }
            complete(factor1);
          """
    [generic, clang_v128, oneapi_fpga, wasm128]:
      arith:
        requires:
          generic []
          clang_v128 []
          oneapi_fpga []
          wasm128 [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                factor1,
                call<primitive=mul>(factor1, factor2)
              )
            );
          """
    [avx512, avx2_vl, sse_vl]:
      ?i16:
        requires:
          avx512  [avx512bw, avx512f]
          avx2_vl [avx2, avx512bw, avx512f, avx512vl]
          sse_vl  [sse2, avx512bw, avx512f, avx512vl]
