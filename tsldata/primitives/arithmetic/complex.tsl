      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx]
          sse [sse]
          sve [sve]
          generic []
        implementation:
          tsil """
            emit_return(
              call<primitive=mov attrs[mask=pass_through]>(
                mask,
                call<primitive=set_zero[Vec]>(),
                call<primitive=mod>(dividend, divisor)
              )
            );
          """
prim<v:=(m,v,v)>[mask=pass_through] mod(mask, dividend, divisor):
  brief_description "Compute modulo and preserve dividend in inactive lanes."
  operation ""
  tests:
    - {test_name "mod_mask_i32_basic", extension "generic", type "si32", lane_set "lanes_i32", lanes 4, case {inputs [10, [10, -9, 8, -7], [3, 4, 5, 2]], expected [10, -1, 8, -1]}}
  impls:
    scalar:
      arith:
        requires []
        implementation:
          tsil """
            if (mask) {
              emit_return(call<primitive=mod>(dividend, divisor));
            }
            emit_return(dividend);
          """
    [avx512, avx2, sse, sve, generic]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx]
          sse [sse]
          sve [sve]
          generic []
        implementation:
          tsil """
            emit_return(
              call<primitive=mov attrs[mask=pass_through]>(
                mask,
                dividend,
                call<primitive=mod>(dividend, divisor)
              )
            );
          """
prim<v:=(v,sImm)> mod_imm(dividend, divisor):
  brief_description "Computes a modulo with a scalar value."
  operation ""
  tests:
    - {test_name "mod_imm_i32_basic", type "si32", lane_set "lanes_i32", lanes 8, case {inputs [[10, -9, 8, -7, 6, -5, 4, -3], 3], expected [1, 0, 2, -1, 0, -2, 1, 0]}}
    - {test_name "mod_imm_i32_one", type "si32", lane_set "lanes_i32", lanes 8, case {inputs [[10, -9, 8, -7, 6, -5, 4, -3], 1], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
    - {test_name "mod_imm_ui16_basic", type "ui16", lane_set "lanes_i16", lanes 8, case {inputs [[10, 9, 8, 7, 6, 5, 4, 3], 5], expected [0, 4, 3, 2, 1, 0, 4, 3]}}
    - {test_name "mod_imm_ui16_one", type "ui16", lane_set "lanes_i16", lanes 8, case {inputs [[10, 9, 8, 7, 6, 5, 4, 3], 1], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
  impls:
    [avx512, avx2, sse, sve]:
      arith:
        requires:
          avx512 [avx512f]
          avx2 [avx]
          sse [sse]
          sve [sve]
        implementation:
          tsil """
            emit_return(
              call<primitive=mod>(
                dividend,
                call<primitive=set1>(cast<static>(type<generation>(base::in), divisor))
              )
            );
          """
    scalar:
      arith:
        requires []
        implementation:
          tsil "emit_return(details::arith_rem(dividend, cast<static>(type<generation>(base::in), divisor)));"
    generic:
      ?i?:
        requires []
        implementation:
          tsil """
            var<init_register>(result);
            loop<unroll>(value<generation>(vector::length))
            loop<range>(i, 0, value<generation>(vector::length), 1) {
              result[i] = details::arith_rem(dividend[i], cast<static>(type<generation>(base::in), divisor));
            }
            emit_return(result);
          """
      f?:
        requires []
        implementation:
          tsil """
            var<init_register>(result);
            loop<unroll>(value<generation>(vector::length))
            loop<range>(i, 0, value<generation>(vector::length), 1) {
              result[i] = details::arith_rem(dividend[i], cast<static>(type<generation>(base::in), divisor));
            }
            emit_return(result);
          """
