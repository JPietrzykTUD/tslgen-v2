      ?i?:
        requires []
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [compiler_builtin, intrinsic]
        implementation:
          tsil "complete(intrin<__builtin_elementwise_min>(vec_a, vec_b));"
    avx512:
