            var<infer>(result, input);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              var<const_infer>(source, idx_offset(index_lanes[i], 1) % value(vector::length));
              result[i] = input[source];
            }
            complete(call<primitive=from_array[Vec]>(result));
