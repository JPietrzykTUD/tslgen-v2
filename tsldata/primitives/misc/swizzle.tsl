            let<type>(ByteBase, ui8);
            let<type>(ByteVec, vector::as_base(ByteBase));
            var<const_infer>(offsets, call<primitive=add[ByteVec]>(
              call<primitive=sequence[ByteVec]>(),
              call<primitive=set1[ByteVec]>(cast<static>(ByteBase,
                (cast<static>(scalar::size, count) % value(vector::length)) * value(type::size_bytes(base::in))
              ))
            ));
            var<const_infer>(left_offsets, call<primitive=sub[ByteVec]>(
              offsets,
              call<primitive=set1[ByteVec]>(cast<static>(ByteBase, 16))
            ));
            var<const_infer>(from_right, intrin<i8x16_swizzle, build[suffix=""]>(right, offsets));
            var<const_infer>(from_left, intrin<i8x16_swizzle, build[suffix=""]>(left, left_offsets));
            complete(intrin<v128_or, build[suffix=""]>(from_right, from_left));
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
