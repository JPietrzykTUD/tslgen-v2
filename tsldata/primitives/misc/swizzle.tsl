              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    [avx2, sse]:
      arith:
        requires:
          avx2 [avx]
          sse [sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
            var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
            var<infer>(result, right_lanes);
            var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              var<const_infer>(source, i + offset);
              if (source < value(vector::length)) { result[i] = right_lanes[source]; }
              else { result[i] = left_lanes[source - value(vector::length)]; }
            }
            complete(call<primitive=from_array[Vec]>(result));
          """
    clang_v128:
      arith:
        requires []
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [compiler_builtin, intrinsic]
        implementation:
          tsil """
            complete(intrin<__builtin_shufflevector>(
              right, left
              loop<generation>(i, 0, value(vector::length), 1) {
                , value(i) + (cast<static>(scalar::size, count) % value(vector::length))
              }
            ));
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<init_register>(result);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right[source]; }
                else { result[i] = left[source - value(vector::length)]; }
              }
              complete(result);
            """
    [generic, oneapi_fpga, oneapi_fpga_rtl]:
      arith:
        requires:
          generic []
          oneapi_fpga []
          oneapi_fpga_rtl []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              var<const_infer>(source, i + offset);
              if (source < value(vector::length)) { result[i] = right[source]; }
              else { result[i] = left[source - value(vector::length)]; }
            }
            complete(result);
          """
    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IndexBase, base::unsigned_of(base::in));
            let<type>(IndexVec, vector::as_base(IndexBase));
            var<const_infer>(lanes, value(vector::runtime_length));
            var<const_infer>(indexes, call<primitive=add[IndexVec]>(
              call<primitive=sequence[IndexVec]>(),
              call<primitive=set1[IndexVec]>(cast<static>(IndexBase,
                cast<static>(scalar::size, count) % lanes
              ))
            ));
            var<const_infer>(table, intrin<svcreate2, build[suffix=base::in]>(right, left));
            complete(intrin<svtbl2, build[suffix=base::in]>(table, indexes));
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              let<type>(Base, base::in);
              var<const_infer>(lanes, value(vector::runtime_length));
              var<runtime_array>(Base, left_lanes, lanes);
              var<runtime_array>(Base, right_lanes, lanes);
              var<runtime_array>(Base, result, lanes);
              call<primitive=store[Vec], attrs[aligned=false]>(left_lanes, left);
              call<primitive=store[Vec], attrs[aligned=false]>(right_lanes, right);
              var<const_infer>(offset, cast<static>(scalar::size, count) % lanes);
              loop<backend>(i, 0, lanes, 1) {
                var<const_infer>(source, i + offset);
                if (source < lanes) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - lanes]; }
              }
              complete(call<primitive=load[Vec], attrs[aligned=false]>(result));
            """

prim<v:=(v,sImm)> permute_lanes(data, control):
  brief_description "Permutes consecutive groups of up to four lanes using two-bit selectors."
  detailed_description """
    Each two-bit field in `control` selects a source lane within the current
    four-lane group. A final short group normalizes its selectors modulo that
    group's actual length, which makes the contract total for scalar and sized
    generic vectors while matching native four-lane groups exactly.
    """
  semantics """
    input: register data, immediate control
    split lanes into consecutive groups of at most four
    for each output position p within a group:
      selector = (control >> (2 * p)) & 3
      result[group_start + p] = data[group_start + selector modulo group_length]
    return result
    """
  cross_lane true
  params:
    control:
      type si32
      value_range "0..255"
      dispatch:
        rust literal_match
  tests:
    - {tags [basic], type "si32", case {inputs [[0, 1, 2, 3, 4, 5, 6, 7], 27], expected [3, 2, 1, 0, 7, 6, 5, 4]}}
    - {tags [repeat], type "ui64", case {inputs [[10, 20, 30, 40], 0], expected [10, 10, 10, 10]}}
    - {tags [float], type "f32", case {inputs [[1.0, 2.0, 3.0, 4.0], 78], expected [3.0, 4.0, 1.0, 2.0]}}
    - {tags [short_vector], type "f64", case {inputs [[-2.0, 3.0], 255], expected [3.0, 3.0]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(data);"
    avx2:
      [?i32, f32]:
        requires:
          ?i32 [avx, avx2]
          f32 [avx]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            if<generation>(type::is_same(base::in, f32)) {
              complete(intrin<permute, build[suffix=f32, immediate(1)=control]>(data, control));
            } else<generation> {
              complete(intrin<shuffle, build[suffix=si32, immediate(1)=control]>(data, control));
            }
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(lanes, call<primitive=to_array[Vec]>(data));
              var<infer>(result, lanes);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(group_start, (i / 4) * 4);
                var<infer>(group_length, value(vector::length) - group_start);
                if (group_length > 4) { group_length = 4; }
                var<const_infer>(selector, (cast<static>(scalar::size, control) >> (2 * (i % 4))) & 3);
                result[i] = lanes[group_start + selector % group_length];
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
      [?i64, f64]:
