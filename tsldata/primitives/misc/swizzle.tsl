description "Lane alignment and permutation operations"

prim<v:=(v,v,sImm)> align_right_lanes(left, right, count):
  brief_description "Selects a lane-aligned window from the concatenation of right and left."
  detailed_description """
    Treats `right` as the low half and `left` as the high half of a two-vector
    lane sequence. The count is reduced modulo the selected vector's lane
    count, and the result is the lane-count-sized window starting there. This
    totalized definition also covers scalar and unusually short generic vectors.
    """
  semantics """
    input: register left, register right, immediate count
    lanes = lane_count(result)
    offset = count modulo lanes
    concatenated = right followed by left
    for each lane i:
      result[i] = concatenated[i + offset]
    return result
    """
  cross_lane true
  params:
    count:
      type si32
      value_range "0..255"
      dispatch:
        rust literal_match
  tests:
    - {tags [basic], type "si32", case {inputs [[100, 101, 102, 103, 104, 105, 106, 107], [0, 1, 2, 3, 4, 5, 6, 7], 3], expected [3, 4, 5, 6, 7, 100, 101, 102]}}
    - {tags [wrapped_count], type "ui16", case {inputs [[100, 101, 102, 103, 104, 105, 106, 107], [0, 1, 2, 3, 4, 5, 6, 7], 10], expected [2, 3, 4, 5, 6, 7, 100, 101]}}
    - {tags [basic], type "f32", case {inputs [[10.0, 11.0, 12.0, 13.0], [0.0, 1.0, 2.0, 3.0], 2], expected [2.0, 3.0, 10.0, 11.0]}}
    - {tags [short_vector], type "si64", case {inputs [[9, 10], [4, 5], 37], expected [5, 9]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(right);"
    avx512:
      [?i32, ?i64]:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<alignr, build[suffix=base::signed_of(base::in)]>(left, right, count));"
        variants:
          scalar_lanes_fallback:
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
      [f32, f64]:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IBase, base::signed_of(base::in));
            let<type>(IVec, vector::as_base(IBase));
            var<const_infer>(left_bits, call<primitive=reinterpret[Vec, IVec]>(left));
            var<const_infer>(right_bits, call<primitive=reinterpret[Vec, IVec]>(right));
            var<const_infer>(aligned, intrin<alignr, build[suffix=IBase]>(
              left_bits,
              right_bits,
              count
            ));
            complete(call<primitive=reinterpret[IVec, Vec]>(
              aligned
            ));
          """
        variants:
          scalar_lanes_fallback:
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
      arith:
        requires [avx512f]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
            var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
            var<infer>(result, right_lanes);
            var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              var<const_infer>(source, i + offset);
              if (source < value(vector::length)) { result[i] = right_lanes[source]; }
              else { result[i] = left_lanes[source - value(vector::length)]; }
            }
            complete(call<primitive=from_array[Vec]>(result));
          """
    [avx2_vl, sse_vl]:
      [?i32, ?i64]:
        requires:
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<alignr, build[suffix=base::signed_of(base::in)]>(left, right, count));"
        variants:
          scalar_lanes_fallback:
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
      [f32, f64]:
        requires:
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IBase, base::signed_of(base::in));
            let<type>(IVec, vector::as_base(IBase));
            var<const_infer>(left_bits, call<primitive=reinterpret[Vec, IVec]>(left));
            var<const_infer>(right_bits, call<primitive=reinterpret[Vec, IVec]>(right));
            var<const_infer>(aligned, intrin<alignr, build[suffix=IBase]>(
              left_bits,
              right_bits,
              count
            ));
            complete(call<primitive=reinterpret[IVec, Vec]>(
              aligned
            ));
          """
        variants:
          scalar_lanes_fallback:
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    sse:
      arith:
        requires [sse, sse2, ssse3]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(ByteVec, vector::as_base(si8));
            var<const_infer>(left_bytes, call<primitive=reinterpret[Vec, ByteVec]>(left));
            var<const_infer>(right_bytes, call<primitive=reinterpret[Vec, ByteVec]>(right));
            switch<compile>((cast<static>(scalar::size, count) % value(vector::length)) * value(type::size_bytes(base::in))) {
              0 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=0]>(left_bytes, right_bytes, 0))); }
              1 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=1]>(left_bytes, right_bytes, 1))); }
              2 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=2]>(left_bytes, right_bytes, 2))); }
              3 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=3]>(left_bytes, right_bytes, 3))); }
              4 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=4]>(left_bytes, right_bytes, 4))); }
              5 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=5]>(left_bytes, right_bytes, 5))); }
              6 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=6]>(left_bytes, right_bytes, 6))); }
              7 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=7]>(left_bytes, right_bytes, 7))); }
              8 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=8]>(left_bytes, right_bytes, 8))); }
              9 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=9]>(left_bytes, right_bytes, 9))); }
              10 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=10]>(left_bytes, right_bytes, 10))); }
              11 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=11]>(left_bytes, right_bytes, 11))); }
              12 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=12]>(left_bytes, right_bytes, 12))); }
              13 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=13]>(left_bytes, right_bytes, 13))); }
              14 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=14]>(left_bytes, right_bytes, 14))); }
              _ => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<alignr, build[suffix=si8, immediate(2)=15]>(left_bytes, right_bytes, 15))); }
            }
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(ByteVec, vector::as_base(ui8));
            var<const_infer>(left_bytes, call<primitive=reinterpret[Vec, ByteVec]>(left));
            var<const_infer>(right_bytes, call<primitive=reinterpret[Vec, ByteVec]>(right));
            switch<compile>((cast<static>(scalar::size, count) % value(vector::length)) * value(type::size_bytes(base::in))) {
              0 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=0]>(right_bytes, left_bytes, 0))); }
              1 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=1]>(right_bytes, left_bytes, 1))); }
              2 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=2]>(right_bytes, left_bytes, 2))); }
              3 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=3]>(right_bytes, left_bytes, 3))); }
              4 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=4]>(right_bytes, left_bytes, 4))); }
              5 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=5]>(right_bytes, left_bytes, 5))); }
              6 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=6]>(right_bytes, left_bytes, 6))); }
              7 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=7]>(right_bytes, left_bytes, 7))); }
              8 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=8]>(right_bytes, left_bytes, 8))); }
              9 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=9]>(right_bytes, left_bytes, 9))); }
              10 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=10]>(right_bytes, left_bytes, 10))); }
              11 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=11]>(right_bytes, left_bytes, 11))); }
              12 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=12]>(right_bytes, left_bytes, 12))); }
              13 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=13]>(right_bytes, left_bytes, 13))); }
              14 => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=14]>(right_bytes, left_bytes, 14))); }
              _ => { complete(call<primitive=reinterpret[ByteVec, Vec]>(intrin<vextq, build[suffix=ui8, immediate(2)=15]>(right_bytes, left_bytes, 15))); }
            }
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<infer>(result, right_lanes);
              var<const_infer>(offset, cast<static>(scalar::size, count) % value(vector::length));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, i + offset);
                if (source < value(vector::length)) { result[i] = right_lanes[source]; }
                else { result[i] = left_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    wasm128:
      arith:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
