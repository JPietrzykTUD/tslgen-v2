prim<v:=(v,vidx,v)> table_lookup(left, indexes, right):
  brief_description "Permutes lanes from two sources using same-width integral indices."
  detailed_description """
    Interprets each index lane as unsigned and reduces it modulo twice the lane
    count. Values in the low half select `left`; values in the high half select
    `right`. This is equivalent to indexing the concatenation of left followed
    by right.
    """
  semantics """
    input: register left, integral index register indexes, register right
    lanes = lane_count(result)
    for each lane i:
      source = unsigned(indexes[i]) modulo (2 * lanes)
      if source < lanes: result[i] = left[source]
      else: result[i] = right[source - lanes]
    return result
    """
  cross_lane true
  generic_params:
    IndicesType:
      kind simd_type
      specialize_base true
      constraints:
        base_types [?i?]
        width(self::base) == width(base::in)
  tests:
    - {tags [basic], type "si32", index_type "ui32", case {inputs [[10, 20, 30, 40, 50, 60, 70, 80], [0, 9, 2, 11, 4, 13, 6, 15], [100, 200, 300, 400, 500, 600, 700, 800]], expected [10, 200, 30, 400, 50, 600, 70, 800]}}
    - {tags [wrapped], type "ui64", index_type "si64", case {inputs [[10, 20, 30, 40], [-1, 8, 5, 14], [100, 200, 300, 400]], expected [400, 10, 200, 300]}}
    - {tags [float_data], type "f32", index_type "ui32", case {inputs [[1.0, 2.0, 3.0, 4.0], [7, 2, 5, 0], [10.0, 20.0, 30.0, 40.0]], expected [40.0, 3.0, 20.0, 1.0]}}
    - {tags [short_vector], type "f64", index_type "si64", case {inputs [[-2.0, -3.0], [-1, 4], [9.0, 10.0]], expected [10.0, -2.0]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
            if ((idx_offset(index_lanes[0], 1) % 2) == 0) {
              complete(left);
            }
            complete(right);
          """
    avx512:
      arith:
        requires:
          ?i8 [avx512f, avx512vbmi]
          ?i16 [avx512f, avx512bw]
          ?i32 [avx512f]
          ?i64 [avx512f]
          f32 [avx512f]
          f64 [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            if<generation>(type::is_same(base::in, f32) || type::is_same(base::in, f64)) {
              complete(intrin<permutex2var, build[suffix=base::in]>(left, indexes, right));
            } else<generation> {
              complete(intrin<permutex2var, build[suffix=base::signed_of(base::in)]>(left, indexes, right));
            }
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
              var<infer>(result, left_lanes);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, idx_offset(index_lanes[i], 1) % (2 * value(vector::length)));
                if (source < value(vector::length)) { result[i] = left_lanes[source]; }
                else { result[i] = right_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    avx512:
      arith:
        requires [avx512f]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
            var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
            var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
            var<infer>(result, left_lanes);
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              var<const_infer>(source, idx_offset(index_lanes[i], 1) % (2 * value(vector::length)));
              if (source < value(vector::length)) { result[i] = left_lanes[source]; }
              else { result[i] = right_lanes[source - value(vector::length)]; }
            }
            complete(call<primitive=from_array[Vec]>(result));
          """
    [avx2_vl, sse_vl]:
      arith:
        requires:
          ?i8 [sse, sse2, avx, avx512f, avx512vl, avx512vbmi]
          ?i16 [sse, sse2, avx, avx512f, avx512vl, avx512bw]
          ?i32 [sse, sse2, avx, avx512f, avx512vl]
          ?i64 [sse, sse2, avx, avx512f, avx512vl]
          f32 [sse, sse2, avx, avx512f, avx512vl]
          f64 [sse, sse2, avx, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            if<generation>(type::is_same(base::in, f32) || type::is_same(base::in, f64)) {
              complete(intrin<permutex2var, build[suffix=base::in]>(left, indexes, right));
            } else<generation> {
              complete(intrin<permutex2var, build[suffix=base::signed_of(base::in)]>(left, indexes, right));
            }
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
              var<infer>(result, left_lanes);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, idx_offset(index_lanes[i], 1) % (2 * value(vector::length)));
                if (source < value(vector::length)) { result[i] = left_lanes[source]; }
                else { result[i] = right_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    neon:
      ?i8:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IndexVec, vector::as_base(ui8));
            var<const_infer>(normalized, call<primitive=binary_and[IndexVec]>(
              call<primitive=reinterpret[IndicesType, IndexVec]>(indexes),
              call<primitive=set1[IndexVec]>(31)
            ));
            var<const_infer>(from_left, intrin<vqtbl1q, build[suffix=base::in]>(left, normalized));
            var<const_infer>(right_indexes, call<primitive=sub[IndexVec]>(
              normalized,
              call<primitive=set1[IndexVec]>(16)
            ));
            var<const_infer>(from_right, intrin<vqtbl1q, build[suffix=base::in]>(right, right_indexes));
            complete(call<primitive=binary_or[Vec]>(from_left, from_right));
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
              var<infer>(result, left_lanes);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, idx_offset(index_lanes[i], 1) % (2 * value(vector::length)));
                if (source < value(vector::length)) { result[i] = left_lanes[source]; }
                else { result[i] = right_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    wasm128:
      ?i8:
        requires [simd128]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IndexVec, vector::as_base(ui8));
            var<const_infer>(normalized, call<primitive=binary_and[IndexVec]>(
              call<primitive=reinterpret[IndicesType, IndexVec]>(indexes),
              call<primitive=set1[IndexVec]>(31)
            ));
            var<const_infer>(from_left, intrin<i8x16_swizzle>(left, normalized));
            var<const_infer>(right_indexes, call<primitive=sub[IndexVec]>(
              normalized,
              call<primitive=set1[IndexVec]>(16)
            ));
            var<const_infer>(from_right, intrin<i8x16_swizzle>(right, right_indexes));
            complete(intrin<v128_or>(from_left, from_right));
          """
        variants:
          scalar_lanes_fallback:
            safety:
              internal_unsafe false
              reasons []
            tsil """
              var<const_infer>(left_lanes, call<primitive=to_array[Vec]>(left));
              var<const_infer>(right_lanes, call<primitive=to_array[Vec]>(right));
              var<const_infer>(index_lanes, call<primitive=to_array[IndicesType]>(indexes));
              var<infer>(result, left_lanes);
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                var<const_infer>(source, idx_offset(index_lanes[i], 1) % (2 * value(vector::length)));
                if (source < value(vector::length)) { result[i] = left_lanes[source]; }
                else { result[i] = right_lanes[source - value(vector::length)]; }
              }
              complete(call<primitive=from_array[Vec]>(result));
            """
    [sve128, sve256, sve512]:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(IndexBase, base::unsigned_of(base::generic(IndicesType)));
            let<type>(IndexVec, vector::as_base(IndexBase));
            var<const_infer>(normalized, call<primitive=binary_and[IndexVec]>(
              call<primitive=reinterpret[IndicesType, IndexVec]>(indexes),
              call<primitive=set1[IndexVec]>(cast<static>(IndexBase, 2 * value(vector::length) - 1))
            ));
            var<const_infer>(table, intrin<svcreate2, build[suffix=base::in]>(left, right));
