prim<im:=(im,im)> test_imask(mask, position):
  brief_description "Tests whether a specific mask bit is set."
  operation ""
  tests:
    - {tags [basic], extension "avx512", type "ui8", lane_count 64, case {inputs [170, 1], expected 1}}
    - {tags [edge], extension "avx512", type "ui8", lane_count 64, case {inputs [170, 0], expected 0}}
    - {tags [basic], extension "avx512", type "ui16", lane_count 32, case {inputs [43690, 1], expected 1}}
    - {tags [edge], extension "avx512", type "ui16", lane_count 32, case {inputs [43690, 0], expected 0}}
    - {tags [basic], extension "avx512", type "ui32", lane_count 16, case {inputs [43690, 1], expected 1}}
    - {tags [edge], extension "avx512", type "ui32", lane_count 16, case {inputs [43690, 0], expected 0}}
    - {tags [basic], extension "avx512", type "ui64", lane_count 8, case {inputs [170, 1], expected 1}}
    - {tags [edge], extension "avx512", type "ui64", lane_count 8, case {inputs [170, 0], expected 0}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, scalar, generic, oneAPIfpga]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(cast<static>(type<generation>(vector::imask), (mask >> position) & cast<static>(type<generation>(vector::imask), 1)));"
prim<im:=(im,im,im)> insert_imask(mask_a, mask_b, position):
  brief_description "Merges two masks at a runtime position."
  operation ""
  tests:
    - {tags [basic], extension "avx512", type "ui8", lane_count 64, case {inputs [15, 3, 4], expected 63}}
    - {tags [edge], extension "avx512", type "ui8", lane_count 64, case {inputs [240, 15, 0], expected 255}}
    - {tags [basic], extension "avx512", type "ui16", lane_count 32, case {inputs [15, 3, 4], expected 63}}
    - {tags [edge], extension "avx512", type "ui16", lane_count 32, case {inputs [240, 15, 0], expected 255}}
    - {tags [basic], extension "avx512", type "ui32", lane_count 16, case {inputs [15, 3, 4], expected 63}}
    - {tags [edge], extension "avx512", type "ui32", lane_count 16, case {inputs [240, 15, 0], expected 255}}
    - {tags [basic], extension "avx512", type "ui64", lane_count 8, case {inputs [15, 3, 4], expected 63}}
    - {tags [edge], extension "avx512", type "ui64", lane_count 8, case {inputs [240, 15, 0], expected 255}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, scalar, generic, oneAPIfpga]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a | (mask_b << position));"
prim<im:=(im,im)> extract_imask(mask, position):
  brief_description "Extracts a sub-mask by shifting at a runtime position."
  operation ""
  tests:
    - {tags [basic], extension "avx512", type "ui8", lane_count 64, case {inputs [176, 4], expected 11}}
    - {tags [edge], extension "avx512", type "ui8", lane_count 64, case {inputs [176, 0], expected 176}}
    - {tags [basic], extension "avx512", type "ui16", lane_count 32, case {inputs [176, 4], expected 11}}
    - {tags [edge], extension "avx512", type "ui16", lane_count 32, case {inputs [176, 0], expected 176}}
    - {tags [basic], extension "avx512", type "ui32", lane_count 16, case {inputs [176, 4], expected 11}}
    - {tags [edge], extension "avx512", type "ui32", lane_count 16, case {inputs [176, 0], expected 176}}
    - {tags [basic], extension "avx512", type "ui64", lane_count 8, case {inputs [176, 4], expected 11}}
    - {tags [edge], extension "avx512", type "ui64", lane_count 8, case {inputs [176, 0], expected 176}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, scalar, generic, oneAPIfpga]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask >> position);"
