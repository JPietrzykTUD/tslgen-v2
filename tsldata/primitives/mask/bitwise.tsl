          tsil "complete(cast<static>(scalar::size, intrin<svcntp_b16>(call<primitive=mask_true[Vec]>(), mask)));"
      ?i32:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
