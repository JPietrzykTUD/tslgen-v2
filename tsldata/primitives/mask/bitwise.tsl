prim<m:=(m,m)> mask_binary_and(mask_a, mask_b):
  brief_description "Bitwise AND on masks."
  operation ""
  tests:
    - {tags [mask, and, basic], extension "avx512", type "ui8", lane_count 64, case {inputs [170, 204], expected 136}}
    - {tags [mask, and, basic], extension "avx512", type "ui16", lane_count 32, case {inputs [43690, 52428], expected 34952}}
    - {tags [mask, and, basic], extension "avx512", type "ui32", lane_count 16, case {inputs [43690, 52428], expected 34952}}
    - {tags [mask, and, basic], extension "avx512", type "ui64", lane_count 8, case {inputs [170, 204], expected 136}}
    - {tags [mask, and, basic], extension "sve", type "ui32", lane_count 16, case {inputs [43690, 52428], expected 34952}}
  impls:
    [avx512, sve]:
      arith:
        requires:
          avx512 [avx512f]
          sve [sve]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    avx2_vl:
      arith:
        requires [avx2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    sse_vl:
      arith:
        requires [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    avx2:
      arith:
        requires {si8 [avx, avx2], ui8 [avx, avx2], si16 [avx, avx2], ui16 [avx, avx2], si32 [avx, avx2], ui32 [avx, avx2], si64 [avx, avx2], ui64 [avx, avx2], f32 [avx], f64 [avx]}
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_and[Vec]>(mask_a, mask_b));"
    sse:
      arith:
        requires {si8 [sse, sse2], ui8 [sse, sse2], si16 [sse, sse2], ui16 [sse, sse2], si32 [sse, sse2], ui32 [sse, sse2], si64 [sse, sse2], ui64 [sse, sse2], f32 [sse], f64 [sse, sse2]}
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_and[Vec]>(mask_a, mask_b));"
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_and[Vec]>(mask_a, mask_b));"
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(MaskT, type<generation>(vector::mask));
              var<typed>(MaskT, result, mask<zero>());
              loop<backend, unroll>(i, 0, value<generation>(vector::length), 1) {
                if (mask<test>(mask_a, i) && mask<test>(mask_b, i)) {
                  mask<set>(result, i, true);
                }
              }
              complete(result);
            """
