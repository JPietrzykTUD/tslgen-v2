        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(scalar::size, intrin<svcntp_b32>(call<primitive=mask_true[Vec]>(), mask)));"
      f64:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(scalar::size, intrin<svcntp_b64>(call<primitive=mask_true[Vec]>(), mask)));"
    generic:
      arith:
        requires []
