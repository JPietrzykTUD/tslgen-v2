prim<m:=(m,m)> mask_binary_or(mask_a, mask_b):
  operation mask_or
  operand_roles:
    primary mask_a
    secondary mask_b
  brief_description "Computes the bitwise OR of two masks."
  detailed_description """
    Computes the lane-wise disjunction of two mask values. A lane is active in
    the result when it is active in either input mask.
