prim<m:=m> mask_binary_not(mask):
  operation mask_not
  operand_roles:
    primary mask
  brief_description "Computes the bitwise inversion of a mask."
  detailed_description """
    Inverts the active state of each lane in a mask value.
    """
  semantics """
    input: mask mask
    for each lane i:
      result[i] = not mask[i]
    return result
