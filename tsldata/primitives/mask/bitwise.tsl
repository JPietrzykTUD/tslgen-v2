    [clang_v128, avx512]:
      arith:
        requires:
          clang_v128 []
          avx512 [avx512f]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svand_b_z>(call<primitive=mask_true[Vec]>(), mask_a, mask_b));"
    avx2_vl:
      arith:
        requires [avx2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask_a & mask_b);"
    sse_vl:
