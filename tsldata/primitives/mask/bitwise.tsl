prim<m:=m> mask_binary_not(mask):
  brief_description "Bitwise NOT on masks."
  operation ""
  tests:
    - {tags [mask, not, basic], extension "avx512", type "ui8", lane_count 64, case {inputs [170], expected 18446744073709551445}}
    - {tags [mask, not, basic], extension "avx512", type "ui16", lane_count 32, case {inputs [43690], expected 4294923605}}
    - {tags [mask, not, basic], extension "avx512", type "ui32", lane_count 16, case {inputs [43690], expected 21845}}
    - {tags [mask, not, basic], extension "avx512", type "ui64", lane_count 8, case {inputs [170], expected 85}}
    - {tags [mask, not, edge], extension "avx512", type "ui8", lane_count 64, case {inputs [0], expected 18446744073709551615}}
    - {tags [mask, not, edge], extension "avx512", type "ui16", lane_count 32, case {inputs [0], expected 4294967295}}
    - {tags [mask, not, edge], extension "avx512", type "ui32", lane_count 16, case {inputs [0], expected 65535}}
    - {tags [mask, not, edge], extension "avx512", type "ui64", lane_count 8, case {inputs [0], expected 255}}
  impls:
    [avx512, sve]:
      arith:
        requires:
          avx512 [avx512f]
          sve [sve]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(op<bit_negate>(mask));"
    avx2_vl:
      arith:
        requires [avx2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(op<bit_negate>(mask));"
    sse_vl:
      arith:
        requires [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(op<bit_negate>(mask));"
    avx2:
      arith:
        requires [avx, avx2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_xor[Vec]>(mask, call<primitive=mask_true[Vec]>()));"
    sse:
      arith:
        requires {si8 [sse, sse2], ui8 [sse, sse2], si16 [sse, sse2], ui16 [sse, sse2], si32 [sse, sse2], ui32 [sse, sse2], si64 [sse, sse2, sse4_1], ui64 [sse, sse2, sse4_1], f32 [sse, sse2], f64 [sse, sse2, sse4_1]}
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_xor[Vec]>(mask, call<primitive=mask_true[Vec]>()));"
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=binary_xor[Vec]>(mask, call<primitive=mask_true[Vec]>()));"
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(!mask);"
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(MaskT, type<generation>(vector::mask));
              var<typed>(MaskT, result, mask<zero>());
              loop<backend, unroll>(i, 0, value<generation>(vector::length), 1) {
                if (!mask<test>(mask, i)) {
                  mask<set>(result, i, true);
                }
              }
              complete(result);
            """
prim<usize:=m> mask_population_count(mask):
  brief_description "Counts bits set in a mask scalar."
  operation ""
  tests:
    - {tags [mask, popcnt, basic], extension "avx512", type "ui8", expected_rule "popcnt", lane_count 64, case {inputs [12297829382473034410], expected 32}}
    - {tags [mask, popcnt, edge], extension "avx512", type "ui8", expected_rule "popcnt", lane_count 64, case {inputs [18446744073709551615], expected 64}}
    - {tags [mask, popcnt, zero], extension "avx512", type "ui8", expected_rule "popcnt", lane_count 64, case {inputs [0], expected 0}}
    - {tags [mask, popcnt, basic], extension "avx512", type "ui16", expected_rule "popcnt", lane_count 32, case {inputs [2863311530], expected 16}}
    - {tags [mask, popcnt, edge], extension "avx512", type "ui16", expected_rule "popcnt", lane_count 32, case {inputs [4294967295], expected 32}}
    - {tags [mask, popcnt, zero], extension "avx512", type "ui16", expected_rule "popcnt", lane_count 32, case {inputs [0], expected 0}}
    - {tags [mask, popcnt, basic], extension "avx512", type "ui32", expected_rule "popcnt", lane_count 16, case {inputs [43690], expected 8}}
    - {tags [mask, popcnt, edge], extension "avx512", type "ui32", expected_rule "popcnt", lane_count 16, case {inputs [65535], expected 16}}
    - {tags [mask, popcnt, zero], extension "avx512", type "ui32", expected_rule "popcnt", lane_count 16, case {inputs [0], expected 0}}
    - {tags [mask, popcnt, basic], extension "avx512", type "ui64", expected_rule "popcnt", lane_count 8, case {inputs [170], expected 4}}
    - {tags [mask, popcnt, edge], extension "avx512", type "ui64", expected_rule "popcnt", lane_count 8, case {inputs [255], expected 8}}
    - {tags [mask, popcnt, zero], extension "avx512", type "ui64", expected_rule "popcnt", lane_count 8, case {inputs [0], expected 0}}
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, scalar]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx2]
          sse [sse2]
          neon [neon]
          scalar []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<const_infer>(imask, call<primitive=to_integral[Vec]>(mask));
            complete(
              cast<static>(
                type<backend>(scalar::size),
                details::popcount(imask)
              )
            );
          """
    sve:
      ?i8:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b8>(call<primitive=mask_true[Vec]>(), mask)));"
      ?i16:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b16>(call<primitive=mask_true[Vec]>(), mask)));"
      ?i32:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b32>(call<primitive=mask_true[Vec]>(), mask)));"
      ?i64:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b64>(call<primitive=mask_true[Vec]>(), mask)));"
      f32:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b32>(call<primitive=mask_true[Vec]>(), mask)));"
      f64:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(cast<static>(type<backend>(scalar::size), intrin<svcntp_b64>(call<primitive=mask_true[Vec]>(), mask)));"
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(CountT, type<backend>(scalar::size));
              var<typed>(CountT, count, cast<static>(CountT, 0));
              loop<backend, unroll>(i, 0, value<generation>(vector::length), 1) {
                if (mask<test>(mask, i)) {
                  count = count + cast<static>(CountT, 1);
                }
              }
              complete(count);
            """
prim<im:=(im,s)> shift_right_imask(data, shift):
  brief_description "Arithmetic shift of an imask to the right by n bits."
  operation ""
  tests:
    - {tags [basic], type "ui32", lane_count 16, case {inputs [240, 4], expected 15}}
    - {tags [zero], type "ui32", lane_count 16, case {inputs [0, 4], expected 0}}
  generic_params:
    PreserveSign:
      kind bool
      default true
  impls:
    [avx512, avx2_vl, sse_vl, avx2, sse, neon, scalar, generic, oneAPIfpga]:
      ?i?:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx]
          sse [sse]
          neon [neon]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
          if<compile>(( value<generation>(type::is_signed(type<generation>(vector::imask))) ) && (!PreserveSign)) {
             complete(cast<static>(type<generation>(vector::imask), cast<static>(type<generation>(base::unsigned_of(type<generation>(vector::imask))), data) >> shift));
          } else {
             complete(data >> shift) ;
          }
            """
      f?:
        requires:
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx]
          sse [sse]
          neon [neon]
          scalar []
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
           complete(data >> cast<static>(type<generation>(vector::imask), shift)) ;
            """
