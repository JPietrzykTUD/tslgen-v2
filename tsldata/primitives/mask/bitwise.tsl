prim<m:=(m,m)> mask_binary_xor(mask_a, mask_b):
  operation mask_xor
  operand_roles:
    primary mask_a
    secondary mask_b
  brief_description "Computes the bitwise XOR of two masks."
  detailed_description """
    Computes the lane-wise exclusive-or of two mask values. A lane is active in
    the result when exactly one input mask has that lane active.
    """
  semantics """
    input: mask mask_a, mask mask_b
    for each lane i:
      result[i] = mask_a[i] active state differs from mask_b[i]
    return result
