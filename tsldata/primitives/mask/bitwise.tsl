              complete(cast<static>(scalar::size, helper<popcount>(mask)));
            """
    oneapi_fpga:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(CountT, scalar::size);
              var<typed>(CountT, count, cast<static>(CountT, 0));
              loop<backend, unroll>(i, 0, value(vector::length), 1) {
                if (mask<test>(mask, i)) {
                  count = count + cast<static>(CountT, 1);
                }
              }
              complete(count);
            """
prim<im:=(im,usize)> shift_right_imask(data, shift):
  brief_description "Shifts an integral mask value right by a scalar shift count."
  detailed_description """
    Shifts an integral mask value right by a runtime scalar amount. The
    `PreserveSign` generic parameter controls whether signed integral masks keep
    arithmetic right-shift behavior or are first converted to an unsigned mask
    representation.
    """
  semantics """
    input: integral mask data, scalar shift, generic PreserveSign
    if shift is greater than or equal to the vector lane count:
      return 0
    if integral mask type is signed and PreserveSign is false:
      return unsigned(data) >> shift
    return data >> shift
    """
  tests:
    - {tags [basic], type "ui32", lane_count 16, case {inputs [240, 4], expected 15}}
    - {tags [zero], type "ui32", lane_count 16, case {inputs [0, 4], expected 0}}
    - {tags [width], type "ui32", lane_count 16, case {inputs [1, 32], expected 0}}
    - {tags [width, narrow], type "ui8", lane_count 16, case {inputs [32768, 8], expected 128}}
    - {tags [width, narrow], type "ui16", lane_count 32, case {inputs [65536, 16], expected 1}}
  generic_params:
    PreserveSign:
      kind bool
      default true
  impls:
    [clang_v128, avx512, avx2_vl, sse_vl, avx2, sse, neon, wasm128, scalar, generic, oneapi_fpga]:
      ?i?:
        requires:
          clang_v128 []
          avx512 [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl [sse2, avx512f, avx512vl]
          avx2 [avx]
          sse [sse]
          neon [neon]
          wasm128 [simd128]
          scalar []
          generic []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
          if<compile>(( value(type::is_signed(vector::imask)) ) && (!PreserveSign)) {
             complete(
               select_expr(
