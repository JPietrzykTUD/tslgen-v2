prim<m:=()>[value=zero] mask_false():
  brief_description "Creates a mask with every lane inactive."
  detailed_description """
    Constructs a mask value in which every lane is inactive.
    """
  semantics """
    for each lane i:
      result[i] = inactive
    return result
    """
  tests:
    - {tags [false], extension "avx512", type "ui8", lane_count 64, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui16", lane_count 32, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui32", lane_count 16, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui64", lane_count 8, case {inputs [], expected 0}}
    - {tags [false], extension "sve", type "ui32", lane_count 16, case {inputs [], expected 0}}
  impls:
    [avx512, avx2_vl, sse_vl]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask<zero>());"
    [avx2, sse, neon]:
      arith:
        requires:
          avx2 [avx, avx2]
          sse:
            [si8, ui8, si16, ui16, si32, ui32, f64] [sse, sse2]
            ?i64 [sse, sse2, sse4_1]
            f32 [sse]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=set_zero[Vec]>());"
    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svpfalse_b>());"
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask<zero>());"
    [generic, oneapi_fpga]:
      arith:
        requires:
          generic []
          oneapi_fpga []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask<zero>());"
prim<m:=()>[value=all] mask_true():
  brief_description "Creates a mask with every lane active."
  detailed_description """
    Constructs a mask value in which every lane is active.
    """
  semantics """
    for each lane i:
      result[i] = active
    return result
    """
  tests:
    - {tags [true], extension "avx512", type "ui8", lane_count 64, case {inputs [], expected 18446744073709551615}}
    - {tags [true], extension "avx512", type "ui16", lane_count 32, case {inputs [], expected 4294967295}}
    - {tags [true], extension "avx512", type "ui32", lane_count 16, case {inputs [], expected 65535}}
    - {tags [true], extension "avx512", type "ui64", lane_count 8, case {inputs [], expected 255}}
    - {tags [true], extension "sve", type "ui32", lane_count 16, case {inputs [], expected 65535}}
  impls:
    [avx512, avx2_vl, sse_vl]:
      arith:
        requires:
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
