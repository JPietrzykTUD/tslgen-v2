prim<m:=()>[value=zero] mask_false():
  operation mask_all_false
  brief_description "Creates a mask with every lane inactive."
  detailed_description """
    Constructs a mask value in which every lane is inactive.
    """
  semantics """
    for each lane i:
      result[i] = inactive
    return result
    """
  tests:
    - {tags [false], extension "avx512", type "ui8", lane_count 64, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui16", lane_count 32, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui32", lane_count 16, case {inputs [], expected 0}}
    - {tags [false], extension "avx512", type "ui64", lane_count 8, case {inputs [], expected 0}}
    - {tags [false], extension "sve", type "ui32", lane_count 16, case {inputs [], expected 0}}
    - {tags [false], extension "rvv", type "ui32", lane_count 4, case {inputs [], expected 0}}
  impls:
    [clang_v128, clang_v256, clang_v512, clang_v128_bool, clang_v256_bool, clang_v512_bool, avx512, avx2_vl, sse_vl]:
      arith:
        requires:
          clang_v128 []
          clang_v256 []
          clang_v512 []
          clang_v128_bool []
          clang_v256_bool []
          clang_v512_bool []
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(mask<none>());"
    [avx2, sse, neon]:
      arith:
        requires:
          avx2 [avx, avx2]
          sse:
            arith [sse, sse2]
            f32 [sse]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(call<primitive=set_zero[Vec]>());"
    sve:
      arith:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<svpfalse_b>());"
    rvv:
      ?i8:
        requires [v]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<vmclr, build[infix="m", infix_sep="_", suffix="b8"]>(
                value(vector::runtime_length)
              )
            );
          """
      ?i16:
        requires [v]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<vmclr, build[infix="m", infix_sep="_", suffix="b16"]>(
                value(vector::runtime_length)
              )
            );
          """
      [?i32, f32]:
        requires [v]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<vmclr, build[infix="m", infix_sep="_", suffix="b32"]>(
                value(vector::runtime_length)
              )
            );
          """
      [?i64, f64]:
        requires [v]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<vmclr, build[infix="m", infix_sep="_", suffix="b64"]>(
