          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(ScalarVec, vector::as_extension(scalar));
              var<infer>(result, call<primitive=set_zero[Vec]>());
              loop<generation, scoped>(i, 0, value(vector::length), 1) {
                var<const_infer>(lane_data, call<primitive=extract_value[Vec, i]>(data));
                var<const_infer>(lane_shift, call<primitive=extract_value[Vec, i]>(shift));
                var<const_infer>(shifted, call<primitive=@self[ScalarVec]>(lane_data, lane_shift));
                result = call<primitive=insert_value[Vec, i]>(result, shifted);
              }
              complete(result);
            """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(call<primitive=from_array[Vec]>(
                call<primitive=@self[GenericVec]>(generic_data, generic_shift)
              ));
            """
      f?:
        requires [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(ScalarVec, vector::as_extension(scalar));
              var<infer>(result, call<primitive=set_zero[Vec]>());
              loop<generation, scoped>(i, 0, value(vector::length), 1) {
                var<const_infer>(lane_data, call<primitive=extract_value[Vec, i]>(data));
                var<const_infer>(lane_shift, call<primitive=extract_value[Vec, i]>(shift));
                var<const_infer>(shifted, call<primitive=@self[ScalarVec]>(lane_data, lane_shift));
                result = call<primitive=insert_value[Vec, i]>(result, shifted);
              }
              complete(result);
