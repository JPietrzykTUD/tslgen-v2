              let<type>(GenericVec, vector::as_extension(generic));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(call<primitive=from_array[Vec]>(
                call<primitive=@self[GenericVec]>(generic_data, generic_shift)
              ));
