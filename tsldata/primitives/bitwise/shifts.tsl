    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
               var<const_infer>(pg, call<primitive=mask_true[Vec]>());
               var<const_infer>(shift_u, call<primitive=reinterpret[Vec, Vec<base::unsigned_of(base::in)>]>(shift));
               complete(intrin<svlsl, build[post=x]>(pg, data, shift_u));
            """
      f?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              let<type>(UBase, base::unsigned_of(base::in));
              let<type>(UVec, vector::as_base(UBase));
              var<const_infer>(pg, call<primitive=mask_true[Vec]>());
              var<const_infer>(udata, call<primitive=reinterpret[Vec, UVec]>(data));
              var<const_infer>(shift_u, call<primitive=cast[Vec, UBase]>(shift));
              var<const_infer>(ures, intrin<svlsl, build[suffix=UBase, post=x]>(pg, udata, shift_u));
              complete(call<primitive=reinterpret[UVec, Vec]>(ures));
