              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec]>(
                    generic_data,
                    shift
                  )
                )
              );
            """
    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              complete(
                intrin<svlsl_n_{{ ?i? }}_x>(call<primitive=mask_true[Vec]>(), data, cast<static>(type<generation>(base::unsigned_of(type<generation>(base::in))), shift))
              );
            """
      f?:
        requires [sve]
