prim<v:=(v,v)> shift_right(data, shift):
  brief_description "[Example: avx2 + ui32]: Shift packed 32-bit integers in \"a\" right by the amount specified by the corresponding element in \"count\" while shifting in zeros, and store the results in \"dst\"."
  operation "[Example: avx2 + ui32]: FOR j := 0 to 7\n\ti := j*32\n\tIF count[i+31:i] < 32\n\t\tdst[i+31:i] := ZeroExtend32(a[i+31:i] >> count[i+31:i])\n\tELSE\n\t\tdst[i+31:i] := 0\n\tFI\nENDFOR\ndst[MAX:256] := 0"
  generic_params:
    PreserveSign:
      kind bool
      default true
  tests:
    - {tags [vector, basic], type "ui32", case {inputs [[1, 2, 4, 8, 16, 32, 64, 128], [0, 1, 2, 3, 4, 5, 6, 7]], expected [1, 1, 1, 1, 1, 1, 1, 1]}}
    - {tags [vector, edge], type "ui32", case {inputs [[2147483648, 2147483647, 1073741824, 536870912, 0, 1, 2, 3], [31, 30, 29, 28, 0, 1, 2, 3]], expected [1, 1, 2, 2, 0, 0, 0, 0]}}
  impls:
    scalar:
      ?i?:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              if<generation>(value<generation>(type::is_signed(type<generation>(base::in)))) {
                if<compile>(!PreserveSign) {
                  let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                  var<const_infer>(result, cast<static>(UnsignedT, data) >> cast<static>(UnsignedT, shift));
                  complete(cast<static>(type<generation>(base::in), result));
                } else<compile> {
                  complete(data >> shift);
                }
              } else<compile> {
                complete(data >> shift);
              }
            """
      f?:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              var<const_infer>(ua, call<primitive=reinterpret[Vec, Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>]>(data));
              var<const_infer>(ures, ua >> cast<static>(type<generation>(base::unsigned_of(type<generation>(base::in))), shift));
              complete(call<primitive=reinterpret[Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>, Vec]>(ures));
            """
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              var<init_register>(result);
              loop<backend, unroll>(i, 0, value<generation>(vector::length), 1)  {
                result[i] = call<primitive=@self[type<backend>(vector::as_extension(scalar)), PreserveSign]>(data[i], shift[i]);
              }
              complete(result);
            """
    avx512:
      ui32 {intrinsic "intrin<_mm512_srlv_epi32>", requires [avx512f]}
      ui64 {intrinsic "intrin<_mm512_srlv_epi64>", requires [avx512f]}
      si32:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              if<compile>(!PreserveSign) {
                let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                var<const_infer>(udata, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(data));
                var<const_infer>(shift_u, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(shift));
                var<const_infer>(ures, intrin<srlv, build[suffix=base::signed_of(base::in)]>(udata, shift_u));
                complete(call<primitive=reinterpret[Vec<UnsignedT>, Vec]>(ures));
              } else<compile> {
                complete(intrin<srav, build>(data, shift));
              }
            """
      si64:
        requires [avx512f]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              if<compile>(!PreserveSign) {
                let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                var<const_infer>(udata, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(data));
                var<const_infer>(shift_u, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(shift));
                var<const_infer>(ures, intrin<srlv, build[suffix=base::signed_of(base::in)]>(udata, shift_u));
                complete(call<primitive=reinterpret[Vec<UnsignedT>, Vec]>(ures));
              } else<compile> {
                complete(intrin<srav, build>(data, shift));
              }
            """
      f?:
        requires [avx512f]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
      arith:
        requires [avx512f]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
    avx2:
      ui32 {intrinsic "intrin<_mm256_srlv_epi32>", requires [avx, avx2]}
      ui64 {intrinsic "intrin<_mm256_srlv_epi64>", requires [avx, avx2]}
      si32:
        requires [avx, avx2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              if<compile>(!PreserveSign) {
                let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                var<const_infer>(udata, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(data));
                var<const_infer>(shift_u, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(shift));
                var<const_infer>(ures, intrin<srlv, build[suffix=base::signed_of(base::in)]>(udata, shift_u));
                complete(call<primitive=reinterpret[Vec<UnsignedT>, Vec]>(ures));
              } else<compile> {
                complete(intrin<srav, build>(data, shift));
              }
            """
      arith:
        requires [avx]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
    sse:
      arith:
        requires [sse]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
    neon:
      ?i?:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              if<generation>(value<generation>(type::is_signed(type<generation>(base::in)))) {
                if<compile>(!PreserveSign) {
                  let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                  let<type>(SignedT, type<generation>(base::signed_of(type<generation>(base::in))));
                  var<const_infer>(udata, call<primitive=reinterpret[Vec, Vec<UnsignedT>]>(data));
                  var<const_infer>(shift_s, call<primitive=reinterpret[Vec, Vec<SignedT>]>(shift));
                  var<const_infer>(neg, intrin<vnegq_{{ si? }}>(shift_s));
                  var<const_infer>(ures, intrin<vshlq_{{ ui? }}>(udata, neg));
                  complete(call<primitive=reinterpret[Vec<UnsignedT>, Vec]>(ures));
                } else<compile> {
                  complete(intrin<vshlq_{{ ?i? }}>(data, intrin<vnegq_{{ si? }}>(shift)));
                }
              } else<generation> {
                let<type>(SignedT, type<generation>(base::signed_of(type<generation>(base::in))));
                var<const_infer>(shift_s, call<primitive=reinterpret[Vec, Vec<SignedT>]>(shift));
                complete(intrin<vshlq_{{ ?i? }}>(data, intrin<vnegq_{{ si? }}>(shift_s)));
              }
            """
      f?:
        requires [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
              var<const_infer>(pg, call<primitive=mask_true[Vec]>());
              let<type>(UVec, type<generation>(vector::as_base(type<generation>(base::unsigned_of(type<generation>(base::in))))));
              var<const_infer>(shift_u, call<primitive=reinterpret[Vec, UVec]>(shift));
              if<generation>(value<generation>(type::is_signed(type<generation>(base::in)))) {
                if<compile>(!PreserveSign) {
                  let<type>(UnsignedT, type<generation>(base::unsigned_of(type<generation>(base::in))));
                  var<const_infer>(udata, call<primitive=reinterpret[Vec, UVec]>(data));
                  var<const_infer>(ures, intrin<svlsr, build[suffix=base::unsigned_of(base::in), post=x]>(pg, udata, shift_u));
                  complete(call<primitive=reinterpret[UVec, Vec]>(ures));
                } else<compile> {
                  complete(intrin<svasr, build[post=x]>(pg, data, shift_u));
                }
              } else<generation> {
                complete(intrin<svlsr, build[suffix=base::unsigned_of(base::in), post=x]>(pg, data, shift_u));
              }
            """
      f?:
        requires [sve]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
              let<type>(GenericVec, type<backend>(vector::as_extension(generic)));
              var<const_infer>(generic_data, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(data)));
              var<const_infer>(generic_shift, call<primitive=from_array[GenericVec]>(call<primitive=to_array>(shift)));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=@self[GenericVec, PreserveSign]>(
                    generic_data,
                    generic_shift
                  )
                )
              );
            """
