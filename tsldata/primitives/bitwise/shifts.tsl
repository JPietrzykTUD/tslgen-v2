              var<const_infer>(bits, call<primitive=reinterpret[Vec, UVec]>(data));
              var<const_infer>(counts, call<primitive=cast[Vec, UBase]>(shift));
              var<const_infer>(shifted, call<primitive=@self[UVec]>(bits, counts));
              complete(call<primitive=reinterpret[UVec, Vec]>(shifted));
