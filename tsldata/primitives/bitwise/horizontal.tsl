                var<infer>(bits, cast<static>(UnsignedT, 0));
                mem<copy>(cast<reinterpret, type=ptr>(void, &bits), cast<reinterpret, type=const_ptr>(void, &values[i]), value(type::size_bytes(base::in)));
                result |= bits;
