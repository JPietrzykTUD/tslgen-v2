          sve [sve]
        implementation:
          tsil """
            let<type>(UnsignedT, type<generation>(select(value<generation>(type::is_same(type<generation>(base::in), f32)), ui32, ui64)))
            var<const_infer>(data_arr, call<primitive=to_array[Vec]>(vec))
            UnsignedT result = cast<static>(UnsignedT, 0);
            loop<range>(i, 0, value<generation>(vector::length), 1) {
              var<infer>(bits, cast<static>(UnsignedT, 0))
              mem<copy>(cast<reinterpret>(void*, &bits), cast<reinterpret>(void const*, &data_arr[i]), value<generation>(type::size_bytes(type<generation>(base::in))));
              result |= bits;
            }
            var<infer>(out, cast<static>(type<generation>(base::in), 0))
            mem<copy>(cast<reinterpret>(void*, &out), cast<reinterpret>(void const*, &result), value<generation>(type::size_bytes(type<generation>(base::in))));
            emit_return(out);
          """
