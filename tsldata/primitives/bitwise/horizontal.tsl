          tsil "complete(cast<static>(type(base::in), intrin<mask_reduce_or, build[suffix=base::signed_of(base::in)]>(mask, vec)));"
    [clang_v128, scalar, generic, oneapi_fpga, avx512, avx2_vl, avx2, sse_vl, sse, neon, wasm128]:
