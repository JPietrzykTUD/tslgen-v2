prim<usize:=m> tzc(value):
  brief_description "Counts trailing zero bits in an integral mask value."
  detailed_description """
    Converts the mask to its integral mask representation and counts trailing
    zero bits in that representation. A mask with no active bits yields the
    width of the integral mask representation.
    """
  semantics """
    input: mask value
    bits = integral_mask_representation(value)
    return count_trailing_zero_bits(bits)
    """
