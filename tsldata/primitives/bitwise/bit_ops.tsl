prim<v:=(m,v,v)>[mask=zero] binary_xor(mask, left, right):
  operation bit_xor
  operand_roles:
    control_mask mask
    primary left
    secondary right
  brief_description "Computes bitwise XOR on active mask lanes and writes zero to inactive lanes."
  detailed_description """
    Computes bitwise exclusive OR for lanes enabled by the mask. Disabled lanes
    are set to zero. Floating-point lanes are treated by their underlying bit
    representation.
    """
  semantics """
    input: mask mask, register left, register right
    for each lane i:
      if mask[i] is active:
        result[i] = left[i] ^ right[i]
      else:
        result[i] = 0
    return result
    """
  tests:
