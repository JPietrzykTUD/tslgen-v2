          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mask_xor, build[suffix=base::signed_of(base::in)]>(
                left, mask, left, right
              )
            );
          """
      bword:
        requires:
          avx512 [avx512f, avx512bw]
          avx2_vl [avx512f, avx512vl, avx512bw, avx]
          sse_vl [avx512f, avx512vl, avx512bw, sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                left,
                call<primitive=binary_xor>(left, right)
              )
            );
          """
      f?:
        requires:
          avx512 [avx512f, avx512dq]
          avx2_vl [avx512f, avx512vl, avx512dq, avx]
          sse_vl [avx512f, avx512vl, avx512dq, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mask_xor, build>(left, mask, left, right)
            );
          """
    [avx2, sse, neon]:
      arith:
        requires:
          avx2:
            ?i? [avx, avx2]
            f? [avx]
          sse:
            ?i? [sse, sse2]
            f32 [sse]
            f64 [sse, sse2]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=pass_through]>(
                mask,
                left,
                call<primitive=binary_xor>(left, right)
              )
            );
          """
    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<sveor, build[post=m]>(mask, left, right)
            );
          """
      f?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              call<primitive=reinterpret[Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>, Vec]>(
                intrin<sveor, build[suffix=base::unsigned_of(base::in), post=m]>(
                  mask,
                  call<primitive=reinterpret[Vec, Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>]>(left),
                  call<primitive=reinterpret[Vec, Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>]>(right)
                )
              )
            );
          """

prim<v:=(m,v)>[mask=zero] inv(mask, data):
  brief_description "Masked bitwise inversion with zeroing."
  operation "For each lane: if mask bit is set, compute NOT data; otherwise write zero."
  tests:
    - {tags [maskz, basic], type "ui32", case {inputs [170, [0, 1, 2, 3, 4, 5, 6, 7]], expected [0, 4294967294, 0, 4294967292, 0, 4294967290, 0, 4294967288]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            if (mask) {
              complete(
                call<primitive=binary_xor>(
                  data,
                  call<primitive=set1[Vec]>(value<generation>(mask::lane::all_true))
                )
              );
            }
            complete(call<primitive=set_zero[Vec]>());
          """
    [generic, oneAPIfpga]:
      arith:
        requires:
          generic []
          oneAPIfpga [oneAPIfpgaDev]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<init_register>(result);
            loop<backend, unroll>(i, 0, value<generation>(vector::length), 1) {
              if (mask<test>(mask, i)) {
                result[i] = call<primitive=binary_xor[type<backend>(vector::as_extension(scalar))]>(
                  data[i],
                  call<primitive=set1[type<backend>(vector::as_extension(scalar))]>(value<generation>(mask::lane::all_true))
                );
              } else {
                result[i] = call<primitive=set_zero[type<backend>(vector::as_extension(scalar))]>();
              }
            }
            complete(result);
          """
    [avx512, avx2_vl, sse_vl]:
      idqword:
        requires:
          avx512 [avx512f]
          avx2_vl [avx512f, avx512vl, avx]
          sse_vl [avx512f, avx512vl, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<maskz_xor, build[suffix=base::signed_of(base::in)]>(
                mask,
                data,
                call<primitive=set1[Vec]>(value<generation>(mask::lane::all_true))
              )
            );
          """
      bword:
        requires:
          avx512 [avx512f, avx512bw]
          avx2_vl [avx512f, avx512vl, avx512bw, avx]
          sse_vl [avx512f, avx512vl, avx512bw, sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=zero]>(
                mask,
                call<primitive=inv>(data)
              )
            );
          """
      f?:
        requires:
          avx512 [avx512f, avx512dq]
          avx2_vl [avx512f, avx512vl, avx512dq, avx]
          sse_vl [avx512f, avx512vl, avx512dq, sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<maskz_xor, build>(
                mask,
                data,
                call<primitive=set1[Vec]>(value<generation>(mask::lane::all_true))
              )
            );
          """
    [avx2, sse, neon]:
      arith:
        requires:
          avx2:
            ?i? [avx, avx2]
            f? [avx]
          sse:
            ?i? [sse, sse2]
            f32 [sse]
            f64 [sse, sse2]
          neon [neon]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mov, attrs[mask=zero]>(
                mask,
                call<primitive=inv>(data)
              )
            );
          """
    sve:
      ?i?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<sveor, build[post=z]>(
                mask,
                data,
                call<primitive=set1[Vec]>(value<generation>(mask::lane::all_true))
              )
            );
          """
      f?:
        requires [sve]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              call<primitive=reinterpret[Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>, Vec]>(
                intrin<sveor, build[suffix=base::unsigned_of(base::in), post=z]>(
                  mask,
                  call<primitive=reinterpret[Vec, Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>]>(data),
                  call<primitive=reinterpret[Vec, Vec<type<generation>(base::unsigned_of(type<generation>(base::in)))>]>(
                    call<primitive=set1[Vec]>(value<generation>(mask::lane::all_true))
                  )
                )
              )
            );
          """

