          reasons [intrinsic]
        implementation:
          tsil """
            var<const_infer>(sign_bit, call<primitive=set1[Vec]>(cast<static>(type(base::in), 0x8000000000000000)));
            complete(
              intrin<gt, build[suffix="i64x2"]>(
                call<primitive=binary_xor>(left, sign_bit),
                call<primitive=binary_xor>(right, sign_bit)
              )
            );
          """
        variants:
          generic_fallback:
            tsil """
              let<type>(GenericVec, type(vector::as_extension(generic)));
              var<const_infer>(generic_left, call<primitive=from_array[GenericVec]>(call<primitive=to_array[Vec]>(left)));
              var<const_infer>(generic_right, call<primitive=from_array[GenericVec]>(call<primitive=to_array[Vec]>(right)));
              var<const_infer>(generic_result, call<primitive=@self[GenericVec]>(generic_left, generic_right));
              complete(
                call<primitive=from_array[Vec]>(
                  call<primitive=to_array[GenericVec]>(
                    call<primitive=to_vector[GenericVec]>(generic_result)
                  )
                )
              );
            """
    oneapi_fpga:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(MaskT, type(vector::mask));
            var<typed>(MaskT, result, mask<none>());
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              if (left[i] > right[i]) {
                mask<set>(result, i);
              }
            }
            complete(result);
          """
    [avx512, avx2_vl, sse_vl]:
