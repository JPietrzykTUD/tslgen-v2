            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<cmp, build[post=mask]>(left, right, _CMP_GT_OQ)
