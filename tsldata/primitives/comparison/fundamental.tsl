              >(mask, left, right)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        implementation:
          tsil """
            emit_return(
              intrin_compose<mask_cmp, post=mask>(
                mask,
                left,
                right,
                _CMP_LE_OQ
              )
            );
          """
    avx2:
      ?i?:
        requires [avx2]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=less_than_or_equal>(left, right)
              )
            );
          """
      f?:
        requires [avx]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=less_than_or_equal>(left, right)
              )
            );
          """
    sse:
      ?i?:
        requires:
          [?i8, ?i16, ?i32] [sse2]
          ?i64 [sse4_1]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=less_than_or_equal>(left, right)
              )
            );
          """
      f?:
        requires:
          f32 [sse]
          f64 [sse2]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=less_than_or_equal>(left, right)
              )
            );
