          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            if<generation>(type::is_same(type(base::in), ui8)) {
              var<const_infer>(sign_bit, call<primitive=set1[Vec]>(cast<static>(type(base::in), 0x80)));
              complete(
                intrin<cmpgt, build[suffix=base::signed_of(base::in)]>(
                  call<primitive=binary_xor>(right, sign_bit),
                  call<primitive=binary_xor>(left, sign_bit)
                )
              );
            } else<generation> {
              if<generation>(type::is_same(type(base::in), ui16)) {
                var<const_infer>(sign_bit, call<primitive=set1[Vec]>(cast<static>(type(base::in), 0x8000)));
                complete(
                  intrin<cmpgt, build[suffix=base::signed_of(base::in)]>(
                    call<primitive=binary_xor>(right, sign_bit),
                    call<primitive=binary_xor>(left, sign_bit)
                  )
                );
              } else<generation> {
                if<generation>(type::is_same(type(base::in), ui32)) {
                  var<const_infer>(sign_bit, call<primitive=set1[Vec]>(cast<static>(type(base::in), 0x80000000)));
                  complete(
                    intrin<cmpgt, build[suffix=base::signed_of(base::in)]>(
                      call<primitive=binary_xor>(right, sign_bit),
                      call<primitive=binary_xor>(left, sign_bit)
                    )
                  );
                } else<generation> {
                  var<const_infer>(sign_bit, call<primitive=set1[Vec]>(cast<static>(type(base::in), 0x8000000000000000)));
                  complete(
                    intrin<cmpgt, build[suffix=base::signed_of(base::in)]>(
                      call<primitive=binary_xor>(right, sign_bit),
                      call<primitive=binary_xor>(left, sign_bit)
                    )
                  );
                }
              }
            }
          """
    sse:
      [si8, si16, si32]:
        requires [sse, sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<cmplt, build>(left, right));"
      si64:
        requires [sse4_2]
