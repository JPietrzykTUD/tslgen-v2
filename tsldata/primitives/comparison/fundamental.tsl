      f?:
        requires:
          f32 [sse]
          f64 [sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<cmpge, build>(left, right));"
      ui?:
