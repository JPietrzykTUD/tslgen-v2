prim<m:=(m,v,v)>[mask=zero] nequal(mask, left, right):
  brief_description "Compare packed elements in \"left\" and \"right\" for inequality only on active lanes of \"mask\", clearing inactive lanes in the result."
  detailed_description """
    Compares active lanes for inequality and clears inactive lanes in the result
    mask. Each active true comparison lane is represented by the target mask
    true value, and each inactive or false lane is represented by the target
    mask false value. Floating-point unordered cases follow the selected
    backend comparison predicate.
    """
  semantics """
    input: mask mask, register left, register right
    for each lane i:
      if mask[i] is active:
        result[i] = left[i] != right[i]
      else:
        result[i] = false
    return mask result
    """
  operation "[Example: avx512 + si32]: FOR j := 0 to 15\n\tk[j] := ( mask[j] && ( left[j] != right[j] ) ) ? 1 : 0\nENDFOR\nk[MAX:16] := 0"
  tests:
    - {tags [nequal, mask, basic], type "ui32", case {inputs [170, [1, 2, 3, 4, 5, 6, 7, 8], [1, 0, 3, 0, 5, 0, 7, 0]], expected [0, 4294967295, 0, 4294967295, 0, 4294967295, 0, 4294967295]}}
    - {tags [nequal, mask, none], type "ui32", case {inputs [0, [1, 2, 3, 4, 5, 6, 7, 8], [0, 0, 0, 0, 0, 0, 0, 0]], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
    - {tags [nequal, mask, mixed], type "si32", case {inputs [170, [-1, -2, -3, -4, 5, 6, 7, 8], [-1, 0, -3, 1, 5, 0, 7, 0]], expected [0, -1, 0, -1, 0, -1, 0, -1]}}
    - {tags [nequal, mask, basic], type "f32", case {inputs [10, [1.0, -2.0, 3.5, -4.5], [1.0, 0.0, 3.5, 0.0]], expected [0.0, NAN, 0.0, NAN]}}
    - {tags [nequal, mask, nan, edge], type "f32", case {inputs [11, [NAN, 0.0, -0.0, INFINITY], [NAN, 1.0, -0.0, 0.0]], expected [NAN, NAN, 0.0, NAN]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_and[Vec]>(
                mask,
                call<primitive=nequal[Vec]>(left, right)
              )
            );
          """
    generic:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(MaskT, type(vector::mask));
            var<typed>(MaskT, result, mask<zero>());
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              if (
                (left[i] != right[i]) &&
                (mask<test>(mask, i))
              ) {
                mask<set>(result, i);
              }
            }
            complete(result);
          """
    oneapi_fpga:
      arith:
        requires [oneapi_fpga_device]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(RegisterT, type(vector::register));
            RegisterT result{};
            var<const_infer>(true_value, mask<lane_true>());
            var<const_infer>(false_value, mask<lane_false>());
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = (
                (left[i] != right[i]) &&
                (mask<test>(mask, i))
              ) ? true_value : false_value;
            }
            complete(result);
          """
    [avx512, avx2_vl, sse_vl]:
      ?i?:
        requires:
          avx512:
            idqword [avx512f]
            bword   [avx512f, avx512bw]
          avx2_vl:
            idqword [avx2, avx512f, avx512vl, avx512dq]
            bword   [avx2, avx512f, avx512vl, avx512bw]
          sse_vl:
            idqword [sse2, avx512f, avx512vl, avx512dq]
            bword   [sse2, avx512f, avx512vl, avx512bw]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mask_cmpneq, build[suffix=base::signed_of(base::in), post=mask]>(mask, left, right)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<mask_cmp, build[post=mask]>(
                mask,
                left,
                right,
                _CMP_NEQ_UQ
              )
            );
          """
    avx2:
      ?i?:
        requires [avx2]
        safety:
          internal_unsafe false
