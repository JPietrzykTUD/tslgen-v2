prim<m:=(m,v,v)>[mask=zero] greater_than_or_equal(mask, left, right):
  brief_description "Compare packed elements in \"left\" and \"right\" for greater-than-or-equal only on active lanes of \"mask\", clearing inactive lanes in the result."
  operation "[Example: avx512 + si32]: FOR j := 0 to 15\n\tk[j] := ( mask[j] && ( left[j] >= right[j] ) ) ? 1 : 0\nENDFOR\nk[MAX:16] := 0"
  tests:
    - {test_name "greater_than_or_equal_mask_u32_basic", type "ui32", lane_set "lanes_i32", lanes 8, case {inputs [[1, 2, 3, 4, 5, 6, 7, 8], [1, 3, 3, 5, 5, 7, 7, 9], 85], expected [4294967295, 0, 4294967295, 0, 4294967295, 0, 4294967295, 0]}}
    - {test_name "greater_than_or_equal_mask_u32_none", type "ui32", lane_set "lanes_i32", lanes 8, case {inputs [[9, 9, 9, 9, 9, 9, 9, 9], [1, 2, 3, 4, 5, 6, 7, 8], 0], expected [0, 0, 0, 0, 0, 0, 0, 0]}}
    - {test_name "greater_than_or_equal_mask_si32_mixed", type "si32", lane_set "lanes_i32", lanes 8, case {inputs [[-1, -2, -3, -4, 5, 6, 7, 8], [-1, -1, -3, 1, 5, 7, 7, 9], 85], expected [-1, 0, -1, 0, -1, 0, -1, 0]}}
    - {test_name "greater_than_or_equal_mask_f32_basic", type "f32", lane_set "lanes_f32", lanes 4, case {inputs [[1.0, -2.0, 3.5, -4.5], [1.0, -1.0, 3.5, 0.0], 5], expected [NAN, 0.0, NAN, 0.0]}}
    - {test_name "greater_than_or_equal_mask_f32_nan_edge", type "f32", lane_set "lanes_f32", lanes 4, case {inputs [[NAN, 1.0, -0.0, INFINITY], [NAN, 0.0, -0.0, INFINITY], 14], expected [0.0, NAN, NAN, NAN]}}
  impls:
    scalar:
      arith:
        requires []
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and[Vec]>(
                mask,
                call<primitive=greater_than_or_equal[Vec]>(left, right)
              )
            );
          """
    generic:
      arith:
        requires []
        implementation:
          tsil """
            let<type>(MaskT, type<generation>(vector::mask))
            MaskT result = mask<zero>();
            loop<unroll>(value<generation>(vector::length))
            loop<range>(i, 0, value<generation>(vector::length), 1) {
              if (
                (left[i] >= right[i]) &&
                (mask<test>(mask, i))
              ) {
                mask<set:1>(result, i);
              }
            }
            emit_return(result);
          """
    oneAPIfpga:
      arith:
        requires [oneAPIfpgaDev]
        implementation:
          tsil """
            let<type>(RegisterT, type<generation>(vector::register))
            RegisterT result{};
            var<const_infer>(true_value, value<generation>(mask::lane::all_true));
            var<const_infer>(false_value, value<generation>(mask::lane::all_false));
            loop<unroll>(value<generation>(vector::length))
            loop<range>(i, 0, value<generation>(vector::length), 1) {
              result[i] = (
                (left[i] >= right[i]) &&
                (mask<test>(mask, i))
              ) ? true_value : false_value;
            }
            emit_return(result);
          """
    [avx512, avx2_vl, sse_vl]:
      ?i?:
        requires:
          avx512:
            idqword [avx512f]
            bword   [avx512f, avx512bw]
          avx2_vl:
            idqword [avx2, avx512f, avx512vl, avx512dq]
            bword   [avx2, avx512f, avx512vl, avx512bw]
          sse_vl:
            idqword [sse2, avx512f, avx512vl, avx512dq]
            bword   [sse2, avx512f, avx512vl, avx512bw]
        implementation:
          tsil """
            emit_return(
              intrin_compose<
                mask_cmpge,
                suffix=value<backend>(intrin::suffix(type<generation>(base::signed_of(type<generation>(base::in))))),
                post=mask
              >(mask, left, right)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        implementation:
          tsil """
            emit_return(
              intrin_compose<mask_cmp, post=mask>(
                mask,
                left,
                right,
                _CMP_GE_OQ
              )
            );
          """
    avx2:
      ?i?:
        requires [avx2]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=greater_than_or_equal>(left, right)
              )
            );
          """
      f?:
        requires [avx]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=greater_than_or_equal>(left, right)
              )
            );
          """
    sse:
      ?i?:
        requires:
          [?i8, ?i16, ?i32] [sse2]
          ?i64 [sse4_1]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=greater_than_or_equal>(left, right)
              )
            );
          """
      f?:
        requires:
          f32 [sse]
          f64 [sse2]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=greater_than_or_equal>(left, right)
              )
            );
          """
    neon:
      arith:
        requires [neon]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=greater_than_or_equal>(left, right)
              )
            );
          """
    sve:
      arith:
        requires [sve]
        implementation:
          tsil """
            emit_return(
              intrin_compose<svcmpge>(
                mask,
                left, right
              )
            );
          """
