          si64              [sse4_2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_or>(
                call<primitive=equal>(left, right),
                call<primitive=greater_than>(left, right)
              )
            );
