                }
              }
            }
          """
      arith:
        requires [sse, sse2]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            var<infer>(result, call<primitive=to_array[Vec]>(call<primitive=set_zero[Vec]>()));
            var<const_infer>(left_values, call<primitive=to_array[Vec]>(left));
            var<const_infer>(right_values, call<primitive=to_array[Vec]>(right));
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              if (left_values[i] < right_values[i]) {
                result[i] = mask<lane_true>();
              }
            }
            complete(call<primitive=from_array[Vec]>(result));
          """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
