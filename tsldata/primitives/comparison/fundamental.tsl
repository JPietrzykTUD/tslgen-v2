    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil "complete(left < right);"
    generic:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(MaskT, type(vector::mask));
            var<typed>(MaskT, result, mask<zero>());
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              if (left[i] < right[i]) {
                mask<set>(result, i);
              }
            }
            complete(result);
          """
    oneapi_fpga:
      arith:
        requires [oneapi_fpga_device]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            let<type>(RegisterT, type(vector::register));
            RegisterT result{};
            var<const_infer>(true_value, mask<lane_true>());
            var<const_infer>(false_value, mask<lane_false>());
            loop<backend, unroll>(i, 0, value(vector::length), 1) {
              result[i] = (left[i] < right[i]) ? true_value : false_value;
            }
            complete(result);
          """
    [avx512, avx2_vl, sse_vl]:
      ?i?:
        requires:
          avx512:
            idqword [avx512f]
            bword   [avx512f, avx512bw]
          avx2_vl:
            idqword [avx2, avx512f, avx512vl, avx512dq]
            bword   [avx2, avx512f, avx512vl, avx512bw]
          sse_vl:
            idqword [sse2, avx512f, avx512vl, avx512dq]
            bword   [sse2, avx512f, avx512vl, avx512bw]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            complete(
              intrin<cmplt, build[post=mask]>(left, right)
            );
          """
      f?:
        requires:
          avx512  [avx512f]
          avx2_vl [avx2, avx512f, avx512vl]
          sse_vl  [sse2, avx512f, avx512vl]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
