      f?:
        requires:
          f32 [sse]
          f64 [sse2]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil "complete(intrin<cmpge, build>(left, right));"
      ui?:
        requires:
          [ui8, ui16, ui32] [sse2]
          ui64              [sse2, sse4_1]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_or>(
                call<primitive=equal>(left, right),
                call<primitive=greater_than>(left, right)
              )
            );
          """
    neon:
      arith:
        requires [neon]
        safety:
          internal_unsafe true
          caller_unsafe false
          reasons [intrinsic]
        implementation:
          tsil """
            let<type>(MaskVec, type(vector::as_base(type(base::unsigned_of(type(base::in))))));
            complete(
