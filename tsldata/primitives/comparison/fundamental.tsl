    [scalar, clang_v128, generic, oneapi_fpga, wasm128]:
      arith:
        requires:
          scalar []
          clang_v128 []
          generic []
          oneapi_fpga []
          wasm128 [simd128]
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_and[Vec]>(
                mask,
                call<primitive=equal[Vec]>(left, right)
              )
            );
          """
    [avx512, avx2_vl, sse_vl]:
      ?i?:
        requires:
          avx512:
            idqword [avx512f]
            bword   [avx512f, avx512bw]
          avx2_vl:
