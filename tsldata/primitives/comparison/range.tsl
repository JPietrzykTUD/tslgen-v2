        requires [neon]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=between_exclusive>(x, left, right)
              )
            );
          """
    sve:
      arith:
        requires [sve]
        implementation:
          tsil """
            emit_return(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=between_exclusive>(x, left, right)
              )
            );
          """
