prim<m:=(v,v,v)> between_exclusive(x, left, right):
  brief_description "Checks if the values of \"x\" are within an exclusive range (left < x < right)."
  operation "FOR j := 0 to N-1\n\tresult[j] := ( left[j] < x[j] && x[j] < right[j] ) ? all_true : 0\nENDFOR"
  tests:
    - {test_name "between_exclusive_u32_basic", type "ui32", lane_set "lanes_i32", lanes 8, case {inputs [[2, 3, 4, 5, 6, 7, 8, 9], [1, 2, 3, 4, 5, 7, 7, 9], [3, 4, 5, 5, 7, 8, 9, 10]], expected [4294967295, 4294967295, 4294967295, 0, 4294967295, 0, 4294967295, 0]}}
    - {test_name "between_exclusive_si32_mixed", type "si32", lane_set "lanes_i32", lanes 8, case {inputs [[-1, -2, -3, -4, 5, 6, 7, 8], [-2, -3, -4, -5, 4, 6, 6, 8], [0, -1, -2, -4, 6, 7, 8, 9]], expected [-1, -1, -1, 0, -1, 0, -1, 0]}}
