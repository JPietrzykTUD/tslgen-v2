prim<m:=(m,v,v,v)>[mask=zero] between_exclusive(mask, x, left, right):
  brief_description "Tests active lanes for the exclusive range left < x < right and clears inactive lanes in the result mask."
  detailed_description """
    Checks active lanes of `x` against the exclusive range bounded by `left` and
    `right`, clearing inactive lanes in the result mask. Active lanes are true
    where `left < x < right`. Signedness and floating-point unordered behavior
    follow the selected comparison predicates.
    """
  semantics """
    input: mask mask, register x, register left, register right
    for each lane i:
      if mask[i] is active:
        result[i] = (left[i] < x[i]) and (x[i] < right[i])
      else:
        result[i] = false
    return mask result
    """
  tests:
    - {tags [mask, basic], type "ui32", case {inputs [170, [2, 3, 4, 5, 6, 7, 8, 9], [1, 2, 3, 4, 5, 7, 7, 9], [3, 4, 5, 5, 7, 8, 9, 10]], expected [0, 4294967295, 0, 0, 0, 0, 0, 0]}}
    - {tags [mask, mixed], type "si32", case {inputs [85, [-1, -2, -3, -4, 5, 6, 7, 8], [-2, -3, -4, -5, 4, 6, 6, 8], [0, -1, -2, -4, 6, 7, 8, 9]], expected [-1, 0, -1, 0, -1, 0, -1, 0]}}
    - {tags [mask, basic], type "f32", case {inputs [5, [1.0, -2.0, 3.5, -4.5], [0.0, -3.0, 3.0, -5.0], [2.0, -1.0, 4.0, -4.5]], expected [NAN, 0.0, NAN, 0.0]}}
    - {tags [mask, nan, edge], type "f32", case {inputs [6, [NAN, 0.0, -0.0, INFINITY], [NAN, -1.0, -1.0, 0.0], [1.0, 1.0, 1.0, INFINITY]], expected [0.0, NAN, NAN, 0.0]}}
  impls:
    scalar:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_and[Vec]>(
                mask,
                call<primitive=between_exclusive[Vec]>(x, left, right)
              )
            );
          """
    generic:
      arith:
        requires []
        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=between_exclusive>(x, left, right)
              )
            );
          """
    oneapi_fpga:
      arith:
