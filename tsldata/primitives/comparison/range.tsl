        safety:
          internal_unsafe false
          caller_unsafe false
          reasons []
        implementation:
          tsil """
            complete(
              call<primitive=mask_binary_and>(
                mask,
                call<primitive=between_exclusive>(x, left, right)
              )
            );
          """
    oneapi_fpga_rtl:
