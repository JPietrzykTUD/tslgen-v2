template alloc:
  description "Allocate memory."
  shape "(scalar) -> ptr"
  required_fields []
  optional_fields ["intrinsic", "implementation", "requires", "note"]

template alloc_aligned:
  description "Allocate aligned memory."
  shape "(scalar, scalar) -> ptr"
  required_fields []
  optional_fields ["intrinsic", "implementation", "requires", "note"]

template between_inclusive:
