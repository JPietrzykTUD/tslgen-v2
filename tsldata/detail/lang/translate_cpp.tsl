translation cpp:
  call "::tsl::{name}<Vec>({args})"
  intrinsic_suffix_x86_si8 "epi8"
  intrinsic_suffix_x86_si16 "epi16"
  intrinsic_suffix_x86_si32 "epi32"
  intrinsic_suffix_x86_si64 "epi64"
  intrinsic_suffix_x86_ui8 "epu8"
  intrinsic_suffix_x86_ui16 "epu16"
  intrinsic_suffix_x86_ui32 "epu32"
  intrinsic_suffix_x86_ui64 "epu64"
  intrinsic_suffix_x86_f32 "ps"
  intrinsic_suffix_x86_f64 "pd"
  intrinsic_suffix_arm_si8 "s8"
  intrinsic_suffix_arm_si16 "s16"
  intrinsic_suffix_arm_si32 "s32"
  intrinsic_suffix_arm_si64 "s64"
  intrinsic_suffix_arm_ui8 "u8"
  intrinsic_suffix_arm_ui16 "u16"
  intrinsic_suffix_arm_ui32 "u32"
  intrinsic_suffix_arm_ui64 "u64"
  intrinsic_suffix_arm_f32 "f32"
  intrinsic_suffix_arm_f64 "f64"
  call_primitive "::tsl::detail::{name}{template}::apply({args})"
  type_is_same "std::is_same_v<{lhs}, {rhs}>"
  type_is_signed "std::is_signed_v<{type}>"
  type_is_integral "std::is_integral_v<{type}>"
  type_unsigned_of "std::make_unsigned_t<{type}>"
  type_signed_of "std::make_signed_t<{type}>"
  type_select "std::conditional_t<{cond}, {then}, {else_}>"
  type_alias "using {name} = {type};"
  type_size "std::size_t"
  type_generic_base "typename {type}::base_type"
  type_generic_register "typename {type}::register_type"
  array_type "std::array<{type}, {size}>"
  array_type_aligned "alignas({align}) std::array<{type}, {size}>"
  type_vector_base "typename Vec::base_type"
  type_vector_register "typename Vec::register_type"
  type_vector_mask "typename Vec::mask_type"
  type_vector_mask_underlying "typename Vec::mask_underlying_t"
  type_vector_imask "typename Vec::imask_type"
  type_vector_offset_base "typename Vec::offset_base_type"
  type_vector_transform "typename Vec::template transform_extension<{type}>"
  type_vector_as_extension "::tsl::simd<{base}, {ext}>"
  algo_max_element "(*std::max_element({ptr}, {ptr} + {len}))"
  algo_min_element "(*std::min_element({ptr}, {ptr} + {len}))"
  algo_swap "std::swap({a}, {b})"
  pack_first "std::get<0>(std::make_tuple({args}))"
  seq_type "std::integer_sequence<{type}, {args}>"
  seq_make "std::make_integer_sequence<{type}, {count}>()"
  var_infer "auto {name} = {value};"
  var_const_infer "auto const {name} = {value};"
  var_typed "{type} {name} = {value};"
  var_const_typed "const {type} {name} = {value};"
  var_array_uninit "{type} {name}{};"
  var_uninit "{type} {name};"
  var_init_register "{type} {name}{};"
  flow_if_static "if constexpr ({cond})"
  flow_else_if_static "else if constexpr ({cond})"
  flow_if_runtime "if ({cond})"
  flow_else_if_runtime "else if ({cond})"
  loop_unroll "TSL_UNROLL({count})"
  loop_range "for (std::size_t {var} = {start}; {var} < {end}; {var} += {step})"
  cast_static "static_cast<{type}>({expr})"
  cast_saturating "::tsl::saturating_cast<{type}>({expr})"
  cast_reinterpret "reinterpret_cast<{type}>({expr})"
  cast_bitcast "::tsl::bit_cast<{type}>({expr})"
  cast_const "const_cast<{type}>({expr})"
  cast_dynamic "dynamic_cast<{type}>({expr})"
  mem_copy "std::memcpy({dst}, {src}, {count})"
  mem_set "std::memset({ptr}, {value}, {count})"
  mem_alloc "std::malloc({count})"
  mem_alloc_aligned "std::aligned_alloc({align}, {count})"
  mem_free "std::free({ptr})"
  io_get_flags "{out}.flags()"
  io_set_flags "{out}.flags({flags})"
  io_set_base "{out} << std::setbase({base})"
  io_set_width "{out} << std::setw({width})"
  io_write "{out} << {expr}"
  io_write_base "{out} << std::setbase({base}) << std::setw({width}) << {value}"
  io_write_bin "{out} << std::bitset<{bits}>({value})"
  io_endl "{out} << std::endl"
  emit_return "return {value}"
  value_vector_length "Vec::vector_element_count()"
  value_vector_runtime_length "Vec::vector_element_count_runtime()"
  value_vector_alignment "Vec::vector_alignment()"
  value_vector_size_B "Vec::vector_size_B()"
  value_vector_mask_vector_loadable "Vec::mask_vector_loadable"
  value_size_of "sizeof({type})"
  value_size_of_expr "sizeof({expr})"
  value_pack_size "sizeof...({expr})"
  value_generic_length "{type}::vector_element_count()"
  value_generic_runtime_length "{type}::vector_element_count_runtime()"
  value_cmp_eq_oq "_CMP_EQ_OQ"
  value_cmp_gt_oq "_CMP_GT_OQ"
  value_cmp_ge_oq "_CMP_GE_OQ"
  value_cmp_lt_oq "_CMP_LT_OQ"
  value_cmp_le_oq "_CMP_LE_OQ"
  value_cmp_neq_uq "_CMP_NEQ_UQ"
  value_mm_fround_to_zero "_MM_FROUND_TO_ZERO"
  value_array_uninit "{}"
  value_uninit "{}"
  value_uninit_typed "{}"
