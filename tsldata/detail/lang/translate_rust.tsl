  mask_all_lane_bitmask "if LANES >= 64 { u64::MAX } else { (1u64 << LANES) - 1u64 }"
  mask_set_lane_bitmask "{name} |= 1u64 << {index}"
  mask_clear_lane_bitmask "{name} &= !(1u64 << {index})"
  mask_set_to_lane_bitmask "{name} = ({name} & !(1u64 << {index})) | (((({value}) as u64) & 1u64) << {index})"
  mask_test_lane_bitmask "((({mask} >> {index}) & 1u64) != 0)"
  mask_test_imask "(((({mask}) as u64 >> {index}) & 1u64) != 0)"
