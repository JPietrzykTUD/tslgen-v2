translation c17:
  preamble """#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>

static inline void tsl_io_write_str(FILE *out, const char *v) { fprintf(out, "%s", v); }
static inline void tsl_io_write_u64(FILE *out, unsigned long long v) { fprintf(out, "%llu", v); }
static inline void tsl_io_write_s64(FILE *out, long long v) { fprintf(out, "%lld", v); }
static inline void tsl_io_write_f64(FILE *out, double v) { fprintf(out, "%.6f", v); }

#ifndef TSL_TYPE_SIGNED_OF
#define TSL_TYPE_SIGNED_OF(T) _Generic(((T)0), \
  signed char: signed char, \
  unsigned char: signed char, \
  short: short, \
  unsigned short: short, \
  int: int, \
  unsigned int: int, \
  long: long, \
  unsigned long: long, \
  long long: long long, \
  unsigned long long: long long, \
  float: int32_t, \
  double: int64_t, \
  long double: int64_t, \
  default: int \
)
#endif

#define tsl_io_write(out, value) _Generic((value), \
  const char *: tsl_io_write_str, \
  char *: tsl_io_write_str, \
  unsigned long long: tsl_io_write_u64, \
  long long: tsl_io_write_s64, \
  unsigned long: tsl_io_write_u64, \
  long: tsl_io_write_s64, \
  unsigned int: tsl_io_write_u64, \
  int: tsl_io_write_s64, \
  unsigned short: tsl_io_write_u64, \
  short: tsl_io_write_s64, \
  unsigned char: tsl_io_write_u64, \
  signed char: tsl_io_write_s64, \
  float: tsl_io_write_f64, \
  double: tsl_io_write_f64, \
  long double: tsl_io_write_f64, \
  default: tsl_io_write_u64 \
)((out), (value))

#define TSL_IO_GET_FLAGS(out) (0u)
#define TSL_IO_SET_FLAGS(out, flags) do { (void)(out); (void)(flags); } while (0)
#define TSL_IO_SET_BASE(out, base) do { (void)(out); (void)(base); } while (0)
#define TSL_IO_SET_WIDTH(out, width) do { (void)(out); (void)(width); } while (0)
#define TSL_IO_WRITE(out, expr) do { tsl_io_write((out), (expr)); } while (0)
#define TSL_IO_WRITE_BASE(out, base, width, value) do { \
  unsigned long long _v = (unsigned long long)(value); \
  int _w = (int)(width); \
  if ((base) == 16) { \
    fprintf((out), "%#0*llX", _w, _v); \
  } else if ((base) == 8) { \
    fprintf((out), "%#0*llo", _w, _v); \
  } else { \
    fprintf((out), "%0*llu", _w, _v); \
  } \
} while (0)
#define TSL_IO_WRITE_BIN(out, bits, value) do { \
  unsigned long long _v = (unsigned long long)(value); \
  for (int _i = (int)(bits) - 1; _i >= 0; --_i) { \
    fputc(((_v >> _i) & 1u) ? '1' : '0', (out)); \
  } \
} while (0)
#define TSL_IO_ENDL(out) do { fputc('\n', (out)); } while (0)
#define TSL_PACK_SIZE(expr) (0u)
#define TSL_SEQ_TYPE(type, args) TSL_SEQ_TYPE_##type##_ARGS(args)
#define TSL_SEQ_MAKE(type, count) TSL_SEQ_MAKE_##type##_COUNT(count)
#define TSL_GENERIC_BASE(type) type
#define TSL_GENERIC_REGISTER(type) type
#define TSL_GENERIC_LENGTH(type) (0u)
"""
  call "{name}({args})"
  call_primitive "{name}({args})"
  type_is_same "TSL_TYPE_IS_SAME({lhs}, {rhs})"
  type_is_signed "TSL_TYPE_IS_SIGNED({type})"
  type_is_integral "TSL_TYPE_IS_INTEGRAL({type})"
  type_unsigned_of "TSL_TYPE_UNSIGNED_OF({type})"
  type_signed_of "TSL_TYPE_SIGNED_OF({type})"
  type_select "TSL_TYPE_SELECT({cond}, {then}, {else_})"
  type_alias "typedef {type} {name};"
  type_size "size_t"
  type_generic_base "TSL_GENERIC_BASE({type})"
  type_generic_register "TSL_GENERIC_REGISTER({type})"
  array_type "{type}[{size}]"
  array_type_aligned "_Alignas({align}) {type}[{size}]"
  type_vector_base "TSL_BASE_T"
  type_vector_register "TSL_REGISTER_T"
  type_vector_mask_underlying "TSL_MASK_UNDERLYING_T"
  type_vector_imask "TSL_IMASK_T"
  type_vector_offset_base "TSL_OFFSET_BASE_T"
  type_vector_transform "TSL_VECTOR_TRANSFORM({type})"
  algo_max_element "TSL_MAX_ELEMENT({ptr}, {len})"
  algo_min_element "TSL_MIN_ELEMENT({ptr}, {len})"
  algo_swap "TSL_SWAP({a}, {b})"
  seq_type "TSL_SEQ_TYPE({type}, {args})"
  seq_make "TSL_SEQ_MAKE({type}, {count})"
  var_infer "__auto_type {name} {value};"
  var_const_infer "const __auto_type {name} {value};"
  var_typed "{type} {name} {value};"
  var_const_typed "const {type} {name} {value};"
  var_init_register "{type} {name};"
  var_const_init_register "{type} {name};"
  flow_if_static "if ({cond})"
  flow_else_if_static "else if ({cond})"
  flow_if_runtime "if ({cond})"
  flow_else_if_runtime "else if ({cond})"
  loop_backend_unroll "/* unroll {count} */"
  loop_backend "for (size_t {var} = {start}; {var} < {end}; {var} += {step})"
  cast_static "(({type})({expr}))"
  cast_saturating "(({type})({expr}))"
  cast_reinterpret "(({type})({expr}))"
  cast_bitcast "(({type})({expr}))"
  cast_const "(({type})({expr}))"
  cast_dynamic "(({type})({expr}))"
  mem_copy "memcpy({dst}, {src}, {count})"
  mem_set "memset({ptr}, {value}, {count})"
  mem_alloc "malloc({count})"
  mem_alloc_aligned "aligned_alloc({align}, {count})"
  mem_free "free({ptr})"
  io_get_flags "TSL_IO_GET_FLAGS({out})"
  io_set_flags "TSL_IO_SET_FLAGS({out}, {flags})"
  io_set_base "TSL_IO_SET_BASE({out}, {base})"
  io_set_width "TSL_IO_SET_WIDTH({out}, {width})"
  io_write "TSL_IO_WRITE({out}, {expr})"
  io_write_base "TSL_IO_WRITE_BASE({out}, {base}, {width}, {value})"
  io_write_bin "TSL_IO_WRITE_BIN({out}, {bits}, {value})"
  io_endl "TSL_IO_ENDL({out})"
  complete "return {value}"
  value_vector_length "TSL_VECTOR_LANES"
  value_vector_alignment "TSL_VECTOR_ALIGN"
  value_vector_size_B "TSL_VECTOR_SIZE_B"
  value_vector_mask_vector_loadable "TSL_MASK_VECTOR_LOADABLE"
  value_size_of "sizeof({type})"
  value_size_of_expr "sizeof({expr})"
  value_pack_size "TSL_PACK_SIZE({expr})"
  value_generic_length "TSL_GENERIC_LENGTH({type})"
