{
  "name": "Granforge Demo Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": ["--privileged"],
  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "GitHub.copilot",
        "mohsen1.prettify-json",
        "openai.chatgpt",
        "github.vscode-github-actions",
        "Anthropic.claude-code"
      ]
    }
  }
}