{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development: counters and diagnostics on",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "TSL_PROFILE": "auto"
      }
    },
    {
      "name": "bench",
      "displayName": "Measurement: counters compiled out, no profiling",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "TSL_PROFILE": "auto",
        "TSL_COSORT_NO_INSTRUMENTATION": "ON"
      }
    },
    {
      "name": "bench-dsa",
      "inherits": "bench",
      "displayName": "Measurement on a host with Intel DSA",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-bench-dsa",
      "cacheVariables": { "TSL_COSORT_ENABLE_DSA": "ON" }
    },
    {
      "name": "bench-iaa",
      "inherits": "bench",
      "displayName": "Measurement on a host with Intel IAA",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-bench-iaa",
      "cacheVariables": { "TSL_COSORT_ENABLE_IAA": "ON" }
    },
    {
      "name": "bench-dsa-baselines",
      "inherits": "bench-dsa",
      "displayName": "Measurement with DSA and the Q1 external baselines",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-bench-dsa-baselines",
      "cacheVariables": { "TSL_COSORT_ENABLE_BASELINES": "ON" }
    },
    {
      "name": "phases",
      "inherits": "dev",
      "displayName": "Diagnosis: phase timers on. Never for published numbers.",
      "binaryDir": "${sourceParentDir}/tslctmp/test-sort-phases",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-DTSL_COSORT_PHASES=true" }
    }
  ]
}
